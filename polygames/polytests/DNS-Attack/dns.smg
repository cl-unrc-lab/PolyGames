
smg

const double AF = 15.31;
const int BW = 458;       
const max_succs_attacks = 3;
const attack_latency = 2;    
global sched : [0..2]; // 0 attacker, 1 defender, 2 victim 
global zombies : [0..100];
global strat : [0..5]; // the strategy used 0:NOFIX, 1:FTR,2:RND,3:RDR,4: AGR, 5:AGF
const int maxTime = 15;
global time : [0..15];

player p1 
   Attacker, [ch1],[ch2],[ch3],[ch4],[ch5],[ch6]
endplayer

player p2
   Defender, [nofix],[FTR0],[FTR1],[FTR2],[FTR3],[FTR4],[FTR5],[FTR6],[FTR7],[FTR8],[RND0],[RND1],[RND2],[AGR1],[AGR2],[AGR3],[RDR0],[RDR1],[RDR2],[RDR3],[RDR4],[RDR5],[RDR6],[RDR7],[RDR8],[AGF0],[AGF1],[AGF2],[AGF3],[AGF4],[AGF5],[AGF6],[AGF7],[AGF8],[AGF9],[AGF10],[AGF11],[AGF12],[AGF13],[AGF14],[AGF15],[AGF16],[AGF17],[AGF18],[AGF19],[AGF20],[AGF21],[AGF22],[AGF23],[AGF24],[AGF25],[AGF26]
endplayer

module Attacker 
    succsAttacks : [0..3];
    attackLatency : [0..1];
	[ch1] sched = 0 & time < maxTime & (attackLatency>0 | succsAttacks = 3)  -> (zombies' = 0) & (sched' = 1) & (time' = time+1) & (succsAttacks' = 0) & (attackLatency' = mod(attackLatency+1,2));
	[ch2] sched = 0 & time < maxTime & attackLatency=0 & succsAttacks < 3  -> (zombies' = 20) & (sched' = 1) & (time' = time+1) & (succsAttacks' = succsAttacks+1);
	[ch3] sched = 0 & time < maxTime & attackLatency=0 & succsAttacks < 3-> (zombies' = 40) & (sched' = 1) & (time' = time+1) & (succsAttacks' = succsAttacks+1);
	[ch4] sched = 0 & time < maxTime & attackLatency=0 & succsAttacks < 3-> (zombies' = 60) & (sched' = 1) & (time' = time+1) & (succsAttacks' = succsAttacks+1);
	[ch5] sched = 0 & time < maxTime & attackLatency=0 & succsAttacks < 3-> (zombies' = 80) & (sched' = 1) & (time' = time+1) & (succsAttacks' = succsAttacks+1);
	[ch6] sched = 0 & time < maxTime & attackLatency=0 & succsAttacks < 3-> (zombies' = 100) & (sched' = 1) & (time' = time+1) & (succsAttacks' = succsAttacks+1);
endmodule                 

module Defender
    df :[0..2]; // fraction of attcak traffick detected as bogus
    pfp : [0..2]; // false positives 
    retries : [2..6];
    rdf : [0..2];
	receive_status : [0..3]; //0:p_b_receive,1:p_l_receive, 2:p_b_drop, 3:p_l_drop
	[nofix] sched = 1  & time < maxTime ->  (sched' = 2) & (strat' = 0) & (time' = time+1);
[FTR0] sched = 1  & time < maxTime -> (sched' = 2) & (df'=0) & (pfp' = 0) & (strat' = 1) & (time' = time+1);
[FTR1] sched = 1  & time < maxTime -> (sched' = 2) & (df'=0) & (pfp' = 1) & (strat' = 1) & (time' = time+1);
[FTR2] sched = 1  & time < maxTime -> (sched' = 2) & (df'=0) & (pfp' = 2) & (strat' = 1) & (time' = time+1);
[FTR3] sched = 1  & time < maxTime -> (sched' = 2) & (df'=1) & (pfp' = 0) & (strat' = 1) & (time' = time+1);
[FTR4] sched = 1  & time < maxTime -> (sched' = 2) & (df'=1) & (pfp' = 1) & (strat' = 1) & (time' = time+1);
[FTR5] sched = 1  & time < maxTime -> (sched' = 2) & (df'=1) & (pfp' = 2) & (strat' = 1) & (time' = time+1);
[FTR6] sched = 1  & time < maxTime -> (sched' = 2) & (df'=2) & (pfp' = 0) & (strat' = 1) & (time' = time+1);
[FTR7] sched = 1  & time < maxTime -> (sched' = 2) & (df'=2) & (pfp' = 1) & (strat' = 1) & (time' = time+1);
[FTR8] sched = 1  & time < maxTime -> (sched' = 2) & (df'=2) & (pfp' = 2) & (strat' = 1) & (time' = time+1);
[RND0] sched = 1  & time < maxTime -> (sched' = 2)   & (strat' = 2) & (rdf'=0) & (time' = time+1); // this is a parameter?
[RND1] sched = 1  & time < maxTime -> (sched' = 2)   & (strat' = 2) & (rdf'=1) & (time' = time+1); // this is a parameter?
[RND2] sched = 1  & time < maxTime -> (sched' = 2)   & (strat' = 2) & (rdf'=2) & (time' = time+1); // this is a parameter?
[AGR1] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=2) & (strat' = 3) & (time' = time+1);
 [AGR2] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=4) & (strat' = 3) & (time' = time+1);
 [AGR3] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=6) & (strat' = 3) & (time' = time+1);
 [RDR0] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=2) & (rdf'=0) & (strat' = 4) & (time' = time+1);
 [RDR1] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=2) & (rdf'=1) & (strat' = 4) & (time' = time+1);
 [RDR2] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=2) & (rdf'=2) & (strat' = 4) & (time' = time+1);
 [RDR3] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=4) & (rdf'=0) & (strat' = 4) & (time' = time+1);
 [RDR4] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=4) & (rdf'=1) & (strat' = 4) & (time' = time+1);
 [RDR5] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=4) & (rdf'=2) & (strat' = 4) & (time' = time+1);
 [RDR6] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=6) & (rdf'=0) & (strat' = 4) & (time' = time+1);
 [RDR7] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=6) & (rdf'=1) & (strat' = 4) & (time' = time+1);
 [RDR8] sched = 1  & time < maxTime -> (sched' = 2) & (retries'=6) & (rdf'=2) & (strat' = 4) & (time' = time+1);
 [AGF0] sched = 1  & time < maxTime -> (sched' = 2) & (retries' = 2) & (df'= 0) & (pfp' = 0)  & (strat' = 5) & (time' = time+1);
[AGF1] sched = 1  & time < maxTime -> (sched' = 2) & (retries' = 2) & (df'= 0) & (pfp' = 1)  & (strat' = 5) & (time' = time+1);
