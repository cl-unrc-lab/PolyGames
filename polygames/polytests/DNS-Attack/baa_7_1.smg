// BAA game with scheduler acting as the defender.  The defender nondeterministically
// chooses one of the three countermeasures. 

smg

const double AF = 15.5;
// The high number of packets that an attacker can send to the DFD.
const int attackStrength;

// The attack probability
const double p_attack = (attackStrength) * 1.0 / (attackStrength + 1);



// Probability at which the incoming packets are serviced.  It depends on 
// the AF.  The higher the AF, the more time taken to service the packets,
// thereby reducing the p_service.
const double p_service = 1.0 / AF;

// Keep track of number of packets received by the DFD.
global packetsReceived : [0..bandwidth+1] init 0;

// Kep track of the elapsed time.
global time : [0..maxTime] init 0;

// Number of players excluding DFD, the scheduler.  Besides DFD, We have three 
// players, viz., LC, CM, and Attacker.
const int N = 2;

// Keep track of whether the legitimate client request is successfully sent
//global requestSent : bool init false;

// scheduling variable
global sched : [0..N];

// random drop percentage (rdp)
//const double rdp;

// Defender acts as a scheduler too.
player DFD
	Defender
endplayer

player LC
	LegitClients, [legitClientPacketReceived1], [legitClientPacketReceived2], [legitClientPacketLost]
endplayer

player AS
	Attacker, [attackerPacketReceived1], [attackerPacketReceived2], [attackersPacketLost]
endplayer

// The client server (DFD).  It processes the packets received.  DFD also acts as a 
// scheduler, thus allowing other legitimate clients and attacker to send DNS packets
// to it.
module Defender

// LegitClients, ClientMachine, and Attacker are enabled with probabilities
// that reflect whether they are attackers or legal clients.
[] sched = 0 & time < maxTime -> (1-p_attack)/(N-1) : (sched'=1) & (time'= time + 1) + p_attack : (sched'=2) & (time'= time + 1);

[] sched = 0 & time < maxTime -> 1/N : (sched'=1) & (time'= time + 1) + 1/N : (sched'=2) & (time'= time + 1);

endmodule

// LegitClients (LC) represent the legitimate DNS clients and servers
// that send traffic at the normal rate to the victim DNS server.
module LegitClients

// Legit client's packet is received when bandwidth is empty.
[legitClientPacketReceived1] sched = 1 & bandwidthAvailable & packetsReceived = 0
-> (packetsReceived'=packetsReceived + 1) & (sched'=0);

// Legit client's packet is received when bandwidth is partially full.
[legitClientPacketReceived2] sched = 1 & bandwidthAvailable & packetsReceived > 0
-> p_service : (sched'=0) + 
(1-p_service) : (packetsReceived'=packetsReceived + 1) & (sched'=0);

// Legit client's packet is lost when the bandwidth is full.
[legitClientPacketLost] sched = 1 & !bandwidthAvailable -> 
p_service : (packetsReceived'= packetsReceived - 1) & (sched'=0) +
(1-p_service) : (sched'=0);

endmodule


// The attacker who can send large volumes of packets to the victim DNS server.
module Attacker

// Attacker's packet is received when bandwidth is empty.
[attackerPacketReceived1] sched = 2 & bandwidthAvailable & packetsReceived = 0 -> 
(packetsReceived'=packetsReceived + 1) & (sched'=0);

// Attacker's packet is received when bandwidth is partially full.
[attackerPacketReceived2] sched = 2 & bandwidthAvailable & packetsReceived > 0 -> 
p_service : (sched'=0) + 
(1-p_service) : (packetsReceived'=packetsReceived + 1) & (sched'=0);

// Attacker's packet is lost when the bandwidth is full.
[attackersPacketLost] sched = 2 & !bandwidthAvailable -> 
p_service : (packetsReceived'= packetsReceived - 1) & (sched'=0) +
(1-p_service) : (sched'=0);

endmodule

formula bandwidthAvailable = packetsReceived < bandwidth;

rewards "LegitPacketsProcessed"

endrewards

rewards "LegitPacketsLost"

endrewards

rewards "BogusPacketsProcessed"

endrewards

rewards "BogusPacketsLost"

endrewards
