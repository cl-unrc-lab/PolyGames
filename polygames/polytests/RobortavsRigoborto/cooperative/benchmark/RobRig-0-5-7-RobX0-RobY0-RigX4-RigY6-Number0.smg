//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.42221092576252406
// Q_TERRAIN[0][1] = 0.37897720147015124
// Q_TERRAIN[0][2] = 0.2102857904154225
// Q_TERRAIN[0][3] = 0.12945837514648167
// Q_TERRAIN[0][4] = 0.25563736068430426
// Q_TERRAIN[1][0] = 0.20246706872520714
// Q_TERRAIN[1][1] = 0.3918992945173863
// Q_TERRAIN[1][2] = 0.15165636303946373
// Q_TERRAIN[1][3] = 0.2382984770761779
// Q_TERRAIN[1][4] = 0.2916910197275156
// Q_TERRAIN[2][0] = 0.4540564425976676
// Q_TERRAIN[2][1] = 0.25234342790869513
// Q_TERRAIN[2][2] = 0.14091892219985191
// Q_TERRAIN[2][3] = 0.37790210207861197
// Q_TERRAIN[2][4] = 0.3091844983376658
// Q_TERRAIN[3][0] = 0.12525317068122027
// Q_TERRAIN[3][1] = 0.45487312798412005
// Q_TERRAIN[3][2] = 0.49139273801882655
// Q_TERRAIN[3][3] = 0.4051086179982948
// Q_TERRAIN[3][4] = 0.45108297521979135
// Q_TERRAIN[4][0] = 0.1550737846596663
// Q_TERRAIN[4][1] = 0.3649158741300643
// Q_TERRAIN[4][2] = 0.44941914398399674
// Q_TERRAIN[4][3] = 0.34199196595772063
// Q_TERRAIN[4][4] = 0.23607135772635668
// Q_TERRAIN[5][0] = 0.0503506040341829
// Q_TERRAIN[5][1] = 0.21708591772689184
// Q_TERRAIN[5][2] = 0.3054434867219008
// Q_TERRAIN[5][3] = 0.4565055266189491
// Q_TERRAIN[5][4] = 0.4833031838853794
// Q_TERRAIN[6][0] = 0.23850488827635852
// Q_TERRAIN[6][1] = 0.43265496388582003
// Q_TERRAIN[6][2] = 0.1302461551959797
// Q_TERRAIN[6][3] = 0.40251391350651117
// Q_TERRAIN[6][4] = 0.27434965191779465

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  -0.9719165996719621
// F_SLOPE[0][1] =  0.43940937280790826
// F_SLOPE[0][2] =  -0.2023529155514625
// F_SLOPE[0][3] =  0.649689954296466
// F_SLOPE[0][4] =  0.3363064024637017
// F_SLOPE[1][0] =  -0.9977143613711434
// F_SLOPE[1][1] =  -0.012844267069350712
// F_SLOPE[1][2] =  0.7352055509855617
// F_SLOPE[1][3] =  -0.512178246225736
// F_SLOPE[1][4] =  -0.3495912745052199
// F_SLOPE[2][0] =  0.7409424642173092
// F_SLOPE[2][1] =  -0.6178658169952189
// F_SLOPE[2][2] =  0.13502148124134372
// F_SLOPE[2][3] =  -0.5227681427695596
// F_SLOPE[2][4] =  0.9350805005802867
// F_SLOPE[3][0] =  0.6063589385597401
// F_SLOPE[3][1] =  -0.10406085712885926
// F_SLOPE[3][2] =  -0.8391083628949292
// F_SLOPE[3][3] =  -0.3598907906549085
// F_SLOPE[3][4] =  0.01588128504114783
// F_SLOPE[4][0] =  0.8656676484538135
// F_SLOPE[4][1] =  -0.7818843081377926
// F_SLOPE[4][2] =  0.10253449218110244
// F_SLOPE[4][3] =  0.4131228197337793
// F_SLOPE[4][4] =  0.09488182265684753
// F_SLOPE[5][0] =  0.628933726582672
// F_SLOPE[5][1] =  0.08056721394064792
// F_SLOPE[5][2] =  0.9276770919476018
// F_SLOPE[5][3] =  0.20637125592276595
// F_SLOPE[5][4] =  0.1752341283508727
// F_SLOPE[6][0] =  -0.11002194744896765
// F_SLOPE[6][1] =  0.19257372316621257
// F_SLOPE[6][2] =  -0.2301977080546791
// F_SLOPE[6][3] =  0.15130202832977702
// F_SLOPE[6][4] =  -0.419340995194484

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.6212173428912877
// L_SLOPE[0][1]   =  -0.6265409434888898
// L_SLOPE[0][2]   =  0.22554635973721338
// L_SLOPE[0][3]   =  0.31331877797925767
// L_SLOPE[0][4]   =  -0.04693801598123848
// L_SLOPE[1][0]   =  -0.8203512776088127
// L_SLOPE[1][1]   =  0.5152078439328736
// L_SLOPE[1][2]   =  0.7535407416455495
// L_SLOPE[1][3]   =  0.8467620318925613
// L_SLOPE[1][4]   =  0.6849204462803649
// L_SLOPE[2][0]   =  0.7963462427157579
// L_SLOPE[2][1]   =  0.8461648796403536
// L_SLOPE[2][2]   =  0.08119984989610884
// L_SLOPE[2][3]   =  -0.21740789953075024
// L_SLOPE[2][4]   =  0.4105667997088125
// L_SLOPE[3][0]   =  -0.44873175737574567
// L_SLOPE[3][1]   =  0.623257417015757
// L_SLOPE[3][2]   =  0.6989719303727342
// L_SLOPE[3][3]   =  0.7900779348533504
// L_SLOPE[3][4]   =  0.1796023670623197
// L_SLOPE[4][0]   =  0.8995297464642411
// L_SLOPE[4][1]   =  0.15939002149121184
// L_SLOPE[4][2]   =  -0.09887378673768965
// L_SLOPE[4][3]   =  0.32049075724477794
// L_SLOPE[4][4]   =  0.9925156787071454
// L_SLOPE[5][0]   =  0.8338824358949122
// L_SLOPE[5][1]   =  0.5866501682604484
// L_SLOPE[5][2]   =  -0.8352540236067052
// L_SLOPE[5][3]   =  0.2255662100814244
// L_SLOPE[5][4]   =  -0.027111596061666354
// L_SLOPE[6][0]   =  0.2602946808229456
// L_SLOPE[6][1]   =  0.6901551513430304
// L_SLOPE[6][2]   =  -0.5139287558762875
// L_SLOPE[6][3]   =  0.46297844158169554
// L_SLOPE[6][4]   =  -0.765731413582964
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 7;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..4] init 0;
    robrow : [0..7] init 0;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.08310782673592687,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3787826571087123 * pl + (- 0.5777890742374759 * pr) >= 0,
            1 * pr + (- 0.21885648078805417 * pl) >= 0,
            1 * pf + (- 0.01622628187697745 * pb) >= 0,
            0.02808340032803791 * pb + (- 0.5777890742374759 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.08310782673592687,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3787826571087123 * pl + (- 0.5777890742374759 * pr) >= 0,
            1 * pr + (- 0.21885648078805417 * pl) >= 0,
            1 * pf + (- 0.01622628187697745 * pb) >= 0,
            0.02808340032803791 * pb + (- 1.1393518665979745 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.08310782673592687,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3787826571087123 * pl + (- 0.5777890742374759 * pr) >= 0,
            1 * pr + (-0.21885648078805417 * pl) >= 0,
            1 * pf + (-0.01622628187697745 * pb) >= 0,
            0.02808340032803791 * pb + (-0.5777890742374759 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.08310782673592687,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3787826571087123 * pl + (- 0.5777890742374759 * pr) >= 0,
            1 * pr + (- 0.21885648078805417 * pl) >= 0,
            1 * pf + (- 0.01622628187697745 * pb) >= 0,
            0.02808340032803791 * pb + (- 0.5777890742374759 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22570162188991383,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3734590565111102 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.2319265884108466 * pl) >= 0,
            0.5605906271920917 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.34813956012843594 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22570162188991383,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3734590565111102 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.2319265884108466 * pl) >= 0,
            0.5605906271920917 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.34813956012843594 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22570162188991383,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3734590565111102 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (-0.2319265884108466 * pl) >= 0,
            0.5605906271920917 * pf + (-0.6210227985298488 * pb) >= 0,
            1 * pb + (-0.34813956012843594 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22570162188991383,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3734590565111102 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.2319265884108466 * pl) >= 0,
            0.5605906271920917 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.34813956012843594 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5985845536826616,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6115970443800253 * pr) >= 0,
            0.7744536402627866 * pr + (- 0.7897142095845775 * pl) >= 0,
            1 * pf + (- 0.6299132368227195 * pb) >= 0,
            0.7976470844485375 * pb + (- 0.7897142095845775 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5985845536826616,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6115970443800253 * pr) >= 0,
            0.7744536402627866 * pr + (- 0.7897142095845775 * pl) >= 0,
            1 * pf + (- 0.6299132368227195 * pb) >= 0,
            0.7976470844485375 * pb + (- 0.9495151823464355 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5985845536826616,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6115970443800253 * pr) >= 0,
            0.7744536402627866 * pr + (-0.7897142095845775 * pl) >= 0,
            1 * pf + (-0.6299132368227195 * pb) >= 0,
            0.7976470844485375 * pb + (-0.7897142095845775 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5985845536826616,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6115970443800253 * pr) >= 0,
            0.7744536402627866 * pr + (- 0.7897142095845775 * pl) >= 0,
            1 * pf + (- 0.6299132368227195 * pb) >= 0,
            0.7976470844485375 * pb + (- 0.7897142095845775 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.49081728998844065,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5977845867743365 * pr) >= 0,
            0.6866812220207423 * pr + (- 0.8705416248535183 * pl) >= 0,
            0.35031004570353397 * pf + (- 0.8705416248535183 * pb) >= 0,
            1 * pb + (- 0.3049594763892647 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.49081728998844065,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5977845867743365 * pr) >= 0,
            0.6866812220207423 * pr + (- 0.8705416248535183 * pl) >= 0,
            0.35031004570353397 * pf + (- 0.8705416248535183 * pb) >= 0,
            1 * pb + (- 0.3049594763892647 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.49081728998844065,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5977845867743365 * pr) >= 0,
            0.6866812220207423 * pr + (-0.8705416248535183 * pl) >= 0,
            0.35031004570353397 * pf + (-0.8705416248535183 * pb) >= 0,
            1 * pb + (-0.3049594763892647 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.49081728998844065,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5977845867743365 * pr) >= 0,
            0.6866812220207423 * pr + (- 0.8705416248535183 * pl) >= 0,
            0.35031004570353397 * pf + (- 0.8705416248535183 * pb) >= 0,
            1 * pb + (- 0.3049594763892647 * pf) >= 0
            };
