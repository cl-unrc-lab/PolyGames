                [rigf] (sched = 1) & !Collision  & rigrow = 10 & rigcol = 8 -U->
                pl : (rigcol' = 7) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 8) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 10) & (sched' = 0) +
                pb : (rigrow' = 9) & (sched' = 0) +
                pm : (rigrow' = 10) & (sched' = 0)    // Command successful
                {
                // Success is affected by the quality and inclination of the terrain
	            pm <= 0.44488289942945114,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            1 * pl + (- 0.41672648744118795 * pr) >= 0,
	            0.6008094176987631 * pr + (- 0.6936084474796439 * pl) >= 0,
	            1 * pf + (- 0.5801709406478999 * pb) >= 0,
	            0.8364531065849321 * pb + (- 0.6936084474796439 * pf) >= 0
                };

                [rigb] (sched = 1) &  rigrow = 10 & rigcol = 8 & !Collision  -U->
                pl : (rigcol' = 7) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 8) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 10) & (sched' = 0) +
                pb : (rigrow' = 9) & (sched' = 0) +
                pm : (rigrow' = 9) & (sched' = 0)           // Command successful
                {
	            // Success is affected by the quality and inclination of the terrain
	            pm <= 0.44488289942945114,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            1 * pl + (- 0.41672648744118795 * pr) >= 0,
	            0.6008094176987631 * pr + (- 0.6936084474796439 * pl) >= 0,
	            1 * pf + (- 0.5801709406478999 * pb) >= 0,
	            0.8364531065849321 * pb + (- 0.6936084474796439 * pf) >= 0
                };endmodule
