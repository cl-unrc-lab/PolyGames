// L_SLOPE[6][6]   =  -0.6846268557553783
// L_SLOPE[7][0]   =  0.05514626033522929
// L_SLOPE[7][1]   =  -0.0254687978619359
// L_SLOPE[7][2]   =  0.1228098512288538
// L_SLOPE[7][3]   =  0.510969534517365
// L_SLOPE[7][4]   =  0.7677503084974018
// L_SLOPE[7][5]   =  -0.010834659249426393
