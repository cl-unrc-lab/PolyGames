            pm <= 0.5248812153435458,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5502102827803036 * pr) >= 0,
            0.6320321361691175 * pr + (- 0.8705416248535183 * pl) >= 0,
            0.48839159168555213 * pf + (- 0.8705416248535183 * pb) >= 0,
            1 * pb + (- 0.4251652097907366 * pf) >= 0 
