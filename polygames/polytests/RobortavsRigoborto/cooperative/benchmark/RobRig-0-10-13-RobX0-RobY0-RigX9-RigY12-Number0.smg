                pm : (rigcol' = 9) & (sched' = 0)     // Command successful 
                {
 
                // Success is affected by the quality and inclination of the terrain
	            pm <= 0.5402786839756668,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            1 * pl + (- 0.4527860764664437 * pr) >= 0,
	            0.5060692216997345 * pr + (- 0.8947117450566768 * pl) >= 0,
	            0.5752846949675166 * pf + (- 0.8947117450566768 * pb) >= 0,
	            1 * pb + (- 0.5147139733387848 * pf) >= 0
                };

                [rigf] (sched = 1) & !Collision  & rigrow = 12 & rigcol = 9 -U->
                pl : (rigcol' = 8) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 9) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 12) & (sched' = 0) +
                pb : (rigrow' = 11) & (sched' = 0) +
                pm : (rigrow' = 12) & (sched' = 0)    // Command successful
                {
                // Success is affected by the quality and inclination of the terrain
	            pm <= 0.5402786839756668,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            1 * pl + (- 0.4527860764664437 * pr) >= 0,
	            0.5060692216997345 * pr + (- 0.8947117450566768 * pl) >= 0,
	            0.5752846949675166 * pf + (- 0.8947117450566768 * pb) >= 0,
	            1 * pb + (- 0.5147139733387848 * pf) >= 0
                };

                [rigb] (sched = 1) &  rigrow = 12 & rigcol = 9 & !Collision  -U->
                pl : (rigcol' = 8) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 9) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 12) & (sched' = 0) +
                pb : (rigrow' = 11) & (sched' = 0) +
                pm : (rigrow' = 11) & (sched' = 0)           // Command successful
                {
	            // Success is affected by the quality and inclination of the terrain
	            pm <= 0.5402786839756668,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            1 * pl + (- 0.4527860764664437 * pr) >= 0,
	            0.5060692216997345 * pr + (- 0.8947117450566768 * pl) >= 0,
	            0.5752846949675166 * pf + (- 0.8947117450566768 * pb) >= 0,
	            1 * pb + (- 0.5147139733387848 * pf) >= 0
                };endmodule
