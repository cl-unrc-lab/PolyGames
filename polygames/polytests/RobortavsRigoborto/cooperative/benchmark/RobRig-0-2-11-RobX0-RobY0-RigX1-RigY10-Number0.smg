 // Module for Rigoborto, in case a collision the games finishes
            module rigoborto
            rigcol : [0..1] init 1;
            rigrow : [0..11] init 10;
            
                [rigl] (sched = 1) & (rigrow = 0) & (rigcol = 0) & !Collision  -U->
                pl : (rigcol' = 0) & (sched' = 0) +        // The first four probabilistic options
