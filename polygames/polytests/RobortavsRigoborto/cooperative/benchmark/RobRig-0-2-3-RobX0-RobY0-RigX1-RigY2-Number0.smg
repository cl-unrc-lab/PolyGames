            pm <= 0.5792725069375217,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5010126827248811 * pl + (- 0.8705416248535183 * pr) >= 0,
            1 * pr + (- 0.43615239489153823 * pl) >= 0,
            0.8332359210899376 * pf + (- 0.8705416248535183 * pb) >= 0,
