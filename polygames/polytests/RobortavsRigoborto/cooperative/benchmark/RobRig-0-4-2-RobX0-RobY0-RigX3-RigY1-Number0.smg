            pm <= 0.4191852840812327,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6202951386386653 * pl + (- 0.7443626393156957 * pr) >= 0,
            1 * pr + (- 0.46172452655177226 * pl) >= 0,
            1 * pf + (- 0.41957912343281983 * pb) >= 0,
