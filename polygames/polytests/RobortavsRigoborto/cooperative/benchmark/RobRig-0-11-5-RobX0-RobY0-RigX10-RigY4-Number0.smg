// L_SLOPE[2][3]   =  -0.48016022041433604
// L_SLOPE[2][4]   =  -0.5583414573673653
// L_SLOPE[2][5]   =  0.2938514396706451
// L_SLOPE[2][6]   =  -0.2994120652069354
// L_SLOPE[2][7]   =  -0.6393641969406243
// L_SLOPE[2][8]   =  0.007273010419774462
// L_SLOPE[2][9]   =  -0.9212425858306152
// L_SLOPE[2][10]   =  -0.7981575176220668
