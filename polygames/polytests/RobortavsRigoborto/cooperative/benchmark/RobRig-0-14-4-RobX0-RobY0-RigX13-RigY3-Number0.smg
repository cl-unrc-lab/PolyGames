// L_SLOPE[2][7]   =  0.6766531303868326
// L_SLOPE[2][8]   =  0.8369641239906629
// L_SLOPE[2][9]   =  -0.6611507878050646
// L_SLOPE[2][10]   =  0.34528112714610515
// L_SLOPE[2][11]   =  0.9330978060863664
// L_SLOPE[2][12]   =  -0.8838981123470027
// L_SLOPE[2][13]   =  0.35240356859875654
// L_SLOPE[3][0]   =  0.6908491874032328
// L_SLOPE[3][1]   =  -0.315374917842832
// L_SLOPE[3][2]   =  -0.49862532142977667
// L_SLOPE[3][3]   =  0.19358278693882203
// L_SLOPE[3][4]   =  -0.11537193260184209
// L_SLOPE[3][5]   =  -0.6503610310971177
// L_SLOPE[3][6]   =  -0.05674916980742406
// L_SLOPE[3][7]   =  -0.18018920868489086
// L_SLOPE[3][8]   =  0.13822547904856042
// L_SLOPE[3][9]   =  0.01720026012526632
// L_SLOPE[3][10]   =  -0.3771079979995864
// L_SLOPE[3][11]   =  -0.28569663481947427
// L_SLOPE[3][12]   =  0.675322348737958
// L_SLOPE[3][13]   =  -0.4981346703557259
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 4;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..13] init 0;
    robrow : [0..4] init 0;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.08765533424572602,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.0904681357312247 * pl + (- 0.5777890742374759 * pr) >= 0,
            1 * pr + (- 0.052271500392134636 * pl) >= 0,
            1 * pf + (- 0.12602486367773136 * pb) >= 0,
            0.21811569186220736 * pb + (- 0.5777890742374759 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.08765533424572602,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.0904681357312247 * pl + (- 0.5777890742374759 * pr) >= 0,
            1 * pr + (- 0.052271500392134636 * pl) >= 0,
            1 * pf + (- 0.12602486367773136 * pb) >= 0,
            0.21811569186220736 * pb + (- 1.0295532847972206 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.08765533424572602,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.0904681357312247 * pl + (- 0.5777890742374759 * pr) >= 0,
            1 * pr + (-0.052271500392134636 * pl) >= 0,
            1 * pf + (-0.12602486367773136 * pb) >= 0,
            0.21811569186220736 * pb + (-0.5777890742374759 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.08765533424572602,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.0904681357312247 * pl + (- 0.5777890742374759 * pr) >= 0,
            1 * pr + (- 0.052271500392134636 * pl) >= 0,
            1 * pf + (- 0.12602486367773136 * pb) >= 0,
            0.21811569186220736 * pb + (- 0.5777890742374759 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5034633322217386,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5292778127636143 * pr) >= 0,
            0.8522679264216662 * pr + (- 0.6210227985298488 * pl) >= 0,
            0.8974655078188976 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.5573465412497036 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5034633322217386,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5292778127636143 * pr) >= 0,
            0.8522679264216662 * pr + (- 0.6210227985298488 * pl) >= 0,
            0.8974655078188976 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.5573465412497036 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5034633322217386,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5292778127636143 * pr) >= 0,
            0.8522679264216662 * pr + (-0.6210227985298488 * pl) >= 0,
            0.8974655078188976 * pf + (-0.6210227985298488 * pb) >= 0,
            1 * pb + (-0.5573465412497036 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5034633322217386,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5292778127636143 * pr) >= 0,
            0.8522679264216662 * pr + (- 0.6210227985298488 * pl) >= 0,
            0.8974655078188976 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.5573465412497036 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.34252375714712213,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.1421232636544362 * pr) >= 0,
            0.1799679706019206 * pr + (- 0.7897142095845775 * pl) >= 0,
            0.5868771802662207 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.4634652485371641 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.34252375714712213,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.1421232636544362 * pr) >= 0,
            0.1799679706019206 * pr + (- 0.7897142095845775 * pl) >= 0,
            0.5868771802662207 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.4634652485371641 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.34252375714712213,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.1421232636544362 * pr) >= 0,
            0.1799679706019206 * pr + (-0.7897142095845775 * pl) >= 0,
            0.5868771802662207 * pf + (-0.7897142095845775 * pb) >= 0,
            1 * pb + (-0.4634652485371641 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
