// L_SLOPE[0][9]   =  -0.21758118135434623
// L_SLOPE[0][10]   =  -0.259720119329625
// L_SLOPE[0][11]   =  0.9610333012945373
// L_SLOPE[0][12]   =  -0.9272159247770284
// L_SLOPE[0][13]   =  -0.9567269802899518
// L_SLOPE[1][0]   =  0.9220625604792223
// L_SLOPE[1][1]   =  -0.6300561172051233
// L_SLOPE[1][2]   =  -0.7522096711511366
// L_SLOPE[1][3]   =  -0.5788469802267071
