// F_SLOPE[3][4] =  -0.5139287558762875
// F_SLOPE[3][5] =  0.46297844158169554
// F_SLOPE[3][6] =  -0.765731413582964
// F_SLOPE[3][7] =  -0.559078926264343
// F_SLOPE[3][8] =  0.5891659434211518
// F_SLOPE[3][9] =  -0.3349277015606891
