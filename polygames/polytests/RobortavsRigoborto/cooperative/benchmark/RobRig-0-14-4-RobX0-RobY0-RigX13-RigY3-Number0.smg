// L_SLOPE[1][5]   =  0.8739383172891615
// L_SLOPE[1][6]   =  -0.9544348486626832
// L_SLOPE[1][7]   =  -0.14876233606636569
// L_SLOPE[1][8]   =  -0.7969995612516605
// L_SLOPE[1][9]   =  -0.48016022041433604
// L_SLOPE[1][10]   =  -0.5583414573673653
// L_SLOPE[1][11]   =  0.2938514396706451
// L_SLOPE[1][12]   =  -0.2994120652069354
// L_SLOPE[1][13]   =  -0.6393641969406243
// L_SLOPE[2][0]   =  0.007273010419774462
// L_SLOPE[2][1]   =  -0.9212425858306152
// L_SLOPE[2][2]   =  -0.7981575176220668
// L_SLOPE[2][3]   =  0.9764702974450021
// L_SLOPE[2][4]   =  -0.601288419065874
// L_SLOPE[2][5]   =  -0.2828893973767963
