// F_SLOPE[1][8] =  0.15130202832977702
// F_SLOPE[1][9] =  -0.419340995194484
// F_SLOPE[2][0] =  -0.6212173428912877
// F_SLOPE[2][1] =  -0.6265409434888898
// F_SLOPE[2][2] =  0.22554635973721338
// F_SLOPE[2][3] =  0.31331877797925767
// F_SLOPE[2][4] =  -0.04693801598123848
