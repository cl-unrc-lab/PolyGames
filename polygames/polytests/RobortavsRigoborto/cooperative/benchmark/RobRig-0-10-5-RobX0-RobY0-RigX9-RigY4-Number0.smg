// Q_TERRAIN[4][7] = 0.28375537031033593
// Q_TERRAIN[4][8] = 0.11930796430761009
// Q_TERRAIN[4][9] = 0.48377012514507167

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.6063589385597401
// F_SLOPE[0][1] =  -0.10406085712885926
// F_SLOPE[0][2] =  -0.8391083628949292
// F_SLOPE[0][3] =  -0.3598907906549085
// F_SLOPE[0][4] =  0.01588128504114783
// F_SLOPE[0][5] =  0.8656676484538135
// F_SLOPE[0][6] =  -0.7818843081377926
