// L_SLOPE[3][10]   =  0.1228098512288538
// L_SLOPE[3][11]   =  0.510969534517365
// L_SLOPE[3][12]   =  0.7677503084974018
// L_SLOPE[4][0]   =  -0.010834659249426393
// L_SLOPE[4][1]   =  -0.37588350716625407
