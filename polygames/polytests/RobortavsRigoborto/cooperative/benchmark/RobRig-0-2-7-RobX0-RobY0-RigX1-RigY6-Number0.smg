            0.06678726445848238 * pr + (-0.6210227985298488 * pl) >= 0,
            1 * pf + (-0.3111402983247529 * pb) >= 0,
            0.5010126827248811 * pb + (-0.6210227985298488 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
