// L_SLOPE[5][2]   =  0.7500326629605423
// L_SLOPE[5][3]   =  0.6248298647275181
// L_SLOPE[5][4]   =  -0.623997411898344
// L_SLOPE[5][5]   =  0.9988407189106607
// L_SLOPE[5][6]   =  0.26617751983660076
