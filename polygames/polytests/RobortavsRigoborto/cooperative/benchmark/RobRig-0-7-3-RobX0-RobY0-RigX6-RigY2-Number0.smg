//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.42221092576252406
// Q_TERRAIN[0][1] = 0.37897720147015124
// Q_TERRAIN[0][2] = 0.2102857904154225
// Q_TERRAIN[0][3] = 0.12945837514648167
// Q_TERRAIN[0][4] = 0.25563736068430426
// Q_TERRAIN[0][5] = 0.20246706872520714
// Q_TERRAIN[0][6] = 0.3918992945173863
// Q_TERRAIN[1][0] = 0.15165636303946373
// Q_TERRAIN[1][1] = 0.2382984770761779
// Q_TERRAIN[1][2] = 0.2916910197275156
// Q_TERRAIN[1][3] = 0.4540564425976676
// Q_TERRAIN[1][4] = 0.25234342790869513
// Q_TERRAIN[1][5] = 0.14091892219985191
// Q_TERRAIN[1][6] = 0.37790210207861197
// Q_TERRAIN[2][0] = 0.3091844983376658
// Q_TERRAIN[2][1] = 0.12525317068122027
// Q_TERRAIN[2][2] = 0.45487312798412005
// Q_TERRAIN[2][3] = 0.49139273801882655
// Q_TERRAIN[2][4] = 0.4051086179982948
// Q_TERRAIN[2][5] = 0.45108297521979135
// Q_TERRAIN[2][6] = 0.1550737846596663

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.4596634965202573
// F_SLOPE[0][1] =  0.797676575935987
// F_SLOPE[0][2] =  0.36796786383088254
// F_SLOPE[0][3] =  -0.055714569094573285
// F_SLOPE[0][4] =  -0.7985975838632684
// F_SLOPE[0][5] =  -0.13165632909243263
// F_SLOPE[0][6] =  0.2217739468876032
// F_SLOPE[1][0] =  0.8260221064757964
// F_SLOPE[1][1] =  0.9332127355415176
// F_SLOPE[1][2] =  -0.04598044689456593
// F_SLOPE[1][3] =  0.7306198555432801
// F_SLOPE[1][4] =  -0.47901537921608117
// F_SLOPE[1][5] =  0.6100556540260447
// F_SLOPE[1][6] =  0.09739860767117858
// F_SLOPE[2][0] =  -0.9719165996719621
// F_SLOPE[2][1] =  0.43940937280790826
// F_SLOPE[2][2] =  -0.2023529155514625
// F_SLOPE[2][3] =  0.649689954296466
// F_SLOPE[2][4] =  0.3363064024637017
// F_SLOPE[2][5] =  -0.9977143613711434
// F_SLOPE[2][6] =  -0.012844267069350712

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.7352055509855617
// L_SLOPE[0][1]   =  -0.512178246225736
// L_SLOPE[0][2]   =  -0.3495912745052199
// L_SLOPE[0][3]   =  0.7409424642173092
// L_SLOPE[0][4]   =  -0.6178658169952189
// L_SLOPE[0][5]   =  0.13502148124134372
// L_SLOPE[0][6]   =  -0.5227681427695596
// L_SLOPE[1][0]   =  0.9350805005802867
// L_SLOPE[1][1]   =  0.6063589385597401
// L_SLOPE[1][2]   =  -0.10406085712885926
// L_SLOPE[1][3]   =  -0.8391083628949292
// L_SLOPE[1][4]   =  -0.3598907906549085
// L_SLOPE[1][5]   =  0.01588128504114783
// L_SLOPE[1][6]   =  0.8656676484538135
// L_SLOPE[2][0]   =  -0.7818843081377926
// L_SLOPE[2][1]   =  0.10253449218110244
// L_SLOPE[2][2]   =  0.4131228197337793
// L_SLOPE[2][3]   =  0.09488182265684753
// L_SLOPE[2][4]   =  0.628933726582672
// L_SLOPE[2][5]   =  0.08056721394064792
// L_SLOPE[2][6]   =  0.9276770919476018
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 3;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..6] init 0;
    robrow : [0..3] init 0;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1493281275981293,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.1529953395592748 * pr) >= 0,
            0.26479444901443827 * pr + (- 0.5777890742374759 * pl) >= 0,
            0.5403365034797427 * pf + (- 0.5777890742374759 * pb) >= 0,
            1 * pb + (- 0.3122005281222752 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1493281275981293,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.1529953395592748 * pr) >= 0,
            0.26479444901443827 * pr + (- 0.5777890742374759 * pl) >= 0,
            0.5403365034797427 * pf + (- 0.5777890742374759 * pb) >= 0,
            1 * pb + (- 0.3122005281222752 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1493281275981293,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.1529953395592748 * pr) >= 0,
            0.26479444901443827 * pr + (-0.5777890742374759 * pl) >= 0,
            0.5403365034797427 * pf + (-0.5777890742374759 * pb) >= 0,
            1 * pb + (-0.3122005281222752 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1493281275981293,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.1529953395592748 * pr) >= 0,
            0.26479444901443827 * pr + (- 0.5777890742374759 * pl) >= 0,
            0.5403365034797427 * pf + (- 0.5777890742374759 * pb) >= 0,
            1 * pb + (- 0.3122005281222752 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.17037168230810917,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.48782175377426396 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.3029484307126322 * pl) >= 0,
            0.20232342406401305 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.12564745902037472 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.17037168230810917,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.48782175377426396 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.3029484307126322 * pl) >= 0,
            0.20232342406401305 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.12564745902037472 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.17037168230810917,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.48782175377426396 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (-0.3029484307126322 * pl) >= 0,
            0.20232342406401305 * pf + (-0.6210227985298488 * pb) >= 0,
            1 * pb + (-0.12564745902037472 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.17037168230810917,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.48782175377426396 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.3029484307126322 * pl) >= 0,
            0.20232342406401305 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.12564745902037472 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.495253817663327,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6504087254947801 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (- 0.5136370125610227 * pl) >= 0,
            0.6320321361691175 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.49912475884684665 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.495253817663327,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6504087254947801 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (- 0.5136370125610227 * pl) >= 0,
            0.6320321361691175 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.49912475884684665 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.495253817663327,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6504087254947801 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (-0.5136370125610227 * pl) >= 0,
            0.6320321361691175 * pf + (-0.7897142095845775 * pb) >= 0,
            1 * pb + (-0.49912475884684665 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.495253817663327,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6504087254947801 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (- 0.5136370125610227 * pl) >= 0,
            0.6320321361691175 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.49912475884684665 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4928537532564463,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.22552036813081205 * pr) >= 0,
            0.25905753578269075 * pr + (- 0.8705416248535183 * pl) >= 0,
            1 * pf + (- 0.8220397733459148 * pb) >= 0,
            0.9442854309054267 * pb + (- 0.8705416248535183 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4928537532564463,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.22552036813081205 * pr) >= 0,
            0.25905753578269075 * pr + (- 0.8705416248535183 * pl) >= 0,
            1 * pf + (- 0.8220397733459148 * pb) >= 0,
            0.9442854309054267 * pb + (- 0.9190434763611217 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4928537532564463,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.22552036813081205 * pr) >= 0,
            0.25905753578269075 * pr + (-0.8705416248535183 * pl) >= 0,
            1 * pf + (-0.8220397733459148 * pb) >= 0,
            0.9442854309054267 * pb + (-0.8705416248535183 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4928537532564463,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.22552036813081205 * pr) >= 0,
            0.25905753578269075 * pr + (- 0.8705416248535183 * pl) >= 0,
            1 * pf + (- 0.8220397733459148 * pb) >= 0,
            0.9442854309054267 * pb + (- 0.8705416248535183 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 4) & !Collision  -U->
            pl : (robcol' = 3) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 5) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28284401318849517,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3821341830047811 * pl + (- 0.7443626393156957 * pr) >= 0,
            1 * pr + (- 0.2844464090341859 * pl) >= 0,
            1 * pf + (- 0.14991643404009558 * pb) >= 0,
            0.2014024161367316 * pb + (- 0.7443626393156957 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 4 & !Collision  -U->
            pl : (robcol' = 3) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 5) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 5) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28284401318849517,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3821341830047811 * pl + (- 0.7443626393156957 * pr) >= 0,
            1 * pr + (- 0.2844464090341859 * pl) >= 0,
            1 * pf + (- 0.14991643404009558 * pb) >= 0,
            0.2014024161367316 * pb + (- 1.3388088445912958 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 4)  & !Collision  -U->
            pl : (robcol' = 3) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28284401318849517,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3821341830047811 * pl + (- 0.7443626393156957 * pr) >= 0,
            1 * pr + (-0.2844464090341859 * pl) >= 0,
            1 * pf + (-0.14991643404009558 * pb) >= 0,
            0.2014024161367316 * pb + (-0.7443626393156957 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 4)  & !Collision  -U->
            pl : (robcol' = 3) & (sched' = 1) +         // The first four probabilistic options
