	            0.0779374395207777 * pf + (- 0.5777890742374759 * pb) >= 0,
	            1 * pb + (- 0.04503140102914942 * pf) >= 0
                };

                [rigb] (sched = 1) &  rigrow = 0 & rigcol = 0 & !Collision  -U->
