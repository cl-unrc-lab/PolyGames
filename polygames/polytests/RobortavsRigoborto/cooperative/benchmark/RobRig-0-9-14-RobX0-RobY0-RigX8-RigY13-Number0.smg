	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            1 * pl + (- 0.061820479400375106 * pr) >= 0,
	            0.10699489166000808 * pr + (- 0.5777890742374759 * pl) >= 0,
	            0.0779374395207777 * pf + (- 0.5777890742374759 * pb) >= 0,
	            1 * pb + (- 0.04503140102914942 * pf) >= 0
                };

                [rigf] (sched = 1) & !Collision  & rigrow = 0 & rigcol = 0 -U->
