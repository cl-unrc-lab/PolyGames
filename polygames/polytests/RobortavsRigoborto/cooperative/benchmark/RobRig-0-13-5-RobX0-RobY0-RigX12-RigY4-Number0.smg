                pb : (rigrow' = 3) & (sched' = 0) +
                pm : (rigrow' = 4) & (sched' = 0)    // Command successful
                {
                // Success is affected by the quality and inclination of the terrain
	            pm <= 0.3807199732889677,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            0.8288127933672886 * pl + (- 0.7061914679122818 * pr) >= 0,
	            1 * pr + (- 0.5853005231725242 * pl) >= 0,
	            1 * pf + (- 0.29741466924939197 * pb) >= 0,
	            0.4211530197732929 * pb + (- 0.7061914679122818 * pf) >= 0
                };

                [rigb] (sched = 1) &  rigrow = 4 & rigcol = 12 & !Collision  -U->
                pl : (rigcol' = 11) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 12) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 4) & (sched' = 0) +
                pb : (rigrow' = 3) & (sched' = 0) +
                pm : (rigrow' = 3) & (sched' = 0)           // Command successful
                {
	            // Success is affected by the quality and inclination of the terrain
	            pm <= 0.3807199732889677,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            0.8288127933672886 * pl + (- 0.7061914679122818 * pr) >= 0,
	            1 * pr + (- 0.5853005231725242 * pl) >= 0,
	            1 * pf + (- 0.29741466924939197 * pb) >= 0,
	            0.4211530197732929 * pb + (- 0.7061914679122818 * pf) >= 0
                };endmodule
