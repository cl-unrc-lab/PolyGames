                // Success is affected by the quality and inclination of the terrain
	            pm <= 0.29031685684334596,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            0.6570414200309738 * pl + (- 0.541529391026272 * pr) >= 0,
	            1 * pr + (- 0.3558072400684102 * pl) >= 0,
	            1 * pf + (- 0.4100981178706767 * pb) >= 0,
	            0.7572961406461889 * pb + (- 0.541529391026272 * pf) >= 0
                };

                [rigf] (sched = 1) & !Collision  & rigrow = 7 & rigcol = 11 -U->
                pl : (rigcol' = 10) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 11) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 7) & (sched' = 0) +
                pb : (rigrow' = 6) & (sched' = 0) +
                pm : (rigrow' = 7) & (sched' = 0)    // Command successful
                {
                // Success is affected by the quality and inclination of the terrain
	            pm <= 0.29031685684334596,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            0.6570414200309738 * pl + (- 0.541529391026272 * pr) >= 0,
	            1 * pr + (- 0.3558072400684102 * pl) >= 0,
	            1 * pf + (- 0.4100981178706767 * pb) >= 0,
	            0.7572961406461889 * pb + (- 0.541529391026272 * pf) >= 0
                };

                [rigb] (sched = 1) &  rigrow = 7 & rigcol = 11 & !Collision  -U->
                pl : (rigcol' = 10) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 11) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 7) & (sched' = 0) +
                pb : (rigrow' = 6) & (sched' = 0) +
                pm : (rigrow' = 6) & (sched' = 0)           // Command successful
                {
	            // Success is affected by the quality and inclination of the terrain
	            pm <= 0.29031685684334596,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            0.6570414200309738 * pl + (- 0.541529391026272 * pr) >= 0,
	            1 * pr + (- 0.3558072400684102 * pl) >= 0,
	            1 * pf + (- 0.4100981178706767 * pb) >= 0,
	            0.7572961406461889 * pb + (- 0.541529391026272 * pf) >= 0
                };endmodule
