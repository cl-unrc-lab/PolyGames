// Q_TERRAIN[6][0] = 0.35985234320197707
// Q_TERRAIN[6][1] = 0.19941177111213437
// Q_TERRAIN[6][2] = 0.4124224885741165
// Q_TERRAIN[6][3] = 0.3340766006159254
// Q_TERRAIN[6][4] = 0.0005714096572141392
// Q_TERRAIN[6][5] = 0.24678893323266232
// Q_TERRAIN[7][0] = 0.43380138774639043
// Q_TERRAIN[7][1] = 0.12195543844356599
// Q_TERRAIN[7][2] = 0.16260218137369503
// Q_TERRAIN[7][3] = 0.4352356160543273
// Q_TERRAIN[7][4] = 0.09553354575119527
// Q_TERRAIN[7][5] = 0.28375537031033593

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  -0.5227681427695596
// F_SLOPE[0][1] =  0.9350805005802867
// F_SLOPE[0][2] =  0.6063589385597401
// F_SLOPE[0][3] =  -0.10406085712885926
// F_SLOPE[0][4] =  -0.8391083628949292
// F_SLOPE[0][5] =  -0.3598907906549085
// F_SLOPE[1][0] =  0.01588128504114783
// F_SLOPE[1][1] =  0.8656676484538135
// F_SLOPE[1][2] =  -0.7818843081377926
// F_SLOPE[1][3] =  0.10253449218110244
// F_SLOPE[1][4] =  0.4131228197337793
// F_SLOPE[1][5] =  0.09488182265684753
// F_SLOPE[2][0] =  0.628933726582672
