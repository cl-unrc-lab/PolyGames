// F_SLOPE[3][0] =  0.19257372316621257
// F_SLOPE[3][1] =  -0.2301977080546791
// F_SLOPE[3][2] =  0.15130202832977702
// F_SLOPE[3][3] =  -0.419340995194484
// F_SLOPE[3][4] =  -0.6212173428912877
// F_SLOPE[3][5] =  -0.6265409434888898
// F_SLOPE[4][0] =  0.22554635973721338
// F_SLOPE[4][1] =  0.31331877797925767
// F_SLOPE[4][2] =  -0.04693801598123848
// F_SLOPE[4][3] =  -0.8203512776088127
// F_SLOPE[4][4] =  0.5152078439328736
// F_SLOPE[4][5] =  0.7535407416455495
// F_SLOPE[5][0] =  0.8467620318925613
// F_SLOPE[5][1] =  0.6849204462803649
// F_SLOPE[5][2] =  0.7963462427157579
// F_SLOPE[5][3] =  0.8461648796403536
// F_SLOPE[5][4] =  0.08119984989610884
// F_SLOPE[5][5] =  -0.21740789953075024
// F_SLOPE[6][0] =  0.4105667997088125
// F_SLOPE[6][1] =  -0.44873175737574567
// F_SLOPE[6][2] =  0.623257417015757
// F_SLOPE[6][3] =  0.6989719303727342
// F_SLOPE[6][4] =  0.7900779348533504
// F_SLOPE[6][5] =  0.1796023670623197
// F_SLOPE[7][0] =  0.8995297464642411
// F_SLOPE[7][1] =  0.15939002149121184
// F_SLOPE[7][2] =  -0.09887378673768965
// F_SLOPE[7][3] =  0.32049075724477794
// F_SLOPE[7][4] =  0.9925156787071454
// F_SLOPE[7][5] =  0.8338824358949122

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.5866501682604484
// L_SLOPE[0][1]   =  -0.8352540236067052
// L_SLOPE[0][2]   =  0.2255662100814244
// L_SLOPE[0][3]   =  -0.027111596061666354
// L_SLOPE[0][4]   =  0.2602946808229456
// L_SLOPE[0][5]   =  0.6901551513430304
// L_SLOPE[1][0]   =  -0.5139287558762875
// L_SLOPE[1][1]   =  0.46297844158169554
// L_SLOPE[1][2]   =  -0.765731413582964
// L_SLOPE[1][3]   =  -0.559078926264343
// L_SLOPE[1][4]   =  0.5891659434211518
// L_SLOPE[1][5]   =  -0.3349277015606891
// L_SLOPE[2][0]   =  0.631826193067319
// L_SLOPE[2][1]   =  -0.7987849595678076
// L_SLOPE[2][2]   =  -0.7072830221753923
// L_SLOPE[2][3]   =  0.3953412803824776
// L_SLOPE[2][4]   =  -0.9095318642687753
// L_SLOPE[2][5]   =  0.14773207357833384
// L_SLOPE[3][0]   =  0.8200320293980794
// L_SLOPE[3][1]   =  0.06839593652144793
// L_SLOPE[3][2]   =  0.361178265124513
// L_SLOPE[3][3]   =  -0.9466064106755896
// L_SLOPE[3][4]   =  0.26999981982291654
// L_SLOPE[3][5]   =  0.21267683550843786
// L_SLOPE[4][0]   =  0.15190589606308147
// L_SLOPE[4][1]   =  -0.21758118135434623
// L_SLOPE[4][2]   =  -0.259720119329625
// L_SLOPE[4][3]   =  0.9610333012945373
// L_SLOPE[4][4]   =  -0.9272159247770284
// L_SLOPE[4][5]   =  -0.9567269802899518
// L_SLOPE[5][0]   =  0.9220625604792223
// L_SLOPE[5][1]   =  -0.6300561172051233
// L_SLOPE[5][2]   =  -0.7522096711511366
// L_SLOPE[5][3]   =  -0.5788469802267071
// L_SLOPE[5][4]   =  0.6014931807083619
// L_SLOPE[5][5]   =  0.8739383172891615
// L_SLOPE[6][0]   =  -0.9544348486626832
// L_SLOPE[6][1]   =  -0.14876233606636569
// L_SLOPE[6][2]   =  -0.7969995612516605
// L_SLOPE[6][3]   =  -0.48016022041433604
// L_SLOPE[6][4]   =  -0.5583414573673653
// L_SLOPE[6][5]   =  0.2938514396706451
// L_SLOPE[7][0]   =  -0.2994120652069354
// L_SLOPE[7][1]   =  -0.6393641969406243
// L_SLOPE[7][2]   =  0.007273010419774462
// L_SLOPE[7][3]   =  -0.9212425858306152
// L_SLOPE[7][4]   =  -0.7981575176220668
// L_SLOPE[7][5]   =  0.9764702974450021
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 8;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 0;
    robrow : [0..8] init 0;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.17642092818095412,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.238829016617012 * pr) >= 0,
            0.41334983173955164 * pr + (- 0.5777890742374759 * pl) >= 0,
            1 * pf + (- 0.27573935298580743 * pb) >= 0,
            0.47723185723044037 * pb + (- 0.5777890742374759 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.17642092818095412,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.238829016617012 * pr) >= 0,
            0.41334983173955164 * pr + (- 0.5777890742374759 * pl) >= 0,
            1 * pf + (- 0.27573935298580743 * pb) >= 0,
            0.47723185723044037 * pb + (- 0.8798387954891445 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.17642092818095412,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.238829016617012 * pr) >= 0,
            0.41334983173955164 * pr + (-0.5777890742374759 * pl) >= 0,
            1 * pf + (-0.27573935298580743 * pb) >= 0,
            0.47723185723044037 * pb + (-0.5777890742374759 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.17642092818095412,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.238829016617012 * pr) >= 0,
            0.41334983173955164 * pr + (- 0.5777890742374759 * pl) >= 0,
            1 * pf + (- 0.27573935298580743 * pb) >= 0,
            0.47723185723044037 * pb + (- 0.5777890742374759 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1263704116892811,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.1647459763932948 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.10231100730629634 * pl) >= 0,
            0.06491949941971331 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.040316489208787255 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1263704116892811,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.1647459763932948 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.10231100730629634 * pl) >= 0,
            0.06491949941971331 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.040316489208787255 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1263704116892811,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.1647459763932948 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (-0.10231100730629634 * pl) >= 0,
            0.06491949941971331 * pf + (-0.6210227985298488 * pb) >= 0,
            1 * pb + (-0.040316489208787255 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1263704116892811,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.1647459763932948 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.10231100730629634 * pl) >= 0,
            0.06491949941971331 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.040316489208787255 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4421386791239532,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6115813682811366 * pr) >= 0,
            0.7744337899185756 * pr + (- 0.7897142095845775 * pl) >= 0,
            0.3936410614402599 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.31086393969532894 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4421386791239532,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6115813682811366 * pr) >= 0,
            0.7744337899185756 * pr + (- 0.7897142095845775 * pl) >= 0,
            0.3936410614402599 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.31086393969532894 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4421386791239532,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6115813682811366 * pr) >= 0,
            0.7744337899185756 * pr + (-0.7897142095845775 * pl) >= 0,
            0.3936410614402599 * pf + (-0.7897142095845775 * pb) >= 0,
            1 * pb + (-0.31086393969532894 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4421386791239532,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6115813682811366 * pr) >= 0,
            0.7744337899185756 * pr + (- 0.7897142095845775 * pl) >= 0,
            0.3936410614402599 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.31086393969532894 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.8063660262204098,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.9728884039383336 * pl + (- 0.8705416248535183 * pr) >= 0,
            1 * pr + (- 0.846939851965623 * pl) >= 0,
            1 * pf + (- 0.7799523172049113 * pb) >= 0,
            0.8959391428711407 * pb + (- 0.8705416248535183 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
