// Q_TERRAIN[3][3] = 0.3649158741300643
// Q_TERRAIN[3][4] = 0.44941914398399674
// Q_TERRAIN[3][5] = 0.34199196595772063
// Q_TERRAIN[4][0] = 0.23607135772635668
// Q_TERRAIN[4][1] = 0.0503506040341829
// Q_TERRAIN[4][2] = 0.21708591772689184
// Q_TERRAIN[4][3] = 0.3054434867219008
// Q_TERRAIN[4][4] = 0.4565055266189491
// Q_TERRAIN[4][5] = 0.4833031838853794
// Q_TERRAIN[5][0] = 0.23850488827635852
// Q_TERRAIN[5][1] = 0.43265496388582003
