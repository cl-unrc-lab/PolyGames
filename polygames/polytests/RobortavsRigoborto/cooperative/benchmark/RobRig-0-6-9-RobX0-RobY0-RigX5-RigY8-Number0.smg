// F_SLOPE[8][4] =  0.5891659434211518
// F_SLOPE[8][5] =  -0.3349277015606891

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.631826193067319
// L_SLOPE[0][1]   =  -0.7987849595678076
// L_SLOPE[0][2]   =  -0.7072830221753923
// L_SLOPE[0][3]   =  0.3953412803824776
// L_SLOPE[0][4]   =  -0.9095318642687753
// L_SLOPE[0][5]   =  0.14773207357833384
// L_SLOPE[1][0]   =  0.8200320293980794
// L_SLOPE[1][1]   =  0.06839593652144793
// L_SLOPE[1][2]   =  0.361178265124513
// L_SLOPE[1][3]   =  -0.9466064106755896
// L_SLOPE[1][4]   =  0.26999981982291654
// L_SLOPE[1][5]   =  0.21267683550843786
