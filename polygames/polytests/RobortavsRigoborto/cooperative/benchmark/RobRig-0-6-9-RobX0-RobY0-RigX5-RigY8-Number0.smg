// L_SLOPE[2][1]   =  -0.21758118135434623
// L_SLOPE[2][2]   =  -0.259720119329625
// L_SLOPE[2][3]   =  0.9610333012945373
// L_SLOPE[2][4]   =  -0.9272159247770284
// L_SLOPE[2][5]   =  -0.9567269802899518
// L_SLOPE[3][0]   =  0.9220625604792223
// L_SLOPE[3][1]   =  -0.6300561172051233
// L_SLOPE[3][2]   =  -0.7522096711511366
// L_SLOPE[3][3]   =  -0.5788469802267071
// L_SLOPE[3][4]   =  0.6014931807083619
// L_SLOPE[3][5]   =  0.8739383172891615
// L_SLOPE[4][0]   =  -0.9544348486626832
// L_SLOPE[4][1]   =  -0.14876233606636569
// L_SLOPE[4][2]   =  -0.7969995612516605
// L_SLOPE[4][3]   =  -0.48016022041433604
// L_SLOPE[4][4]   =  -0.5583414573673653
// L_SLOPE[4][5]   =  0.2938514396706451
// L_SLOPE[5][0]   =  -0.2994120652069354
// L_SLOPE[5][1]   =  -0.6393641969406243
// L_SLOPE[5][2]   =  0.007273010419774462
// L_SLOPE[5][3]   =  -0.9212425858306152
// L_SLOPE[5][4]   =  -0.7981575176220668
// L_SLOPE[5][5]   =  0.9764702974450021
// L_SLOPE[6][0]   =  -0.601288419065874
// L_SLOPE[6][1]   =  -0.2828893973767963
// L_SLOPE[6][2]   =  0.4631966124507212
// L_SLOPE[6][3]   =  0.6766531303868326
// L_SLOPE[6][4]   =  0.8369641239906629
// L_SLOPE[6][5]   =  -0.6611507878050646
// L_SLOPE[7][0]   =  0.34528112714610515
// L_SLOPE[7][1]   =  0.9330978060863664
// L_SLOPE[7][2]   =  -0.8838981123470027
// L_SLOPE[7][3]   =  0.35240356859875654
// L_SLOPE[7][4]   =  0.6908491874032328
// L_SLOPE[7][5]   =  -0.315374917842832
// L_SLOPE[8][0]   =  -0.49862532142977667
// L_SLOPE[8][1]   =  0.19358278693882203
// L_SLOPE[8][2]   =  -0.11537193260184209
// L_SLOPE[8][3]   =  -0.6503610310971177
// L_SLOPE[8][4]   =  -0.05674916980742406
// L_SLOPE[8][5]   =  -0.18018920868489086
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 9;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 0;
    robrow : [0..9] init 0;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.25895244111752524,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.21272680306612093 * pr) >= 0,
            0.368173806932681 * pr + (- 0.5777890742374759 * pl) >= 0,
            0.9841187149588522 * pf + (- 0.5777890742374759 * pb) >= 0,
            1 * pb + (- 0.5686130412558497 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.25895244111752524,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.21272680306612093 * pr) >= 0,
            0.368173806932681 * pr + (- 0.5777890742374759 * pl) >= 0,
            0.9841187149588522 * pf + (- 0.5777890742374759 * pb) >= 0,
            1 * pb + (- 0.5686130412558497 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.25895244111752524,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.21272680306612093 * pr) >= 0,
            0.368173806932681 * pr + (-0.5777890742374759 * pl) >= 0,
            0.9841187149588522 * pf + (-0.5777890742374759 * pb) >= 0,
            1 * pb + (-0.5686130412558497 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.25895244111752524,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.21272680306612093 * pr) >= 0,
            0.368173806932681 * pr + (- 0.5777890742374759 * pl) >= 0,
            0.9841187149588522 * pf + (- 0.5777890742374759 * pb) >= 0,
            1 * pb + (- 0.5686130412558497 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.13453764330370754,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2012150404321924 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.1249591275154968 * pl) >= 0,
            0.1343323515461865 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.0834234528903082 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.13453764330370754,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2012150404321924 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.1249591275154968 * pl) >= 0,
            0.1343323515461865 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.0834234528903082 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.13453764330370754,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2012150404321924 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (-0.1249591275154968 * pl) >= 0,
            0.1343323515461865 * pf + (-0.6210227985298488 * pb) >= 0,
            1 * pb + (-0.0834234528903082 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.13453764330370754,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2012150404321924 * pl + (- 0.6210227985298488 * pr) >= 0,
            1 * pr + (- 0.1249591275154968 * pl) >= 0,
            0.1343323515461865 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.0834234528903082 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.32163729265359187,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2927169778246077 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (- 0.23116275677474638 * pl) >= 0,
            1 * pf + (- 0.17224906119695635 * pb) >= 0,
            0.21811569186220736 * pb + (- 0.7897142095845775 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.32163729265359187,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2927169778246077 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (- 0.23116275677474638 * pl) >= 0,
            1 * pf + (- 0.17224906119695635 * pb) >= 0,
            0.21811569186220736 * pb + (- 1.4071793579721987 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.32163729265359187,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2927169778246077 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (-0.23116275677474638 * pl) >= 0,
            1 * pf + (-0.17224906119695635 * pb) >= 0,
            0.21811569186220736 * pb + (-0.7897142095845775 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.32163729265359187,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2927169778246077 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (- 0.23116275677474638 * pl) >= 0,
            1 * pf + (- 0.17224906119695635 * pb) >= 0,
