//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.42221092576252406
// Q_TERRAIN[0][1] = 0.37897720147015124
// Q_TERRAIN[0][2] = 0.2102857904154225
// Q_TERRAIN[1][0] = 0.12945837514648167
// Q_TERRAIN[1][1] = 0.25563736068430426
// Q_TERRAIN[1][2] = 0.20246706872520714
// Q_TERRAIN[2][0] = 0.3918992945173863
// Q_TERRAIN[2][1] = 0.15165636303946373
// Q_TERRAIN[2][2] = 0.2382984770761779
// Q_TERRAIN[3][0] = 0.2916910197275156
// Q_TERRAIN[3][1] = 0.4540564425976676
// Q_TERRAIN[3][2] = 0.25234342790869513
// Q_TERRAIN[4][0] = 0.14091892219985191
// Q_TERRAIN[4][1] = 0.37790210207861197
// Q_TERRAIN[4][2] = 0.3091844983376658
// Q_TERRAIN[5][0] = 0.12525317068122027
// Q_TERRAIN[5][1] = 0.45487312798412005
// Q_TERRAIN[5][2] = 0.49139273801882655
// Q_TERRAIN[6][0] = 0.4051086179982948
// Q_TERRAIN[6][1] = 0.45108297521979135
// Q_TERRAIN[6][2] = 0.1550737846596663
// Q_TERRAIN[7][0] = 0.3649158741300643
// Q_TERRAIN[7][1] = 0.44941914398399674
// Q_TERRAIN[7][2] = 0.34199196595772063
// Q_TERRAIN[8][0] = 0.23607135772635668
// Q_TERRAIN[8][1] = 0.0503506040341829
// Q_TERRAIN[8][2] = 0.21708591772689184

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.2217739468876032
// F_SLOPE[0][1] =  0.8260221064757964
// F_SLOPE[0][2] =  0.9332127355415176
// F_SLOPE[1][0] =  -0.04598044689456593
// F_SLOPE[1][1] =  0.7306198555432801
// F_SLOPE[1][2] =  -0.47901537921608117
// F_SLOPE[2][0] =  0.6100556540260447
// F_SLOPE[2][1] =  0.09739860767117858
// F_SLOPE[2][2] =  -0.9719165996719621
// F_SLOPE[3][0] =  0.43940937280790826
// F_SLOPE[3][1] =  -0.2023529155514625
// F_SLOPE[3][2] =  0.649689954296466
// F_SLOPE[4][0] =  0.3363064024637017
// F_SLOPE[4][1] =  -0.9977143613711434
// F_SLOPE[4][2] =  -0.012844267069350712
// F_SLOPE[5][0] =  0.7352055509855617
// F_SLOPE[5][1] =  -0.512178246225736
// F_SLOPE[5][2] =  -0.3495912745052199
// F_SLOPE[6][0] =  0.7409424642173092
// F_SLOPE[6][1] =  -0.6178658169952189
// F_SLOPE[6][2] =  0.13502148124134372
// F_SLOPE[7][0] =  -0.5227681427695596
// F_SLOPE[7][1] =  0.9350805005802867
// F_SLOPE[7][2] =  0.6063589385597401
// F_SLOPE[8][0] =  -0.10406085712885926
// F_SLOPE[8][1] =  -0.8391083628949292
// F_SLOPE[8][2] =  -0.3598907906549085

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.01588128504114783
// L_SLOPE[0][1]   =  0.8656676484538135
// L_SLOPE[0][2]   =  -0.7818843081377926
// L_SLOPE[1][0]   =  0.10253449218110244
// L_SLOPE[1][1]   =  0.4131228197337793
// L_SLOPE[1][2]   =  0.09488182265684753
// L_SLOPE[2][0]   =  0.628933726582672
// L_SLOPE[2][1]   =  0.08056721394064792
// L_SLOPE[2][2]   =  0.9276770919476018
// L_SLOPE[3][0]   =  0.20637125592276595
// L_SLOPE[3][1]   =  0.1752341283508727
// L_SLOPE[3][2]   =  -0.11002194744896765
// L_SLOPE[4][0]   =  0.19257372316621257
// L_SLOPE[4][1]   =  -0.2301977080546791
// L_SLOPE[4][2]   =  0.15130202832977702
// L_SLOPE[5][0]   =  -0.419340995194484
// L_SLOPE[5][1]   =  -0.6212173428912877
// L_SLOPE[5][2]   =  -0.6265409434888898
// L_SLOPE[6][0]   =  0.22554635973721338
// L_SLOPE[6][1]   =  0.31331877797925767
// L_SLOPE[6][2]   =  -0.04693801598123848
// L_SLOPE[7][0]   =  -0.8203512776088127
// L_SLOPE[7][1]   =  0.5152078439328736
// L_SLOPE[7][2]   =  0.7535407416455495
// L_SLOPE[8][0]   =  0.8467620318925613
// L_SLOPE[8][1]   =  0.6849204462803649
// L_SLOPE[8][2]   =  0.7963462427157579
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 9;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..2] init 0;
    robrow : [0..9] init 0;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.46072248590571163,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5686130412558497 * pr) >= 0,
            0.9841187149588522 * pr + (- 0.5777890742374759 * pl) >= 0,
            0.7782260531123968 * pf + (- 0.5777890742374759 * pb) >= 0,
            1 * pb + (- 0.4496505107752965 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.46072248590571163,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5686130412558497 * pr) >= 0,
            0.9841187149588522 * pr + (- 0.5777890742374759 * pl) >= 0,
            0.7782260531123968 * pf + (- 0.5777890742374759 * pb) >= 0,
            1 * pb + (- 0.4496505107752965 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.46072248590571163,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5686130412558497 * pr) >= 0,
            0.9841187149588522 * pr + (-0.5777890742374759 * pl) >= 0,
            0.7782260531123968 * pf + (-0.5777890742374759 * pb) >= 0,
            1 * pb + (-0.4496505107752965 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.46072248590571163,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5686130412558497 * pr) >= 0,
            0.9841187149588522 * pr + (- 0.5777890742374759 * pl) >= 0,
            0.7782260531123968 * pf + (- 0.5777890742374759 * pb) >= 0,
            1 * pb + (- 0.4496505107752965 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.13270822830692786,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.0834234528903082 * pr) >= 0,
            0.1343323515461865 * pr + (- 0.6210227985298488 * pl) >= 0,
            0.17397789352420356 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.10804423831872895 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.13270822830692786,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.0834234528903082 * pr) >= 0,
            0.1343323515461865 * pr + (- 0.6210227985298488 * pl) >= 0,
            0.17397789352420356 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.10804423831872895 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.13270822830692786,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.0834234528903082 * pr) >= 0,
            0.1343323515461865 * pr + (-0.6210227985298488 * pl) >= 0,
            0.17397789352420356 * pf + (-0.6210227985298488 * pb) >= 0,
            1 * pb + (-0.10804423831872895 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.13270822830692786,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.0834234528903082 * pr) >= 0,
            0.1343323515461865 * pr + (- 0.6210227985298488 * pl) >= 0,
            0.17397789352420356 * pf + (- 0.6210227985298488 * pb) >= 0,
            1 * pb + (- 0.10804423831872895 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.29699788478205047,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.21811569186220736 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (- 0.17224906119695635 * pl) >= 0,
            0.06678726445848238 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.052742851762146555 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.29699788478205047,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.21811569186220736 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (- 0.17224906119695635 * pl) >= 0,
            0.06678726445848238 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.052742851762146555 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.29699788478205047,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.21811569186220736 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (-0.17224906119695635 * pl) >= 0,
            0.06678726445848238 * pf + (-0.7897142095845775 * pb) >= 0,
            1 * pb + (-0.052742851762146555 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.29699788478205047,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.21811569186220736 * pl + (- 0.7897142095845775 * pr) >= 0,
            1 * pr + (- 0.17224906119695635 * pl) >= 0,
            0.06678726445848238 * pf + (- 0.7897142095845775 * pb) >= 0,
            1 * pb + (- 0.052742851762146555 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 1) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 2) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.7986414462019813,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.781281081426651 * pr) >= 0,
            0.8974655078188976 * pr + (- 0.8705416248535183 * pl) >= 0,
            1 * pf + (- 0.8305137319024319 * pb) >= 0,
            0.9540195531054341 * pb + (- 0.8705416248535183 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 1 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 2) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.7986414462019813,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.781281081426651 * pr) >= 0,
            0.8974655078188976 * pr + (- 0.8705416248535183 * pl) >= 0,
            1 * pf + (- 0.8305137319024319 * pb) >= 0,
            0.9540195531054341 * pb + (- 0.9105695178046046 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 1) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 2) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 2) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.7986414462019813,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.781281081426651 * pr) >= 0,
            0.8974655078188976 * pr + (-0.8705416248535183 * pl) >= 0,
            1 * pf + (-0.8305137319024319 * pb) >= 0,
            0.9540195531054341 * pb + (-0.8705416248535183 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 1) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 2) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.7986414462019813,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.781281081426651 * pr) >= 0,
            0.8974655078188976 * pr + (- 0.8705416248535183 * pl) >= 0,
            1 * pf + (- 0.8305137319024319 * pb) >= 0,
            0.9540195531054341 * pb + (- 0.8705416248535183 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 1) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 2) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.32340916911492923,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.43684944685711735 * pr) >= 0,
            0.5868771802662207 * pr + (- 0.7443626393156957 * pl) >= 0,
            0.26938014445671987 * pf + (- 0.7443626393156957 * pb) >= 0,
            1 * pb + (- 0.20051651530704737 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 1 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 2) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.32340916911492923,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.43684944685711735 * pr) >= 0,
