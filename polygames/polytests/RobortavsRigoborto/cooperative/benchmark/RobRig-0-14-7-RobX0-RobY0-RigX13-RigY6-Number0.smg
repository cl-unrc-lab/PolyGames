// L_SLOPE[6][6]   =  -0.193661707109813
// L_SLOPE[6][7]   =  -0.34295857996902623
// L_SLOPE[6][8]   =  -0.17055678205711522
// L_SLOPE[6][9]   =  -0.8011993235225978
// L_SLOPE[6][10]   =  0.8173151087935611
// L_SLOPE[6][11]   =  -0.05199069772540721
// L_SLOPE[6][12]   =  0.6816966652553431
