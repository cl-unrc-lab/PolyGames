	            0.7338224801633992 * pr + (- 0.5777890742374759 * pl) >= 0,
	            0.368173806932681 * pf + (- 0.5777890742374759 * pb) >= 0,
	            1 * pb + (- 0.21272680306612093 * pf) >= 0
                };

                [rigb] (sched = 1) &  rigrow = 0 & rigcol = 0 & !Collision  -U->
