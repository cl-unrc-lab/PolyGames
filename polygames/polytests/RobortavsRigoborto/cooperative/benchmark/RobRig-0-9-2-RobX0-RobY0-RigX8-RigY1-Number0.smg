            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.0022856386288565567 * pl + (- 0.7443626393156957 * pr) >= 0,
            1 * pr + (- 0.0017013440022975743 * pl) >= 0,
            0.20232342406401305 * pf + (- 0.7443626393156957 * pb) >= 0,
