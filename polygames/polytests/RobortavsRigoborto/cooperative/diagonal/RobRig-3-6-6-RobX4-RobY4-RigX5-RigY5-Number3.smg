//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.11898231354594568
// Q_TERRAIN[0][1] = 0.27211461264797593
// Q_TERRAIN[0][2] = 0.18497758327403963
// Q_TERRAIN[0][3] = 0.30196001929809724
// Q_TERRAIN[0][4] = 0.312860152054027
// Q_TERRAIN[0][5] = 0.032764429619906554
// Q_TERRAIN[1][0] = 0.006583995777437068
// Q_TERRAIN[1][1] = 0.41873454104823
// Q_TERRAIN[1][2] = 0.12967700716400382
// Q_TERRAIN[1][3] = 0.11716548052334819
// Q_TERRAIN[1][4] = 0.4978224177552314
// Q_TERRAIN[1][5] = 0.23513175376122397
// Q_TERRAIN[2][0] = 0.4182307256371944
// Q_TERRAIN[2][1] = 0.23817660434966748
// Q_TERRAIN[2][2] = 0.31953407027208097
// Q_TERRAIN[2][3] = 0.07530821201176197
// Q_TERRAIN[2][4] = 0.3174303291425942
// Q_TERRAIN[2][5] = 0.4340226535716484
// Q_TERRAIN[3][0] = 0.26159060519165067
// Q_TERRAIN[3][1] = 0.37062592810074513
// Q_TERRAIN[3][2] = 0.3357057376847963
// Q_TERRAIN[3][3] = 0.03201571911349865
// Q_TERRAIN[3][4] = 0.37911512314340867
// Q_TERRAIN[3][5] = 0.2955497914656588
// Q_TERRAIN[4][0] = 0.15063382975785616
// Q_TERRAIN[4][1] = 0.015505875734874996
// Q_TERRAIN[4][2] = 0.4327636184894728
// Q_TERRAIN[4][3] = 0.23637454433273342
// Q_TERRAIN[4][4] = 0.35941196203290154
// Q_TERRAIN[4][5] = 0.43940640012774085
// Q_TERRAIN[5][0] = 0.35706474180560127
// Q_TERRAIN[5][1] = 0.46054933379193724
// Q_TERRAIN[5][2] = 0.19748170200037196
// Q_TERRAIN[5][3] = 0.40045438549261414
// Q_TERRAIN[5][4] = 0.22231052802538032
// Q_TERRAIN[5][5] = 0.46779336085226053

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.7577333206760832
// F_SLOPE[0][1] =  -0.8050913805382456
// F_SLOPE[0][2] =  -0.7280622795986622
// F_SLOPE[0][3] =  -0.5660261175337253
// F_SLOPE[0][4] =  0.9309602777964059
// F_SLOPE[0][5] =  -0.12767626674514143
// F_SLOPE[1][0] =  0.2532965817336079
// F_SLOPE[1][1] =  -0.39794760314898925
// F_SLOPE[1][2] =  0.014485967658119048
// F_SLOPE[1][3] =  -0.2282674823101949
// F_SLOPE[1][4] =  -0.2981790224596399
// F_SLOPE[1][5] =  0.17014821481072695
// F_SLOPE[2][0] =  0.16850358594039783
// F_SLOPE[2][1] =  0.8084035416955502
// F_SLOPE[2][2] =  0.3639642732699333
// F_SLOPE[2][3] =  0.857891202400034
// F_SLOPE[2][4] =  0.7128011327935113
// F_SLOPE[2][5] =  0.9819792897376303
// F_SLOPE[3][0] =  0.34254708432503644
// F_SLOPE[3][1] =  -0.6738007560578605
// F_SLOPE[3][2] =  0.7212750662325365
// F_SLOPE[3][3] =  0.9292658946181227
// F_SLOPE[3][4] =  0.8093919690244733
// F_SLOPE[3][5] =  0.13821500694864697
// F_SLOPE[4][0] =  0.42763404034839847
// F_SLOPE[4][1] =  -0.5777500326488034
// F_SLOPE[4][2] =  0.6632158605467084
// F_SLOPE[4][3] =  0.1470647047025695
// F_SLOPE[4][4] =  -0.4300850760275896
// F_SLOPE[4][5] =  -0.8730788457095413
// F_SLOPE[5][0] =  0.7078849768453603
// F_SLOPE[5][1] =  0.9796120298431625
// F_SLOPE[5][2] =  -0.8229638137805433
// F_SLOPE[5][3] =  0.6011906425150038
// F_SLOPE[5][4] =  -0.17907634530818228
// F_SLOPE[5][5] =  -0.6984692510943808

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.4122175063618756
// L_SLOPE[0][1]   =  0.5375837745546892
// L_SLOPE[0][2]   =  0.7455340492564027
// L_SLOPE[0][3]   =  -0.9116198777409132
// L_SLOPE[0][4]   =  0.22906505706361724
// L_SLOPE[0][5]   =  -0.9101195130079276
// L_SLOPE[1][0]   =  0.4368809548970325
// L_SLOPE[1][1]   =  -0.33809170796198496
// L_SLOPE[1][2]   =  0.7618106144947161
// L_SLOPE[1][3]   =  0.9612715136866792
// L_SLOPE[1][4]   =  0.010840747296088082
// L_SLOPE[1][5]   =  0.997017890751553
// L_SLOPE[2][0]   =  -0.38065989304732195
// L_SLOPE[2][1]   =  -0.8460585905891762
// L_SLOPE[2][2]   =  0.19952561759320142
// L_SLOPE[2][3]   =  -0.9372444756493645
// L_SLOPE[2][4]   =  -0.6052302871431612
// L_SLOPE[2][5]   =  -0.18412772876601835
// L_SLOPE[3][0]   =  0.22093424593468303
// L_SLOPE[3][1]   =  -0.6876020179728706
// L_SLOPE[3][2]   =  -0.9151283505575916
// L_SLOPE[3][3]   =  0.7355580678554448
// L_SLOPE[3][4]   =  -0.37233896016781665
// L_SLOPE[3][5]   =  0.9173188528169101
// L_SLOPE[4][0]   =  0.7933192828552031
// L_SLOPE[4][1]   =  -0.24442152117563465
// L_SLOPE[4][2]   =  -0.0791807343081905
// L_SLOPE[4][3]   =  0.040145969185127806
// L_SLOPE[4][4]   =  0.28777743677545375
// L_SLOPE[4][5]   =  0.19130047680394102
// L_SLOPE[5][0]   =  0.118522124030781
// L_SLOPE[5][1]   =  0.24025227089052392
// L_SLOPE[5][2]   =  0.8812425108479265
// L_SLOPE[5][3]   =  0.014053631891319585
// L_SLOPE[5][4]   =  -0.13761689313813452
// L_SLOPE[5][5]   =  0.44062250428827676
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 4;
    robrow : [0..6] init 4;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4522177429032741,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5877824936381244 * pl + (- 0.8810176864540543 * pr) >= 0,
            1 * pr + (- 0.5178467726832553 * pl) >= 0,
            0.24226667932391677 * pf + (- 0.8810176864540543 * pb) >= 0,
            1 * pb + (- 0.2134412293228634 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4522177429032741,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5877824936381244 * pl + (- 0.8810176864540543 * pr) >= 0,
            1 * pr + (- 0.5178467726832553 * pl) >= 0,
            0.24226667932391677 * pf + (- 0.8810176864540543 * pb) >= 0,
            1 * pb + (- 0.2134412293228634 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4522177429032741,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5877824936381244 * pl + (- 0.8810176864540543 * pr) >= 0,
            1 * pr + (-0.5178467726832553 * pl) >= 0,
            0.24226667932391677 * pf + (-0.8810176864540543 * pb) >= 0,
            1 * pb + (-0.2134412293228634 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4522177429032741,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5877824936381244 * pl + (- 0.8810176864540543 * pr) >= 0,
            1 * pr + (- 0.5178467726832553 * pl) >= 0,
            0.24226667932391677 * pf + (- 0.8810176864540543 * pb) >= 0,
            1 * pb + (- 0.2134412293228634 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2729498414111545,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.336586013376121 * pr) >= 0,
            0.4624162254453108 * pr + (- 0.7278853873520241 * pl) >= 0,
            1 * pf + (- 0.14187113597516737 * pb) >= 0,
            0.19490861946175442 * pb + (- 0.7278853873520241 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2729498414111545,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.336586013376121 * pr) >= 0,
            0.4624162254453108 * pr + (- 0.7278853873520241 * pl) >= 0,
            1 * pf + (- 0.14187113597516737 * pb) >= 0,
            0.19490861946175442 * pb + (- 1.3138996387288808 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2729498414111545,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.336586013376121 * pr) >= 0,
            0.4624162254453108 * pr + (-0.7278853873520241 * pl) >= 0,
            1 * pf + (-0.14187113597516737 * pb) >= 0,
            0.19490861946175442 * pb + (-0.7278853873520241 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2729498414111545,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.336586013376121 * pr) >= 0,
            0.4624162254453108 * pr + (- 0.7278853873520241 * pl) >= 0,
            1 * pf + (- 0.14187113597516737 * pb) >= 0,
            0.19490861946175442 * pb + (- 0.7278853873520241 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3496218620084468,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.20739545414951588 * pr) >= 0,
            0.25446595074359735 * pr + (- 0.8150224167259603 * pl) >= 0,
            1 * pf + (- 0.2216353380804468 * pb) >= 0,
            0.2719377204013378 * pb + (- 0.8150224167259603 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3496218620084468,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.20739545414951588 * pr) >= 0,
            0.25446595074359735 * pr + (- 0.8150224167259603 * pl) >= 0,
            1 * pf + (- 0.2216353380804468 * pb) >= 0,
            0.2719377204013378 * pb + (- 1.4084094953714739 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3496218620084468,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.20739545414951588 * pr) >= 0,
            0.25446595074359735 * pr + (-0.8150224167259603 * pl) >= 0,
            1 * pf + (-0.2216353380804468 * pb) >= 0,
            0.2719377204013378 * pb + (-0.8150224167259603 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3496218620084468,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.20739545414951588 * pr) >= 0,
            0.25446595074359735 * pr + (- 0.8150224167259603 * pl) >= 0,
            1 * pf + (- 0.2216353380804468 * pb) >= 0,
            0.2719377204013378 * pb + (- 0.8150224167259603 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.21721731309671277,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08838012225908676 * pl + (- 0.6980399807019028 * pr) >= 0,
            1 * pr + (- 0.061692858836164724 * pl) >= 0,
            1 * pf + (- 0.3029311205418882 * pb) >= 0,
            0.43397388246627466 * pb + (- 0.6980399807019028 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.21721731309671277,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08838012225908676 * pl + (- 0.6980399807019028 * pr) >= 0,
            1 * pr + (- 0.061692858836164724 * pl) >= 0,
            1 * pf + (- 0.3029311205418882 * pb) >= 0,
            0.43397388246627466 * pb + (- 1.0931488408619174 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.21721731309671277,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08838012225908676 * pl + (- 0.6980399807019028 * pr) >= 0,
            1 * pr + (-0.061692858836164724 * pl) >= 0,
            1 * pf + (-0.3029311205418882 * pb) >= 0,
            0.43397388246627466 * pb + (-0.6980399807019028 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.21721731309671277,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08838012225908676 * pl + (- 0.6980399807019028 * pr) >= 0,
            1 * pr + (- 0.061692858836164724 * pl) >= 0,
            1 * pf + (- 0.3029311205418882 * pb) >= 0,
