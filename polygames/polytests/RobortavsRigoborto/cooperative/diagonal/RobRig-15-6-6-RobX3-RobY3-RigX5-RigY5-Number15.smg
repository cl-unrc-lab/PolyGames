//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.4826210707760615
// Q_TERRAIN[0][1] = 0.005827346896070562
// Q_TERRAIN[0][2] = 0.3679958098984377
// Q_TERRAIN[0][3] = 0.07900636238237407
// Q_TERRAIN[0][4] = 0.49316972583141166
// Q_TERRAIN[0][5] = 0.008440327103988121
// Q_TERRAIN[1][0] = 0.4397456340673356
// Q_TERRAIN[1][1] = 0.3406753322007073
// Q_TERRAIN[1][2] = 0.4286711912407624
// Q_TERRAIN[1][3] = 0.4999081170830597
// Q_TERRAIN[1][4] = 0.11985759108189431
// Q_TERRAIN[1][5] = 0.16903887862834993
// Q_TERRAIN[2][0] = 0.35409716649256384
// Q_TERRAIN[2][1] = 0.14029084292156863
// Q_TERRAIN[2][2] = 0.13165712857373035
// Q_TERRAIN[2][3] = 0.11430486267445811
// Q_TERRAIN[2][4] = 0.4289185486971096
// Q_TERRAIN[2][5] = 0.4372663026868103
// Q_TERRAIN[3][0] = 0.3988079961887404
// Q_TERRAIN[3][1] = 0.11169560367479353
// Q_TERRAIN[3][2] = 0.46241914006554824
// Q_TERRAIN[3][3] = 0.25568497337574986
// Q_TERRAIN[3][4] = 0.11569293430875816
// Q_TERRAIN[3][5] = 0.22776840567841056
// Q_TERRAIN[4][0] = 0.20993766371019695
// Q_TERRAIN[4][1] = 0.03947964482421745
// Q_TERRAIN[4][2] = 0.2823457933926549
// Q_TERRAIN[4][3] = 0.17998222425320165
// Q_TERRAIN[4][4] = 0.2848078545747515
// Q_TERRAIN[4][5] = 0.4651086840556032
// Q_TERRAIN[5][0] = 0.3227856250501731
// Q_TERRAIN[5][1] = 0.20255021295282533
// Q_TERRAIN[5][2] = 0.43178699467191556
// Q_TERRAIN[5][3] = 0.49758645544141156
// Q_TERRAIN[5][4] = 0.24512826263610638
// Q_TERRAIN[5][5] = 0.47251240476524187

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  -0.9624998987360212
// F_SLOPE[0][1] =  -0.7193637559721249
// F_SLOPE[0][2] =  -0.6556109843544906
// F_SLOPE[0][3] =  0.8761295793201627
// F_SLOPE[0][4] =  0.38096990949056586
// F_SLOPE[0][5] =  0.43816468145521315
// F_SLOPE[1][0] =  -0.4267657171191923
// F_SLOPE[1][1] =  -0.010029850129936735
// F_SLOPE[1][2] =  0.7741294630700224
// F_SLOPE[1][3] =  -0.800248713913069
// F_SLOPE[1][4] =  -0.767556452820102
// F_SLOPE[1][5] =  -0.9051676679612941
// F_SLOPE[2][0] =  -0.06267682126827445
// F_SLOPE[2][1] =  0.6809643942341845
// F_SLOPE[2][2] =  0.10998096012803171
// F_SLOPE[2][3] =  -0.19708135839351937
// F_SLOPE[2][4] =  0.004113111382253454
// F_SLOPE[2][5] =  -0.6415770717905016
// F_SLOPE[3][0] =  0.8962659165273794
// F_SLOPE[3][1] =  -0.2923971849931781
// F_SLOPE[3][2] =  -0.5294801248592755
// F_SLOPE[3][3] =  -0.37753404431722304
// F_SLOPE[3][4] =  0.6498654280029978
// F_SLOPE[3][5] =  -0.3634648712442563
// F_SLOPE[4][0] =  0.809613026329078
// F_SLOPE[4][1] =  -0.327645124939421
// F_SLOPE[4][2] =  -0.116902995380326
// F_SLOPE[4][3] =  -0.8515980875904443
// F_SLOPE[4][4] =  0.8149424618138081
// F_SLOPE[4][5] =  0.5923029224939267
// F_SLOPE[5][0] =  -0.0511063912190548
// F_SLOPE[5][1] =  -0.7691988546193917
// F_SLOPE[5][2] =  -0.015033939632966842
// F_SLOPE[5][3] =  -0.2477034030050218
// F_SLOPE[5][4] =  0.6800054201487586
// F_SLOPE[5][5] =  0.8559662992916879

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.4822123511484542
// L_SLOPE[0][1]   =  -0.42557570242568077
// L_SLOPE[0][2]   =  -0.9172423265773693
// L_SLOPE[0][3]   =  0.787880004337594
// L_SLOPE[0][4]   =  0.8889989890911549
// L_SLOPE[0][5]   =  -0.6832502063693517
// L_SLOPE[1][0]   =  -0.0001471703497175625
// L_SLOPE[1][1]   =  -0.038058461658789344
// L_SLOPE[1][2]   =  0.9528574868804827
// L_SLOPE[1][3]   =  -0.9139023050619752
// L_SLOPE[1][4]   =  -0.8765869367947654
// L_SLOPE[1][5]   =  0.6874969911832014
// L_SLOPE[2][0]   =  0.13916189909408305
// L_SLOPE[2][1]   =  -0.07542222392893128
// L_SLOPE[2][2]   =  0.5554978512987301
// L_SLOPE[2][3]   =  0.18668093456504864
// L_SLOPE[2][4]   =  0.3848548191921932
// L_SLOPE[2][5]   =  -0.48874992611618007
// L_SLOPE[3][0]   =  -0.8301393894731479
// L_SLOPE[3][1]   =  -0.9821496150432611
// L_SLOPE[3][2]   =  -0.3337890095456324
// L_SLOPE[3][3]   =  0.2970001374973019
// L_SLOPE[3][4]   =  -0.24042225727999877
// L_SLOPE[3][5]   =  -0.30534407413059217
// L_SLOPE[4][0]   =  0.23710949622211874
// L_SLOPE[4][1]   =  0.41040176603691547
// L_SLOPE[4][2]   =  0.19090879627515722
// L_SLOPE[4][3]   =  -0.37652342694304375
// L_SLOPE[4][4]   =  0.6434849505259173
// L_SLOPE[4][5]   =  0.6014079664797161
// L_SLOPE[5][0]   =  0.7869952003539717
// L_SLOPE[5][1]   =  0.7851585207151393
// L_SLOPE[5][2]   =  -0.9699241534828922
// L_SLOPE[5][3]   =  0.33832906059361045
// L_SLOPE[5][4]   =  -0.3038290647200532
// L_SLOPE[5][5]   =  -0.2231098576077828
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 3;
    robrow : [0..6] init 3;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.02708747385652377,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.26789241932819347 * pr) >= 0,
            0.5177876488515458 * pr + (- 0.5173789292239386 * pl) >= 0,
            1 * pf + (- 0.01940176223774664 * pb) >= 0,
            0.03750010126397885 * pb + (- 0.5173789292239386 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.02708747385652377,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.26789241932819347 * pr) >= 0,
            0.5177876488515458 * pr + (- 0.5173789292239386 * pl) >= 0,
            1 * pf + (- 0.01940176223774664 * pb) >= 0,
            0.03750010126397885 * pb + (- 1.0153560962101305 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.02708747385652377,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.26789241932819347 * pr) >= 0,
            0.5177876488515458 * pr + (-0.5173789292239386 * pl) >= 0,
            1 * pf + (-0.01940176223774664 * pb) >= 0,
            0.03750010126397885 * pb + (-0.5173789292239386 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.02708747385652377,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.26789241932819347 * pr) >= 0,
            0.5177876488515458 * pr + (- 0.5173789292239386 * pl) >= 0,
            1 * pf + (- 0.01940176223774664 * pb) >= 0,
            0.03750010126397885 * pb + (- 0.5173789292239386 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5747747917787331,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5744242975743192 * pl + (- 0.9941726531039294 * pr) >= 0,
            1 * pr + (- 0.571076927926822 * pl) >= 0,
            1 * pf + (- 0.2790008792823144 * pb) >= 0,
            0.2806362440278751 * pb + (- 0.9941726531039294 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5747747917787331,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5744242975743192 * pl + (- 0.9941726531039294 * pr) >= 0,
            1 * pr + (- 0.571076927926822 * pl) >= 0,
            1 * pf + (- 0.2790008792823144 * pb) >= 0,
            0.2806362440278751 * pb + (- 1.7093444269255444 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5747747917787331,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5744242975743192 * pl + (- 0.9941726531039294 * pr) >= 0,
            1 * pr + (-0.571076927926822 * pl) >= 0,
            1 * pf + (-0.2790008792823144 * pb) >= 0,
            0.2806362440278751 * pb + (-0.9941726531039294 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5747747917787331,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5744242975743192 * pl + (- 0.9941726531039294 * pr) >= 0,
            1 * pr + (- 0.571076927926822 * pl) >= 0,
            1 * pf + (- 0.2790008792823144 * pb) >= 0,
            0.2806362440278751 * pb + (- 0.9941726531039294 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14625460694512848,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08275767342263074 * pl + (- 0.6320041901015623 * pr) >= 0,
            1 * pr + (- 0.05230319636615933 * pl) >= 0,
            1 * pf + (- 0.21765530091291443 * pb) >= 0,
            0.3443890156455094 * pb + (- 0.6320041901015623 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14625460694512848,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08275767342263074 * pl + (- 0.6320041901015623 * pr) >= 0,
            1 * pr + (- 0.05230319636615933 * pl) >= 0,
            1 * pf + (- 0.21765530091291443 * pb) >= 0,
            0.3443890156455094 * pb + (- 1.04635307929021 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14625460694512848,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08275767342263074 * pl + (- 0.6320041901015623 * pr) >= 0,
            1 * pr + (-0.05230319636615933 * pl) >= 0,
            1 * pf + (-0.21765530091291443 * pb) >= 0,
            0.3443890156455094 * pb + (-0.6320041901015623 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14625460694512848,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08275767342263074 * pl + (- 0.6320041901015623 * pr) >= 0,
            1 * pr + (- 0.05230319636615933 * pl) >= 0,
            1 * pf + (- 0.21765530091291443 * pb) >= 0,
            0.3443890156455094 * pb + (- 0.6320041901015623 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4341313341662797,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.19536116641655438 * pr) >= 0,
            0.21211999566240602 * pr + (- 0.920993637617626 * pl) >= 0,
            0.12387042067983733 * pf + (- 0.920993637617626 * pb) >= 0,
            1 * pb + (- 0.11408386933514898 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4341313341662797,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.19536116641655438 * pr) >= 0,
            0.21211999566240602 * pr + (- 0.920993637617626 * pl) >= 0,
            0.12387042067983733 * pf + (- 0.920993637617626 * pb) >= 0,
            1 * pb + (- 0.11408386933514898 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4341313341662797,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.19536116641655438 * pr) >= 0,
            0.21211999566240602 * pr + (-0.920993637617626 * pl) >= 0,
            0.12387042067983733 * pf + (-0.920993637617626 * pb) >= 0,
            1 * pb + (-0.11408386933514898 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4341313341662797,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.19536116641655438 * pr) >= 0,
            0.21211999566240602 * pr + (- 0.920993637617626 * pl) >= 0,
            0.12387042067983733 * pf + (- 0.920993637617626 * pb) >= 0,
            1 * pb + (- 0.11408386933514898 * pf) >= 0
