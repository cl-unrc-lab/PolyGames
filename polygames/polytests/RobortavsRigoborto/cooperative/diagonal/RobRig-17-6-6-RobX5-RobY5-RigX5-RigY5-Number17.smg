//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.2609919548562466
// Q_TERRAIN[0][1] = 0.40334538855933955
// Q_TERRAIN[0][2] = 0.4802473871619384
// Q_TERRAIN[0][3] = 0.14481268888223275
// Q_TERRAIN[0][4] = 0.3830537188989763
// Q_TERRAIN[0][5] = 0.3521099334217063
// Q_TERRAIN[1][0] = 0.3306915286119152
// Q_TERRAIN[1][1] = 0.05508102445860591
// Q_TERRAIN[1][2] = 0.013468389395263403
// Q_TERRAIN[1][3] = 0.19208555227214874
// Q_TERRAIN[1][4] = 0.3731975980831922
// Q_TERRAIN[1][5] = 0.126191883756611
// Q_TERRAIN[2][0] = 0.2508013352840169
// Q_TERRAIN[2][1] = 0.15871754527287485
// Q_TERRAIN[2][2] = 0.42316390456421205
// Q_TERRAIN[2][3] = 0.47259695725244466
// Q_TERRAIN[2][4] = 0.20079546845533475
// Q_TERRAIN[2][5] = 0.4992235025435105
// Q_TERRAIN[3][0] = 0.03109639562622335
// Q_TERRAIN[3][1] = 0.4063045002208078
// Q_TERRAIN[3][2] = 0.4376582510641403
// Q_TERRAIN[3][3] = 0.07545774013849005
// Q_TERRAIN[3][4] = 0.35278430779597536
// Q_TERRAIN[3][5] = 0.2794459343023374
// Q_TERRAIN[4][0] = 0.47759393113043436
// Q_TERRAIN[4][1] = 0.10500500474511115
// Q_TERRAIN[4][2] = 0.26998167531006184
// Q_TERRAIN[4][3] = 0.4412280534043501
// Q_TERRAIN[4][4] = 0.3193865905298982
// Q_TERRAIN[4][5] = 0.1545997649791626
// Q_TERRAIN[5][0] = 0.04093192706737131
// Q_TERRAIN[5][1] = 0.4698880235058575
// Q_TERRAIN[5][2] = 0.23704923555320268
// Q_TERRAIN[5][3] = 0.4981630913911116
// Q_TERRAIN[5][4] = 0.07080357031006768
// Q_TERRAIN[5][5] = 0.406102126124032

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.6267562434981773
// F_SLOPE[0][1] =  0.8399500449952804
// F_SLOPE[0][2] =  -0.9643313671233944
// F_SLOPE[0][3] =  -0.25561431688513037
// F_SLOPE[0][4] =  -0.8966620132792087
// F_SLOPE[0][5] =  0.5040696671439278
// F_SLOPE[1][0] =  -0.2907165281430535
// F_SLOPE[1][1] =  0.9190104376858088
// F_SLOPE[1][2] =  -0.25034197300558025
// F_SLOPE[1][3] =  0.5487498492771063
// F_SLOPE[1][4] =  0.7355773509362031
// F_SLOPE[1][5] =  -0.5221068692641024
// F_SLOPE[2][0] =  0.11363324841623368
// F_SLOPE[2][1] =  0.9147843606556916
// F_SLOPE[2][2] =  0.05383554037461313
// F_SLOPE[2][3] =  -0.28058436426353417
// F_SLOPE[2][4] =  -0.4655992826187909
// F_SLOPE[2][5] =  0.5729393851084212
// F_SLOPE[3][0] =  -0.6145049967240876
// F_SLOPE[3][1] =  0.2077928606963768
// F_SLOPE[3][2] =  0.11109285851020378
// F_SLOPE[3][3] =  0.10696165117207768
// F_SLOPE[3][4] =  -0.7410281263266176
// F_SLOPE[3][5] =  0.3171302722038083
// F_SLOPE[4][0] =  0.8330584518286817
// F_SLOPE[4][1] =  -0.36224201067198436
// F_SLOPE[4][2] =  -0.33585361996124163
// F_SLOPE[4][3] =  0.8180815216140931
// F_SLOPE[4][4] =  0.15669038567545157
// F_SLOPE[4][5] =  -0.4548445741070568
// F_SLOPE[5][0] =  -0.9804732940997827
// F_SLOPE[5][1] =  0.5065388976116993
// F_SLOPE[5][2] =  -0.3039920029161107
// F_SLOPE[5][3] =  -0.06568219148148957
// F_SLOPE[5][4] =  -0.45499403068704813
// F_SLOPE[5][5] =  0.26620398542219315

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.45796896812751964
// L_SLOPE[0][1]   =  -0.3804238251138279
// L_SLOPE[0][2]   =  -0.8499403633446236
// L_SLOPE[0][3]   =  0.9735810565249419
// L_SLOPE[0][4]   =  0.8200822395817318
// L_SLOPE[0][5]   =  -0.9586772230109972
// L_SLOPE[1][0]   =  0.1283696223087416
// L_SLOPE[1][1]   =  0.37199665812242344
// L_SLOPE[1][2]   =  -0.19397450260983806
// L_SLOPE[1][3]   =  0.4632809452926292
// L_SLOPE[1][4]   =  0.9196306612876113
// L_SLOPE[1][5]   =  0.1802931251593538
// L_SLOPE[2][0]   =  -0.216852334390782
// L_SLOPE[2][1]   =  -0.6087036878556431
// L_SLOPE[2][2]   =  -0.49716307281108696
// L_SLOPE[2][3]   =  -0.6983970302893232
// L_SLOPE[2][4]   =  -0.7791844322178199
// L_SLOPE[2][5]   =  -0.5752205692197705
// L_SLOPE[3][0]   =  0.6840485777448828
// L_SLOPE[3][1]   =  0.07395592786553551
// L_SLOPE[3][2]   =  0.6098715497510754
// L_SLOPE[3][3]   =  0.8403715240286007
// L_SLOPE[3][4]   =  0.6215693699741562
// L_SLOPE[3][5]   =  -0.9011141335748125
// L_SLOPE[4][0]   =  0.8519181373566027
// L_SLOPE[4][1]   =  -0.8144155637721622
// L_SLOPE[4][2]   =  0.5419315295194855
// L_SLOPE[4][3]   =  0.6778870709321045
// L_SLOPE[4][4]   =  0.3149027376934703
// L_SLOPE[4][5]   =  -0.1926346349678263
// L_SLOPE[5][0]   =  -0.8499658623018795
// L_SLOPE[5][1]   =  -0.829693070902918
// L_SLOPE[5][2]   =  0.27300541072038875
// L_SLOPE[5][3]   =  -0.5165913965562579
// L_SLOPE[5][4]   =  0.06456486818066876
// L_SLOPE[5][5]   =  -0.46954575812849964
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 5;
    robrow : [0..6] init 5;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.34016289438207536,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4005652932713332 * pr) >= 0,
            0.5420310318724804 * pr + (- 0.7390080451437534 * pl) >= 0,
            0.37324375650182273 * pf + (- 0.7390080451437534 * pb) >= 0,
            1 * pb + (- 0.2758301388545231 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.34016289438207536,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4005652932713332 * pr) >= 0,
            0.5420310318724804 * pr + (- 0.7390080451437534 * pl) >= 0,
            0.37324375650182273 * pf + (- 0.7390080451437534 * pb) >= 0,
            1 * pb + (- 0.2758301388545231 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.34016289438207536,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4005652932713332 * pr) >= 0,
            0.5420310318724804 * pr + (-0.7390080451437534 * pl) >= 0,
            0.37324375650182273 * pf + (-0.7390080451437534 * pb) >= 0,
            1 * pb + (-0.2758301388545231 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.34016289438207536,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4005652932713332 * pr) >= 0,
            0.5420310318724804 * pr + (- 0.7390080451437534 * pl) >= 0,
            0.37324375650182273 * pf + (- 0.7390080451437534 * pb) >= 0,
            1 * pb + (- 0.2758301388545231 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14623618089692458,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6195761748861721 * pl + (- 0.5966546114406605 * pr) >= 0,
            1 * pr + (- 0.36967298188459974 * pl) >= 0,
            0.16004995500471964 * pf + (- 0.5966546114406605 * pb) >= 0,
            1 * pb + (- 0.09549454371443618 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14623618089692458,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6195761748861721 * pl + (- 0.5966546114406605 * pr) >= 0,
            1 * pr + (- 0.36967298188459974 * pl) >= 0,
            0.16004995500471964 * pf + (- 0.5966546114406605 * pb) >= 0,
            1 * pb + (- 0.09549454371443618 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14623618089692458,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6195761748861721 * pl + (- 0.5966546114406605 * pr) >= 0,
            1 * pr + (-0.36967298188459974 * pl) >= 0,
            0.16004995500471964 * pf + (-0.5966546114406605 * pb) >= 0,
            1 * pb + (-0.09549454371443618 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14623618089692458,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6195761748861721 * pl + (- 0.5966546114406605 * pr) >= 0,
            1 * pr + (- 0.36967298188459974 * pl) >= 0,
            0.16004995500471964 * pf + (- 0.5966546114406605 * pb) >= 0,
            1 * pb + (- 0.09549454371443618 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.022428823882790327,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.15005963665537636 * pl + (- 0.5197526128380616 * pr) >= 0,
            1 * pr + (- 0.07799388823316203 * pl) >= 0,
            1 * pf + (- 0.018538865133977345 * pb) >= 0,
            0.0356686328766056 * pb + (- 0.5197526128380616 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.022428823882790327,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.15005963665537636 * pl + (- 0.5197526128380616 * pr) >= 0,
            1 * pr + (- 0.07799388823316203 * pl) >= 0,
            1 * pf + (- 0.018538865133977345 * pb) >= 0,
            0.0356686328766056 * pb + (- 1.020966360542146 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.022428823882790327,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.15005963665537636 * pl + (- 0.5197526128380616 * pr) >= 0,
            1 * pr + (-0.07799388823316203 * pl) >= 0,
            1 * pf + (-0.018538865133977345 * pb) >= 0,
            0.0356686328766056 * pb + (-0.5197526128380616 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.022428823882790327,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.15005963665537636 * pl + (- 0.5197526128380616 * pr) >= 0,
            1 * pr + (- 0.07799388823316203 * pl) >= 0,
            1 * pf + (- 0.018538865133977345 * pb) >= 0,
            0.0356686328766056 * pb + (- 0.5197526128380616 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3650202527606944,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.022593145233007247 * pr) >= 0,
            0.026418943475058132 * pr + (- 0.8551873111177672 * pl) >= 0,
            1 * pf + (- 0.6365891907775677 * pb) >= 0,
            0.7443856831148696 * pb + (- 0.8551873111177672 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3650202527606944,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.022593145233007247 * pr) >= 0,
            0.026418943475058132 * pr + (- 0.8551873111177672 * pl) >= 0,
            1 * pf + (- 0.6365891907775677 * pb) >= 0,
            0.7443856831148696 * pb + (- 1.0737854314579667 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3650202527606944,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.022593145233007247 * pr) >= 0,
            0.026418943475058132 * pr + (-0.8551873111177672 * pl) >= 0,
            1 * pf + (-0.6365891907775677 * pb) >= 0,
            0.7443856831148696 * pb + (-0.8551873111177672 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3650202527606944,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.022593145233007247 * pr) >= 0,
            0.026418943475058132 * pr + (- 0.8551873111177672 * pl) >= 0,
            1 * pf + (- 0.6365891907775677 * pb) >= 0,
