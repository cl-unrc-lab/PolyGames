//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.33856291340013517
// Q_TERRAIN[0][1] = 0.3924556780435554
// Q_TERRAIN[0][2] = 0.26023307860154077
// Q_TERRAIN[0][3] = 0.2557458512466301
// Q_TERRAIN[0][4] = 0.19676733146298242
// Q_TERRAIN[0][5] = 0.4984084685489495
// Q_TERRAIN[1][0] = 0.14468247288728536
// Q_TERRAIN[1][1] = 0.07412989659234731
// Q_TERRAIN[1][2] = 0.13053928728277914
// Q_TERRAIN[1][3] = 0.1302185968006645
// Q_TERRAIN[1][4] = 0.16368350747230537
// Q_TERRAIN[1][5] = 0.13395542217235662
// Q_TERRAIN[2][0] = 0.05382196893282287
// Q_TERRAIN[2][1] = 0.16274987122864065
// Q_TERRAIN[2][2] = 0.15553253525071076
// Q_TERRAIN[2][3] = 0.2846200079381597
// Q_TERRAIN[2][4] = 0.10081546708623129
// Q_TERRAIN[2][5] = 0.03539385989457505
// Q_TERRAIN[3][0] = 0.10127601442445655
// Q_TERRAIN[3][1] = 0.27122129669639083
// Q_TERRAIN[3][2] = 0.19428090701287476
// Q_TERRAIN[3][3] = 0.3667352872852296
// Q_TERRAIN[3][4] = 0.40152976698611476
// Q_TERRAIN[3][5] = 0.2072187960773803
// Q_TERRAIN[4][0] = 0.049679206978892054
// Q_TERRAIN[4][1] = 0.36399744236163745
// Q_TERRAIN[4][2] = 0.3778315702557435
// Q_TERRAIN[4][3] = 0.19803166553490364
// Q_TERRAIN[4][4] = 0.32914464916740427
// Q_TERRAIN[4][5] = 0.1495253912014387
// Q_TERRAIN[5][0] = 0.4574467372234946
// Q_TERRAIN[5][1] = 0.4169034330491694
// Q_TERRAIN[5][2] = 0.3959815116117626
// Q_TERRAIN[5][3] = 0.47695750894543926
// Q_TERRAIN[5][4] = 0.11642064815272696
// Q_TERRAIN[5][5] = 0.2726259662829304

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.4627544746952925
// F_SLOPE[0][1] =  0.602948474993205
// F_SLOPE[0][2] =  -0.2194397867990523
// F_SLOPE[0][3] =  -0.7229129950008635
// F_SLOPE[0][4] =  0.2526346220568241
// F_SLOPE[0][5] =  -0.7907162823197915
// F_SLOPE[1][0] =  0.41071971443398847
// F_SLOPE[1][1] =  -0.9860901988003745
// F_SLOPE[1][2] =  -0.0910002752257959
// F_SLOPE[1][3] =  -0.04049106547038628
// F_SLOPE[1][4] =  -0.7604025226805369
// F_SLOPE[1][5] =  -0.03961316012460503
// F_SLOPE[2][0] =  0.00013265749815016825
// F_SLOPE[2][1] =  -0.2618569518879037
// F_SLOPE[2][2] =  0.7925462803540102
// F_SLOPE[2][3] =  0.7321403351947584
// F_SLOPE[2][4] =  0.7810694426725333
// F_SLOPE[2][5] =  -0.5102328942487968
// F_SLOPE[3][0] =  -0.9482352813187607
// F_SLOPE[3][1] =  -0.2467767230897917
// F_SLOPE[3][2] =  -0.7726836550860858
// F_SLOPE[3][3] =  0.41046183783460255
// F_SLOPE[3][4] =  -0.4741245517819206
// F_SLOPE[3][5] =  -0.7432334501203492
// F_SLOPE[4][0] =  -0.43258424923944294
// F_SLOPE[4][1] =  -0.19315336207873357
// F_SLOPE[4][2] =  0.47079919533499437
// F_SLOPE[4][3] =  -0.07792022170553481
// F_SLOPE[4][4] =  -0.39764511125814983
// F_SLOPE[4][5] =  0.3547401393279743
// F_SLOPE[5][0] =  -0.9093466240572949
// F_SLOPE[5][1] =  -0.5815878762114226
// F_SLOPE[5][2] =  0.3749401862176065
// F_SLOPE[5][3] =  0.5040938916892066
// F_SLOPE[5][4] =  -0.7973821541224246
// F_SLOPE[5][5] =  -0.8670641263020367

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.011592767405975257
// L_SLOPE[0][1]   =  0.31290018493681115
// L_SLOPE[0][2]   =  -0.9677685771111395
// L_SLOPE[0][3]   =  -0.12644781695372487
// L_SLOPE[0][4]   =  -0.4504002470467108
// L_SLOPE[0][5]   =  -0.8297898601536051
// L_SLOPE[1][0]   =  -0.6577217365784824
// L_SLOPE[1][1]   =  -0.428318800284166
// L_SLOPE[1][2]   =  -0.06592007232244423
// L_SLOPE[1][3]   =  -0.775554951983876
// L_SLOPE[1][4]   =  0.24068690046174446
// L_SLOPE[1][5]   =  0.7575096189696204
// L_SLOPE[2][0]   =  0.36795276121526954
// L_SLOPE[2][1]   =  -0.8640477295391806
// L_SLOPE[2][2]   =  0.2969916454857029
// L_SLOPE[2][3]   =  0.2677354388415496
// L_SLOPE[2][4]   =  -0.9824607241431991
// L_SLOPE[2][5]   =  -0.23060192732843343
// L_SLOPE[3][0]   =  0.3050976736809572
// L_SLOPE[3][1]   =  0.9002829736027624
// L_SLOPE[3][2]   =  0.8579072958128302
// L_SLOPE[3][3]   =  0.13906284489731746
// L_SLOPE[3][4]   =  0.17770234281696196
// L_SLOPE[3][5]   =  0.9169375338107209
// L_SLOPE[4][0]   =  -0.578746761913868
// L_SLOPE[4][1]   =  0.018285770974107995
// L_SLOPE[4][2]   =  -0.8769125636732302
// L_SLOPE[4][3]   =  0.5491925519840819
// L_SLOPE[4][4]   =  0.3072911330384773
// L_SLOPE[4][5]   =  -0.5788326700901525
// L_SLOPE[5][0]   =  -0.6058341369946476
// L_SLOPE[5][1]   =  0.047447613864831206
// L_SLOPE[5][2]   =  0.5034038499431313
// L_SLOPE[5][3]   =  -0.7282247545145295
// L_SLOPE[5][4]   =  -0.3531904994822894
// L_SLOPE[5][5]   =  0.025514212302579997
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 1;
    robrow : [0..6] init 1;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4269457680448394,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6537692003012268 * pr) >= 0,
            0.9884072325940247 * pr + (- 0.6614370865998649 * pl) >= 0,
            0.5372455253047075 * pf + (- 0.6614370865998649 * pb) >= 0,
            1 * pb + (- 0.3553541150463597 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4269457680448394,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6537692003012268 * pr) >= 0,
            0.9884072325940247 * pr + (- 0.6614370865998649 * pl) >= 0,
            0.5372455253047075 * pf + (- 0.6614370865998649 * pb) >= 0,
            1 * pb + (- 0.3553541150463597 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4269457680448394,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6537692003012268 * pr) >= 0,
            0.9884072325940247 * pr + (-0.6614370865998649 * pl) >= 0,
            0.5372455253047075 * pf + (-0.6614370865998649 * pb) >= 0,
            1 * pb + (-0.3553541150463597 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4269457680448394,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6537692003012268 * pr) >= 0,
            0.9884072325940247 * pr + (- 0.6614370865998649 * pl) >= 0,
            0.5372455253047075 * pf + (- 0.6614370865998649 * pb) >= 0,
            1 * pb + (- 0.3553541150463597 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.24395133665780755,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4174435912589635 * pr) >= 0,
            0.6870998150631888 * pr + (- 0.6075443219564446 * pl) >= 0,
            0.39705152500679497 * pf + (- 0.6075443219564446 * pb) >= 0,
            1 * pb + (- 0.24122639954202554 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.24395133665780755,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4174435912589635 * pr) >= 0,
            0.6870998150631888 * pr + (- 0.6075443219564446 * pl) >= 0,
            0.39705152500679497 * pf + (- 0.6075443219564446 * pb) >= 0,
            1 * pb + (- 0.24122639954202554 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.24395133665780755,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4174435912589635 * pr) >= 0,
            0.6870998150631888 * pr + (-0.6075443219564446 * pl) >= 0,
            0.39705152500679497 * pf + (-0.6075443219564446 * pb) >= 0,
            1 * pb + (-0.24122639954202554 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.24395133665780755,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4174435912589635 * pr) >= 0,
            0.6870998150631888 * pr + (- 0.6075443219564446 * pl) >= 0,
            0.39705152500679497 * pf + (- 0.6075443219564446 * pb) >= 0,
            1 * pb + (- 0.24122639954202554 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2523462045594087,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.032231422888860495 * pl + (- 0.7397669213984592 * pr) >= 0,
            1 * pr + (- 0.023843740482784162 * pl) >= 0,
            1 * pf + (- 0.57743262588579 * pb) >= 0,
            0.7805602132009477 * pb + (- 0.7397669213984592 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2523462045594087,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.032231422888860495 * pl + (- 0.7397669213984592 * pr) >= 0,
            1 * pr + (- 0.023843740482784162 * pl) >= 0,
            1 * pf + (- 0.57743262588579 * pb) >= 0,
            0.7805602132009477 * pb + (- 0.9021012169111284 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2523462045594087,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.032231422888860495 * pl + (- 0.7397669213984592 * pr) >= 0,
            1 * pr + (-0.023843740482784162 * pl) >= 0,
            1 * pf + (-0.57743262588579 * pb) >= 0,
            0.7805602132009477 * pb + (-0.7397669213984592 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2523462045594087,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.032231422888860495 * pl + (- 0.7397669213984592 * pr) >= 0,
            1 * pr + (- 0.023843740482784162 * pl) >= 0,
            1 * pf + (- 0.57743262588579 * pb) >= 0,
            0.7805602132009477 * pb + (- 0.7397669213984592 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.36527912780874483,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8735521830462751 * pl + (- 0.7442541487533699 * pr) >= 0,
            1 * pr + (- 0.6501448363847535 * pl) >= 0,
            1 * pf + (- 0.2062231530362531 * pb) >= 0,
            0.2770870049991365 * pb + (- 0.7442541487533699 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.36527912780874483,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8735521830462751 * pl + (- 0.7442541487533699 * pr) >= 0,
            1 * pr + (- 0.6501448363847535 * pl) >= 0,
            1 * pf + (- 0.2062231530362531 * pb) >= 0,
            0.2770870049991365 * pb + (- 1.2822851444704868 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.36527912780874483,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8735521830462751 * pl + (- 0.7442541487533699 * pr) >= 0,
            1 * pr + (-0.6501448363847535 * pl) >= 0,
            1 * pf + (-0.2062231530362531 * pb) >= 0,
            0.2770870049991365 * pb + (-0.7442541487533699 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.36527912780874483,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8735521830462751 * pl + (- 0.7442541487533699 * pr) >= 0,
            1 * pr + (- 0.6501448363847535 * pl) >= 0,
            1 * pf + (- 0.2062231530362531 * pb) >= 0,
