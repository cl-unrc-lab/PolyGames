//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.23150367890751072
// Q_TERRAIN[0][1] = 0.18665596569752102
// Q_TERRAIN[0][2] = 0.06926970625722761
// Q_TERRAIN[0][3] = 0.43328092499317067
// Q_TERRAIN[0][4] = 0.003217527040561663
// Q_TERRAIN[0][5] = 0.2513910400261042
// Q_TERRAIN[1][0] = 0.44914898501596906
// Q_TERRAIN[1][1] = 0.04040732359150051
// Q_TERRAIN[1][2] = 0.27713523408914303
// Q_TERRAIN[1][3] = 0.3083250213418092
// Q_TERRAIN[1][4] = 0.020447882742405776
// Q_TERRAIN[1][5] = 0.18950980219771785
// Q_TERRAIN[2][0] = 0.3517401961468735
// Q_TERRAIN[2][1] = 0.22601046022501287
// Q_TERRAIN[2][2] = 0.3625326842911045
// Q_TERRAIN[2][3] = 0.07857858079831292
// Q_TERRAIN[2][4] = 0.11900610123326638
// Q_TERRAIN[2][5] = 0.05547376398900733
// Q_TERRAIN[3][0] = 0.25313452583449114
// Q_TERRAIN[3][1] = 0.46191489320614776
// Q_TERRAIN[3][2] = 0.29521422856795626
// Q_TERRAIN[3][3] = 0.38710473361775555
// Q_TERRAIN[3][4] = 0.1918324224263241
// Q_TERRAIN[3][5] = 0.3730476084622143
// Q_TERRAIN[4][0] = 0.05083471878973922
// Q_TERRAIN[4][1] = 0.14558903949320356
// Q_TERRAIN[4][2] = 0.3371180006276856
// Q_TERRAIN[4][3] = 0.36285317612065243
// Q_TERRAIN[4][4] = 0.2108776975034775
// Q_TERRAIN[4][5] = 0.043856191532985256
// Q_TERRAIN[5][0] = 0.13336678561337023
// Q_TERRAIN[5][1] = 0.10494506506824086
// Q_TERRAIN[5][2] = 0.1405922075422844
// Q_TERRAIN[5][3] = 0.40475535036323484
// Q_TERRAIN[5][4] = 0.09974161054492264
// Q_TERRAIN[5][5] = 0.4431998655396387

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.7587463768003537
// F_SLOPE[0][1] =  -0.8904212877778306
// F_SLOPE[0][2] =  -0.24236719540049934
// F_SLOPE[0][3] =  -0.016576526475804876
// F_SLOPE[0][4] =  -0.953033682156603
// F_SLOPE[0][5] =  -0.15054929649481785
// F_SLOPE[1][0] =  0.8128212519099058
// F_SLOPE[1][1] =  -0.7759074574111022
// F_SLOPE[1][2] =  0.19369128352216802
// F_SLOPE[1][3] =  -0.7575351183956394
// F_SLOPE[1][4] =  0.15740059610710055
// F_SLOPE[1][5] =  0.7906068988471684
// F_SLOPE[2][0] =  -0.5938936124709742
// F_SLOPE[2][1] =  -0.9834948794174907
// F_SLOPE[2][2] =  -0.8329928050460906
// F_SLOPE[2][3] =  0.07953888055171765
// F_SLOPE[2][4] =  -0.9650703146934005
// F_SLOPE[2][5] =  -0.8303268764469305
// F_SLOPE[3][0] =  -0.0065167019130643045
// F_SLOPE[3][1] =  0.8418526380982316
// F_SLOPE[3][2] =  -0.15978515045612784
// F_SLOPE[3][3] =  -0.20373035681002616
// F_SLOPE[3][4] =  0.2774350757136599
// F_SLOPE[3][5] =  -0.8131644025318674
// F_SLOPE[4][0] =  0.15960030474300968
// F_SLOPE[4][1] =  -0.6548896142882785
// F_SLOPE[4][2] =  0.2177766966765411
// F_SLOPE[4][3] =  0.916651815789939
// F_SLOPE[4][4] =  -0.8916535933316574
// F_SLOPE[4][5] =  0.11012143914736772
// F_SLOPE[5][0] =  0.21276163834315098
// F_SLOPE[5][1] =  -0.701391045076404
// F_SLOPE[5][2] =  -0.4633788952695965
// F_SLOPE[5][3] =  0.9897678133142245
// F_SLOPE[5][4] =  0.9959285413360321
// F_SLOPE[5][5] =  -0.7573287506601207

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.4109365254993378
// L_SLOPE[0][1]   =  0.9018455729803745
// L_SLOPE[0][2]   =  -0.5264278030136271
// L_SLOPE[0][3]   =  0.22225489474700932
// L_SLOPE[0][4]   =  -0.9139385113716765
// L_SLOPE[0][5]   =  -0.26810628405711334
// L_SLOPE[1][0]   =  0.3482494879075724
// L_SLOPE[1][1]   =  0.1805180842463885
// L_SLOPE[1][2]   =  0.5492500020222908
// L_SLOPE[1][3]   =  -0.8265217711423201
// L_SLOPE[1][4]   =  -0.30560369625738404
// L_SLOPE[1][5]   =  0.7280721199767071
// L_SLOPE[2][0]   =  0.16827965327454186
// L_SLOPE[2][1]   =  -0.09739999160124957
// L_SLOPE[2][2]   =  -0.19565939607065674
// L_SLOPE[2][3]   =  0.9721433214381818
// L_SLOPE[2][4]   =  0.14887185015826376
// L_SLOPE[2][5]   =  -0.9632667693653072
// L_SLOPE[3][0]   =  0.598739707585376
// L_SLOPE[3][1]   =  -0.3425756990817945
// L_SLOPE[3][2]   =  -0.1328550113483129
// L_SLOPE[3][3]   =  -0.5731455948694661
// L_SLOPE[3][4]   =  -0.11197106138412183
// L_SLOPE[3][5]   =  -0.35058087386639536
// L_SLOPE[4][0]   =  -0.822366873813368
// L_SLOPE[4][1]   =  0.25902033276687453
// L_SLOPE[4][2]   =  -0.7938611281290024
// L_SLOPE[4][3]   =  0.5681975492114382
// L_SLOPE[4][4]   =  -0.9492178204449742
// L_SLOPE[4][5]   =  0.5614426666562948
// L_SLOPE[5][0]   =  0.6150996450876924
// L_SLOPE[5][1]   =  -0.005338797776719195
// L_SLOPE[5][2]   =  0.418895822432384
// L_SLOPE[5][3]   =  -0.5034783249195449
// L_SLOPE[5][4]   =  0.47523351112425516
// L_SLOPE[5][5]   =  -0.14998595941285853
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 3;
    robrow : [0..6] init 3;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3395531698514178,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4526931130437183 * pr) >= 0,
            0.5890634745006622 * pr + (- 0.7684963210924893 * pl) >= 0,
            0.24125362319964627 * pf + (- 0.7684963210924893 * pb) >= 0,
            1 * pb + (- 0.18540252187916179 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3395531698514178,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4526931130437183 * pr) >= 0,
            0.5890634745006622 * pr + (- 0.7684963210924893 * pl) >= 0,
            0.24125362319964627 * pf + (- 0.7684963210924893 * pb) >= 0,
            1 * pb + (- 0.18540252187916179 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3395531698514178,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4526931130437183 * pr) >= 0,
            0.5890634745006622 * pr + (-0.7684963210924893 * pl) >= 0,
            0.24125362319964627 * pf + (-0.7684963210924893 * pb) >= 0,
            1 * pb + (-0.18540252187916179 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3395531698514178,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.4526931130437183 * pr) >= 0,
            0.5890634745006622 * pr + (- 0.7684963210924893 * pl) >= 0,
            0.24125362319964627 * pf + (- 0.7684963210924893 * pb) >= 0,
            1 * pb + (- 0.18540252187916179 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3187218521583367,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07983331765679046 * pr) >= 0,
            0.09815442701962551 * pr + (- 0.8133440343024789 * pl) >= 0,
            1 * pf + (- 0.08912519187244963 * pb) >= 0,
            0.10957871222216942 * pb + (- 0.8133440343024789 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3187218521583367,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07983331765679046 * pr) >= 0,
            0.09815442701962551 * pr + (- 0.8133440343024789 * pl) >= 0,
            1 * pf + (- 0.08912519187244963 * pb) >= 0,
            0.10957871222216942 * pb + (- 1.5375628767325082 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3187218521583367,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07983331765679046 * pr) >= 0,
            0.09815442701962551 * pr + (-0.8133440343024789 * pl) >= 0,
            1 * pf + (-0.08912519187244963 * pb) >= 0,
            0.10957871222216942 * pb + (-0.8133440343024789 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3187218521583367,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07983331765679046 * pr) >= 0,
            0.09815442701962551 * pr + (- 0.8133440343024789 * pl) >= 0,
            1 * pf + (- 0.08912519187244963 * pb) >= 0,
            0.10957871222216942 * pb + (- 0.8133440343024789 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6101272096343389,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4735721969863729 * pl + (- 0.9307302937427724 * pr) >= 0,
            1 * pr + (- 0.44076799000953687 * pl) >= 0,
            1 * pf + (- 0.7051518027740538 * pb) >= 0,
            0.7576328045995007 * pb + (- 0.9307302937427724 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6101272096343389,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4735721969863729 * pl + (- 0.9307302937427724 * pr) >= 0,
            1 * pr + (- 0.44076799000953687 * pl) >= 0,
            1 * pf + (- 0.7051518027740538 * pb) >= 0,
            0.7576328045995007 * pb + (- 1.156308784711491 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6101272096343389,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4735721969863729 * pl + (- 0.9307302937427724 * pr) >= 0,
            1 * pr + (-0.44076799000953687 * pl) >= 0,
            1 * pf + (-0.7051518027740538 * pb) >= 0,
            0.7576328045995007 * pb + (-0.9307302937427724 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6101272096343389,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4735721969863729 * pl + (- 0.9307302937427724 * pr) >= 0,
            1 * pr + (- 0.44076799000953687 * pl) >= 0,
            1 * pf + (- 0.7051518027740538 * pb) >= 0,
            0.7576328045995007 * pb + (- 0.9307302937427724 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.44914547146899775,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.440762986640064 * pr) >= 0,
            0.7777451052529907 * pr + (- 0.5667190750068294 * pl) >= 0,
            1 * pf + (- 0.5573248412556351 * pb) >= 0,
            0.9834234735241951 * pb + (- 0.5667190750068294 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.44914547146899775,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.440762986640064 * pr) >= 0,
            0.7777451052529907 * pr + (- 0.5667190750068294 * pl) >= 0,
            1 * pf + (- 0.5573248412556351 * pb) >= 0,
            0.9834234735241951 * pb + (- 0.5761133087580237 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.44914547146899775,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.440762986640064 * pr) >= 0,
            0.7777451052529907 * pr + (-0.5667190750068294 * pl) >= 0,
            1 * pf + (-0.5573248412556351 * pb) >= 0,
            0.9834234735241951 * pb + (-0.5667190750068294 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.44914547146899775,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.440762986640064 * pr) >= 0,
            0.7777451052529907 * pr + (- 0.5667190750068294 * pl) >= 0,
            1 * pf + (- 0.5573248412556351 * pb) >= 0,
