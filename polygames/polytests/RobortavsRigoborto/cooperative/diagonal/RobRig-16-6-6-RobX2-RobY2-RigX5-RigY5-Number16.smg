//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.18076138745703757
// Q_TERRAIN[0][1] = 0.240240332800647
// Q_TERRAIN[0][2] = 0.2084763133028324
// Q_TERRAIN[0][3] = 0.2233796268919616
// Q_TERRAIN[0][4] = 0.20475786497494808
// Q_TERRAIN[0][5] = 0.3288529131971354
// Q_TERRAIN[1][0] = 0.12942769094503914
// Q_TERRAIN[1][1] = 0.3174979620517421
// Q_TERRAIN[1][2] = 0.005064186813672489
// Q_TERRAIN[1][3] = 0.1510218523998229
// Q_TERRAIN[1][4] = 0.1675316753488595
// Q_TERRAIN[1][5] = 0.07097525876641703
// Q_TERRAIN[2][0] = 0.3717071250159589
// Q_TERRAIN[2][1] = 0.15505412601747265
// Q_TERRAIN[2][2] = 0.39462099678945045
// Q_TERRAIN[2][3] = 0.47810251862850606
// Q_TERRAIN[2][4] = 0.12675300248106297
// Q_TERRAIN[2][5] = 0.4467703519536548
// Q_TERRAIN[3][0] = 0.4038184121476416
// Q_TERRAIN[3][1] = 0.33370948445408044
// Q_TERRAIN[3][2] = 0.013684676828715825
// Q_TERRAIN[3][3] = 0.22839416414010338
// Q_TERRAIN[3][4] = 0.31337437668272156
// Q_TERRAIN[3][5] = 0.14811282599505005
// Q_TERRAIN[4][0] = 0.11216775619481278
// Q_TERRAIN[4][1] = 0.15489509463974305
// Q_TERRAIN[4][2] = 0.12911752395436632
// Q_TERRAIN[4][3] = 0.3939126062614487
// Q_TERRAIN[4][4] = 0.1738902721341431
// Q_TERRAIN[4][5] = 0.2115616370616228
// Q_TERRAIN[5][0] = 0.32151117612520513
// Q_TERRAIN[5][1] = 0.47419177205355634
// Q_TERRAIN[5][2] = 0.14651099808050505
// Q_TERRAIN[5][3] = 0.022003301541502707
// Q_TERRAIN[5][4] = 0.4869421872630905
// Q_TERRAIN[5][5] = 0.41628528386332864

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.5806623996225257
// F_SLOPE[0][1] =  0.0467453356544385
// F_SLOPE[0][2] =  -0.5303992258029209
// F_SLOPE[0][3] =  -0.6909811897743612
// F_SLOPE[0][4] =  -0.3915238333283677
// F_SLOPE[0][5] =  -0.07823536614183269
// F_SLOPE[1][0] =  -0.8685360973439207
// F_SLOPE[1][1] =  0.39857044044515244
// F_SLOPE[1][2] =  0.4557649172811964
// F_SLOPE[1][3] =  -0.9738644444177655
// F_SLOPE[1][4] =  0.6848567554994254
// F_SLOPE[1][5] =  -0.016936152965010498
// F_SLOPE[2][0] =  0.8375308042747653
// F_SLOPE[2][1] =  -0.049843554213645724
// F_SLOPE[2][2] =  0.5914765614709259
// F_SLOPE[2][3] =  -0.09146717439650409
// F_SLOPE[2][4] =  0.22605462488761052
// F_SLOPE[2][5] =  -0.0015351972827353233
// F_SLOPE[3][0] =  -0.9544914518582248
// F_SLOPE[3][1] =  -0.7121018214958865
// F_SLOPE[3][2] =  -0.5354768645833945
// F_SLOPE[3][3] =  -0.18756680344393417
// F_SLOPE[3][4] =  -0.2615021611299113
// F_SLOPE[3][5] =  0.07843907241521597
// F_SLOPE[4][0] =  0.31873256936917693
// F_SLOPE[4][1] =  -0.1999781339792286
// F_SLOPE[4][2] =  -0.3612508851665741
// F_SLOPE[4][3] =  0.022244835920753436
// F_SLOPE[4][4] =  0.9055320294773197
// F_SLOPE[4][5] =  0.5656456750730614
// F_SLOPE[5][0] =  0.310806376188705
// F_SLOPE[5][1] =  0.6339766989781332
// F_SLOPE[5][2] =  -0.5443779182437407
// F_SLOPE[5][3] =  -0.7981913580361688
// F_SLOPE[5][4] =  -0.8137442984917356
// F_SLOPE[5][5] =  -0.7569703125486809

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.9817221254957569
// L_SLOPE[0][1]   =  0.2511620528488774
// L_SLOPE[0][2]   =  0.8375073349954814
// L_SLOPE[0][3]   =  -0.7727991977649047
// L_SLOPE[0][4]   =  0.3736005879673536
// L_SLOPE[0][5]   =  0.8811540729815122
// L_SLOPE[1][0]   =  0.530765405188266
// L_SLOPE[1][1]   =  -0.6936401143708126
// L_SLOPE[1][2]   =  0.2767039938782574
// L_SLOPE[1][3]   =  -0.4890491479688124
// L_SLOPE[1][4]   =  -0.6437064620537845
// L_SLOPE[1][5]   =  -0.9777200335425325
// L_SLOPE[2][0]   =  0.05080661541882847
// L_SLOPE[2][1]   =  0.8379676657332855
// L_SLOPE[2][2]   =  -0.7919337802990829
// L_SLOPE[2][3]   =  -0.7055248578250517
// L_SLOPE[2][4]   =  -0.22333630312991004
// L_SLOPE[2][5]   =  -0.9228311269732536
// L_SLOPE[3][0]   =  -0.07108618492466001
// L_SLOPE[3][1]   =  0.4605037937522438
// L_SLOPE[3][2]   =  -0.07849292069857583
// L_SLOPE[3][3]   =  -0.9219287029041787
// L_SLOPE[3][4]   =  -0.9393443210855212
// L_SLOPE[3][5]   =  -0.6035950567188331
// L_SLOPE[4][0]   =  0.33432470642576595
// L_SLOPE[4][1]   =  0.8498701448320278
// L_SLOPE[4][2]   =  0.005688866737794784
// L_SLOPE[4][3]   =  -0.7934180377103368
// L_SLOPE[4][4]   =  -0.5681513530956237
// L_SLOPE[4][5]   =  -0.16811283480299188
// L_SLOPE[5][0]   =  -0.7835141676103456
// L_SLOPE[5][1]   =  -0.7682421735558487
// L_SLOPE[5][2]   =  -0.132013408225913
// L_SLOPE[5][3]   =  0.6810435712292451
// L_SLOPE[5][4]   =  -0.5249221008139671
// L_SLOPE[5][5]   =  0.7658869494681397
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 2;
    robrow : [0..6] init 2;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3230709125602673,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.01827787450424312 * pl + (- 0.8192386125429625 * pr) >= 0,
            1 * pr + (- 0.014973940549090521 * pl) >= 0,
            0.41933760037747425 * pf + (- 0.8192386125429625 * pb) >= 0,
            1 * pb + (- 0.34353755392033725 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3230709125602673,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.01827787450424312 * pl + (- 0.8192386125429625 * pr) >= 0,
            1 * pr + (- 0.014973940549090521 * pl) >= 0,
            0.41933760037747425 * pf + (- 0.8192386125429625 * pb) >= 0,
            1 * pb + (- 0.34353755392033725 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3230709125602673,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.01827787450424312 * pl + (- 0.8192386125429625 * pr) >= 0,
            1 * pr + (-0.014973940549090521 * pl) >= 0,
            0.41933760037747425 * pf + (-0.8192386125429625 * pb) >= 0,
            1 * pb + (-0.34353755392033725 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3230709125602673,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.01827787450424312 * pl + (- 0.8192386125429625 * pr) >= 0,
            1 * pr + (- 0.014973940549090521 * pl) >= 0,
            0.41933760037747425 * pf + (- 0.8192386125429625 * pb) >= 0,
            1 * pb + (- 0.34353755392033725 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6166763001797344,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5689368695137835 * pr) >= 0,
            0.7488379471511226 * pr + (- 0.759759667199353 * pl) >= 0,
            0.9532546643455615 * pf + (- 0.759759667199353 * pb) >= 0,
            1 * pb + (- 0.7242444465394147 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6166763001797344,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5689368695137835 * pr) >= 0,
            0.7488379471511226 * pr + (- 0.759759667199353 * pl) >= 0,
            0.9532546643455615 * pf + (- 0.759759667199353 * pb) >= 0,
            1 * pb + (- 0.7242444465394147 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6166763001797344,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5689368695137835 * pr) >= 0,
            0.7488379471511226 * pr + (-0.759759667199353 * pl) >= 0,
            0.9532546643455615 * pf + (-0.759759667199353 * pb) >= 0,
            1 * pb + (-0.7242444465394147 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6166763001797344,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5689368695137835 * pr) >= 0,
            0.7488379471511226 * pr + (- 0.759759667199353 * pl) >= 0,
            0.9532546643455615 * pf + (- 0.759759667199353 * pb) >= 0,
            1 * pb + (- 0.7242444465394147 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3296770273409019,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.12861679326562442 * pr) >= 0,
            0.16249266500451864 * pr + (- 0.7915236866971676 * pl) >= 0,
            1 * pf + (- 0.3717001360683162 * pb) >= 0,
            0.46960077419707913 * pb + (- 0.7915236866971676 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3296770273409019,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.12861679326562442 * pr) >= 0,
            0.16249266500451864 * pr + (- 0.7915236866971676 * pl) >= 0,
            1 * pf + (- 0.3717001360683162 * pb) >= 0,
            0.46960077419707913 * pb + (- 1.211347237326019 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3296770273409019,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.12861679326562442 * pr) >= 0,
            0.16249266500451864 * pr + (-0.7915236866971676 * pl) >= 0,
            1 * pf + (-0.3717001360683162 * pb) >= 0,
            0.46960077419707913 * pb + (-0.7915236866971676 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3296770273409019,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.12861679326562442 * pr) >= 0,
            0.16249266500451864 * pr + (- 0.7915236866971676 * pl) >= 0,
            1 * pf + (- 0.3717001360683162 * pb) >= 0,
            0.46960077419707913 * pb + (- 0.7915236866971676 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.31172503390253836,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2272008022350953 * pl + (- 0.7766203731080383 * pr) >= 0,
            1 * pr + (- 0.17644877180226534 * pl) >= 0,
            1 * pf + (- 0.2399903036948377 * pb) >= 0,
            0.3090188102256388 * pb + (- 0.7766203731080383 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.31172503390253836,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2272008022350953 * pl + (- 0.7766203731080383 * pr) >= 0,
            1 * pr + (- 0.17644877180226534 * pl) >= 0,
            1 * pf + (- 0.2399903036948377 * pb) >= 0,
            0.3090188102256388 * pb + (- 1.313250442521239 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.31172503390253836,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2272008022350953 * pl + (- 0.7766203731080383 * pr) >= 0,
            1 * pr + (-0.17644877180226534 * pl) >= 0,
            1 * pf + (-0.2399903036948377 * pb) >= 0,
            0.3090188102256388 * pb + (-0.7766203731080383 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.31172503390253836,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2272008022350953 * pl + (- 0.7766203731080383 * pr) >= 0,
            1 * pr + (- 0.17644877180226534 * pl) >= 0,
            1 * pf + (- 0.2399903036948377 * pb) >= 0,
