//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.11802404486871726
// Q_TERRAIN[0][1] = 0.0515830171153579
// Q_TERRAIN[0][2] = 0.1980291213053405
// Q_TERRAIN[0][3] = 0.07748613540120514
// Q_TERRAIN[0][4] = 0.033257547839794954
// Q_TERRAIN[0][5] = 0.20079550724253742
// Q_TERRAIN[1][0] = 0.45897752154385946
// Q_TERRAIN[1][1] = 0.40022617574790426
// Q_TERRAIN[1][2] = 0.3825813012527192
// Q_TERRAIN[1][3] = 0.11096408784515882
// Q_TERRAIN[1][4] = 0.26834000408740677
// Q_TERRAIN[1][5] = 0.1383413217207251
// Q_TERRAIN[2][0] = 0.08633226464268445
// Q_TERRAIN[2][1] = 0.053091646215765065
// Q_TERRAIN[2][2] = 0.10720021628945825
// Q_TERRAIN[2][3] = 0.4637378157140302
// Q_TERRAIN[2][4] = 0.4144600243892097
// Q_TERRAIN[2][5] = 0.4033261733511617
// Q_TERRAIN[3][0] = 0.4002239192714831
// Q_TERRAIN[3][1] = 0.09671780900962001
// Q_TERRAIN[3][2] = 0.15492497864976779
// Q_TERRAIN[3][3] = 0.31348780120656505
// Q_TERRAIN[3][4] = 0.365947354439359
// Q_TERRAIN[3][5] = 0.4273241789956736
// Q_TERRAIN[4][0] = 0.4400253756805997
// Q_TERRAIN[4][1] = 0.043359126317460916
// Q_TERRAIN[4][2] = 0.30292594185993993
// Q_TERRAIN[4][3] = 0.33585072825823664
// Q_TERRAIN[4][4] = 0.25297688785520767
// Q_TERRAIN[4][5] = 0.08889508712039224
// Q_TERRAIN[5][0] = 0.23679394379257257
// Q_TERRAIN[5][1] = 0.044673103632695166
// Q_TERRAIN[5][2] = 0.46729418194995404
// Q_TERRAIN[5][3] = 0.43274208509254164
// Q_TERRAIN[5][4] = 0.27381943479352694
// Q_TERRAIN[5][5] = 0.15012286978666234

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.8177405788293728
// F_SLOPE[0][1] =  0.14473360337178298
// F_SLOPE[0][2] =  0.7646344797575799
// F_SLOPE[0][3] =  0.6960881764472693
// F_SLOPE[0][4] =  0.016744750665503183
// F_SLOPE[0][5] =  -0.172107913736536
// F_SLOPE[1][0] =  0.19782494437997888
// F_SLOPE[1][1] =  -0.13791396541338585
// F_SLOPE[1][2] =  -0.677358787756783
// F_SLOPE[1][3] =  -0.389776807134522
// F_SLOPE[1][4] =  0.6251846372692413
// F_SLOPE[1][5] =  -0.913523061855503
// F_SLOPE[2][0] =  -0.9073560019929747
// F_SLOPE[2][1] =  0.2527014910798069
// F_SLOPE[2][2] =  -0.4391335767675626
// F_SLOPE[2][3] =  0.06924358975884437
// F_SLOPE[2][4] =  -0.057519827770013965
// F_SLOPE[2][5] =  -0.3143134691556879
// F_SLOPE[3][0] =  0.9945577483442247
// F_SLOPE[3][1] =  -0.6088530113333692
// F_SLOPE[3][2] =  -0.1744106871853499
// F_SLOPE[3][3] =  -0.5946587676552073
// F_SLOPE[3][4] =  0.2653299635820381
// F_SLOPE[3][5] =  -0.44739033008063367
// F_SLOPE[4][0] =  -0.28833849078529594
// F_SLOPE[4][1] =  0.49388536198092514
// F_SLOPE[4][2] =  -0.3586621935005161
// F_SLOPE[4][3] =  0.11705796716678418
// F_SLOPE[4][4] =  0.8086302030613155
// F_SLOPE[4][5] =  -0.798041122564281
// F_SLOPE[5][0] =  -0.8767795159196483
// F_SLOPE[5][1] =  -0.5422611195224705
// F_SLOPE[5][2] =  0.5303244826525517
// F_SLOPE[5][3] =  0.23086415025739426
// F_SLOPE[5][4] =  -0.5251656603493482
// F_SLOPE[5][5] =  -0.33786600925653065

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.6449206130068861
// L_SLOPE[0][1]   =  -0.0819624956596483
// L_SLOPE[0][2]   =  -0.9143776244359607
// L_SLOPE[0][3]   =  0.3945837629230369
// L_SLOPE[0][4]   =  0.7918555582236453
// L_SLOPE[0][5]   =  0.9094751966846901
// L_SLOPE[1][0]   =  0.4697559129478517
// L_SLOPE[1][1]   =  0.9197351832259022
// L_SLOPE[1][2]   =  -0.9636249494133851
// L_SLOPE[1][3]   =  -0.4220070641983136
// L_SLOPE[1][4]   =  0.9320135139362458
// L_SLOPE[1][5]   =  0.550478870450297
// L_SLOPE[2][0]   =  -0.179144637862249
// L_SLOPE[2][1]   =  0.8866167347059626
// L_SLOPE[2][2]   =  0.24102094292705822
// L_SLOPE[2][3]   =  0.6358556013965053
// L_SLOPE[2][4]   =  -0.4131794926862473
// L_SLOPE[2][5]   =  -0.6171695903825214
// L_SLOPE[3][0]   =  -0.11171552103764815
// L_SLOPE[3][1]   =  -0.7271247468881701
// L_SLOPE[3][2]   =  -0.2367307305513373
// L_SLOPE[3][3]   =  0.9236272448138096
// L_SLOPE[3][4]   =  -0.33738554160162715
// L_SLOPE[3][5]   =  -0.9812070673208708
// L_SLOPE[4][0]   =  -0.9104056141557495
// L_SLOPE[4][1]   =  -0.6608659123600897
// L_SLOPE[4][2]   =  0.5674913496427099
// L_SLOPE[4][3]   =  -0.27455146614931136
// L_SLOPE[4][4]   =  -0.41933152718162914
// L_SLOPE[4][5]   =  -0.805795573602218
// L_SLOPE[5][0]   =  0.9634972990637529
// L_SLOPE[5][1]   =  -0.15209496145651036
// L_SLOPE[5][2]   =  -0.5841663164851334
// L_SLOPE[5][3]   =  -0.8813209524421515
// L_SLOPE[5][4]   =  -0.8894587496351984
// L_SLOPE[5][5]   =  -0.6626594573924716
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 2;
    robrow : [0..6] init 2;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4143342369027758,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3550793869931139 * pl + (- 0.8819759551312827 * pr) >= 0,
            1 * pr + (- 0.313171481490682 * pl) >= 0,
            0.1822594211706272 * pf + (- 0.8819759551312827 * pb) >= 0,
            1 * pb + (- 0.16074842706863865 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4143342369027758,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3550793869931139 * pl + (- 0.8819759551312827 * pr) >= 0,
            1 * pr + (- 0.313171481490682 * pl) >= 0,
            0.1822594211706272 * pf + (- 0.8819759551312827 * pb) >= 0,
            1 * pb + (- 0.16074842706863865 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4143342369027758,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3550793869931139 * pl + (- 0.8819759551312827 * pr) >= 0,
            1 * pr + (-0.313171481490682 * pl) >= 0,
            0.1822594211706272 * pf + (-0.8819759551312827 * pb) >= 0,
            1 * pb + (-0.16074842706863865 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4143342369027758,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3550793869931139 * pl + (- 0.8819759551312827 * pr) >= 0,
            1 * pr + (- 0.313171481490682 * pl) >= 0,
            0.1822594211706272 * pf + (- 0.8819759551312827 * pb) >= 0,
            1 * pb + (- 0.16074842706863865 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.841000297038009,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.9180375043403517 * pl + (- 0.948416982884642 * pr) >= 0,
            1 * pr + (- 0.8706823600414229 * pl) >= 0,
            0.855266396628217 * pf + (- 0.948416982884642 * pb) >= 0,
            1 * pb + (- 0.8111491754527532 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.841000297038009,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.9180375043403517 * pl + (- 0.948416982884642 * pr) >= 0,
            1 * pr + (- 0.8706823600414229 * pl) >= 0,
            0.855266396628217 * pf + (- 0.948416982884642 * pb) >= 0,
            1 * pb + (- 0.8111491754527532 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.841000297038009,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.9180375043403517 * pl + (- 0.948416982884642 * pr) >= 0,
            1 * pr + (-0.8706823600414229 * pl) >= 0,
            0.855266396628217 * pf + (-0.948416982884642 * pb) >= 0,
            1 * pb + (-0.8111491754527532 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.841000297038009,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.9180375043403517 * pl + (- 0.948416982884642 * pr) >= 0,
            1 * pr + (- 0.8706823600414229 * pl) >= 0,
            0.855266396628217 * pf + (- 0.948416982884642 * pb) >= 0,
            1 * pb + (- 0.8111491754527532 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.31204715617917045,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08562237556403929 * pl + (- 0.8019708786946596 * pr) >= 0,
            1 * pr + (- 0.06866665176701674 * pl) >= 0,
            0.23536552024242008 * pf + (- 0.8019708786946596 * pb) >= 0,
            1 * pb + (- 0.1887562930832393 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.31204715617917045,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08562237556403929 * pl + (- 0.8019708786946596 * pr) >= 0,
            1 * pr + (- 0.06866665176701674 * pl) >= 0,
            0.23536552024242008 * pf + (- 0.8019708786946596 * pb) >= 0,
            1 * pb + (- 0.1887562930832393 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.31204715617917045,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08562237556403929 * pl + (- 0.8019708786946596 * pr) >= 0,
            1 * pr + (-0.06866665176701674 * pl) >= 0,
            0.23536552024242008 * pf + (-0.8019708786946596 * pb) >= 0,
            1 * pb + (-0.1887562930832393 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.31204715617917045,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08562237556403929 * pl + (- 0.8019708786946596 * pr) >= 0,
            1 * pr + (- 0.06866665176701674 * pl) >= 0,
            0.23536552024242008 * pf + (- 0.8019708786946596 * pb) >= 0,
            1 * pb + (- 0.1887562930832393 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.514510440908041,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5585048725567295 * pr) >= 0,
            0.6054162370769631 * pr + (- 0.9225138645987949 * pl) >= 0,
            0.3039118235527307 * pf + (- 0.9225138645987949 * pb) >= 0,
            1 * pb + (- 0.2803628708428967 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.514510440908041,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5585048725567295 * pr) >= 0,
            0.6054162370769631 * pr + (- 0.9225138645987949 * pl) >= 0,
            0.3039118235527307 * pf + (- 0.9225138645987949 * pb) >= 0,
            1 * pb + (- 0.2803628708428967 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.514510440908041,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5585048725567295 * pr) >= 0,
            0.6054162370769631 * pr + (-0.9225138645987949 * pl) >= 0,
            0.3039118235527307 * pf + (-0.9225138645987949 * pb) >= 0,
            1 * pb + (-0.2803628708428967 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.514510440908041,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5585048725567295 * pr) >= 0,
            0.6054162370769631 * pr + (- 0.9225138645987949 * pl) >= 0,
            0.3039118235527307 * pf + (- 0.9225138645987949 * pb) >= 0,
            1 * pb + (- 0.2803628708428967 * pf) >= 0
