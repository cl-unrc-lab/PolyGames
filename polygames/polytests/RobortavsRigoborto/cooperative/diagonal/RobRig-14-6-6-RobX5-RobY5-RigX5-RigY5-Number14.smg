//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.05341426885082784
// Q_TERRAIN[0][1] = 0.35129276199342774
// Q_TERRAIN[0][2] = 0.3260210101571377
// Q_TERRAIN[0][3] = 0.47017619478305894
// Q_TERRAIN[0][4] = 0.13555761328016158
// Q_TERRAIN[0][5] = 0.12788775671651958
// Q_TERRAIN[1][0] = 0.3670296820723484
// Q_TERRAIN[1][1] = 0.3292250091200379
// Q_TERRAIN[1][2] = 0.15149398694417754
// Q_TERRAIN[1][3] = 0.34211656403847773
// Q_TERRAIN[1][4] = 0.19833682251650697
// Q_TERRAIN[1][5] = 0.3887582939450562
// Q_TERRAIN[2][0] = 0.05919978493271927
// Q_TERRAIN[2][1] = 0.11163305815612479
// Q_TERRAIN[2][2] = 0.4507315431373494
// Q_TERRAIN[2][3] = 0.17901633980814663
// Q_TERRAIN[2][4] = 0.1302011659766365
// Q_TERRAIN[2][5] = 0.4021406420794443
// Q_TERRAIN[3][0] = 0.3158319611708399
// Q_TERRAIN[3][1] = 0.07485177800450654
// Q_TERRAIN[3][2] = 0.27566633621391673
// Q_TERRAIN[3][3] = 0.3319995264535025
// Q_TERRAIN[3][4] = 0.08247412372605983
// Q_TERRAIN[3][5] = 0.32584914591139846
// Q_TERRAIN[4][0] = 0.06151317281583124
// Q_TERRAIN[4][1] = 0.1685331129572819
// Q_TERRAIN[4][2] = 0.04160400209596249
// Q_TERRAIN[4][3] = 0.10221084897994648
// Q_TERRAIN[4][4] = 0.48899976678892887
// Q_TERRAIN[4][5] = 0.2018378994736273
// Q_TERRAIN[5][0] = 0.49521631723011234
// Q_TERRAIN[5][1] = 0.2193240258709021
// Q_TERRAIN[5][2] = 0.30376560648677636
// Q_TERRAIN[5][3] = 0.436297691020605
// Q_TERRAIN[5][4] = 0.3434417504301477
// Q_TERRAIN[5][5] = 0.05576572782837014

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.1781683361145423
// F_SLOPE[0][1] =  0.2674587423243766
// F_SLOPE[0][2] =  -0.6376039256923292
// F_SLOPE[0][3] =  -0.8106550015955607
// F_SLOPE[0][4] =  0.749587841132697
// F_SLOPE[0][5] =  0.02756291139498046
// F_SLOPE[1][0] =  -0.6123225797589007
// F_SLOPE[1][1] =  -0.09479818308178856
// F_SLOPE[1][2] =  -0.563624195981937
// F_SLOPE[1][3] =  0.596483801027019
// F_SLOPE[1][4] =  0.0009602495226319618
// F_SLOPE[1][5] =  -0.7951439451994802
// F_SLOPE[2][0] =  0.6362560242299726
// F_SLOPE[2][1] =  -0.8209295231307807
// F_SLOPE[2][2] =  -0.4386624825257126
// F_SLOPE[2][3] =  -0.9440051889163914
// F_SLOPE[2][4] =  0.4806824834923302
// F_SLOPE[2][5] =  -0.7722507612973795
// F_SLOPE[3][0] =  0.051529118209237224
// F_SLOPE[3][1] =  -0.8140326078953046
// F_SLOPE[3][2] =  -0.03912514487245988
// F_SLOPE[3][3] =  0.37074426067430966
// F_SLOPE[3][4] =  0.0697009472055472
// F_SLOPE[3][5] =  -0.08966619805209919
// F_SLOPE[4][0] =  -0.030258127155512238
// F_SLOPE[4][1] =  -0.12591483566621475
// F_SLOPE[4][2] =  0.19089321533869263
// F_SLOPE[4][3] =  -0.8102915397826067
// F_SLOPE[4][4] =  -0.050963679044279564
// F_SLOPE[4][5] =  -0.5274733387047756
// F_SLOPE[5][0] =  0.7309062572623319
// F_SLOPE[5][1] =  0.8780404402175128
// F_SLOPE[5][2] =  -0.8671023909882909
// F_SLOPE[5][3] =  -0.7134060935817033
// F_SLOPE[5][4] =  0.4069417456803459
// F_SLOPE[5][5] =  0.14289436402030375

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.9617880012787801
// L_SLOPE[0][1]   =  0.40978731819520475
// L_SLOPE[0][2]   =  0.8878646193033581
// L_SLOPE[0][3]   =  -0.153779297757221
// L_SLOPE[0][4]   =  -0.30501896575504084
// L_SLOPE[0][5]   =  0.13880308520721485
// L_SLOPE[1][0]   =  0.8782718996859167
// L_SLOPE[1][1]   =  -0.4729228115737196
// L_SLOPE[1][2]   =  -0.39542961820845535
// L_SLOPE[1][3]   =  -0.6225788288891985
// L_SLOPE[1][4]   =  0.2568350815755551
// L_SLOPE[1][5]   =  -0.06148483160575169
// L_SLOPE[2][0]   =  -0.48785269118308916
// L_SLOPE[2][1]   =  -0.22421112510814778
// L_SLOPE[2][2]   =  -0.9304423601569201
// L_SLOPE[2][3]   =  -0.3751022811951523
// L_SLOPE[2][4]   =  0.9658115506226486
// L_SLOPE[2][5]   =  0.17208764712017777
// L_SLOPE[3][0]   =  -0.4348321479324626
// L_SLOPE[3][1]   =  0.8722602099867802
// L_SLOPE[3][2]   =  -0.2834485323757754
// L_SLOPE[3][3]   =  -0.49693062731926196
// L_SLOPE[3][4]   =  -0.929720536523369
// L_SLOPE[3][5]   =  -0.7075977358974208
// L_SLOPE[4][0]   =  -0.6019218116733218
// L_SLOPE[4][1]   =  -0.5399293564217476
// L_SLOPE[4][2]   =  0.7459619268874387
// L_SLOPE[4][3]   =  -0.4709072234868754
// L_SLOPE[4][4]   =  -0.5027987478993527
// L_SLOPE[4][5]   =  0.20785301447100668
// L_SLOPE[5][0]   =  0.834278022230017
// L_SLOPE[5][1]   =  -0.41725033936777267
// L_SLOPE[5][2]   =  0.5231762810878307
// L_SLOPE[5][3]   =  -0.2625282849143462
// L_SLOPE[5][4]   =  0.12222675862367205
// L_SLOPE[5][5]   =  0.1916761508771878
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 5;
    robrow : [0..6] init 5;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.46228764639389675,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.03821199872121994 * pl + (- 0.9465857311491721 * pr) >= 0,
            1 * pr + (- 0.03617093274819721 * pl) >= 0,
            0.8218316638854577 * pf + (- 0.9465857311491721 * pb) >= 0,
            1 * pb + (- 0.7779341264405566 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.46228764639389675,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.03821199872121994 * pl + (- 0.9465857311491721 * pr) >= 0,
            1 * pr + (- 0.03617093274819721 * pl) >= 0,
            0.8218316638854577 * pf + (- 0.9465857311491721 * pb) >= 0,
            1 * pb + (- 0.7779341264405566 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.46228764639389675,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.03821199872121994 * pl + (- 0.9465857311491721 * pr) >= 0,
            1 * pr + (-0.03617093274819721 * pl) >= 0,
            0.8218316638854577 * pf + (-0.9465857311491721 * pb) >= 0,
            1 * pb + (-0.7779341264405566 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.46228764639389675,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.03821199872121994 * pl + (- 0.9465857311491721 * pr) >= 0,
            1 * pr + (- 0.03617093274819721 * pl) >= 0,
            0.8218316638854577 * pf + (- 0.9465857311491721 * pb) >= 0,
            1 * pb + (- 0.7779341264405566 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.36488480811926594,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.38287523865004064 * pr) >= 0,
            0.5902126818047952 * pr + (- 0.6487072380065723 * pl) >= 0,
            0.7325412576756234 * pf + (- 0.6487072380065723 * pb) >= 0,
            1 * pb + (- 0.4752048159926144 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.36488480811926594,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.38287523865004064 * pr) >= 0,
            0.5902126818047952 * pr + (- 0.6487072380065723 * pl) >= 0,
            0.7325412576756234 * pf + (- 0.6487072380065723 * pb) >= 0,
            1 * pb + (- 0.4752048159926144 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.36488480811926594,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.38287523865004064 * pr) >= 0,
            0.5902126818047952 * pr + (-0.6487072380065723 * pl) >= 0,
            0.7325412576756234 * pf + (-0.6487072380065723 * pb) >= 0,
            1 * pb + (-0.4752048159926144 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.36488480811926594,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.38287523865004064 * pr) >= 0,
            0.5902126818047952 * pr + (- 0.6487072380065723 * pl) >= 0,
            0.7325412576756234 * pf + (- 0.6487072380065723 * pb) >= 0,
            1 * pb + (- 0.4752048159926144 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.19429770072059194,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07557689060756749 * pr) >= 0,
            0.11213538069664186 * pr + (- 0.6739789898428623 * pl) >= 0,
            1 * pf + (- 0.24424734008490287 * pb) >= 0,
            0.36239607430767085 * pb + (- 0.6739789898428623 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.19429770072059194,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07557689060756749 * pr) >= 0,
            0.11213538069664186 * pr + (- 0.6739789898428623 * pl) >= 0,
            1 * pf + (- 0.24424734008490287 * pb) >= 0,
            0.36239607430767085 * pb + (- 1.1037106396008218 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.19429770072059194,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07557689060756749 * pr) >= 0,
            0.11213538069664186 * pr + (-0.6739789898428623 * pl) >= 0,
            1 * pf + (-0.24424734008490287 * pb) >= 0,
            0.36239607430767085 * pb + (-0.6739789898428623 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.19429770072059194,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07557689060756749 * pr) >= 0,
            0.11213538069664186 * pr + (- 0.6739789898428623 * pl) >= 0,
            1 * pf + (- 0.24424734008490287 * pb) >= 0,
            0.36239607430767085 * pb + (- 0.6739789898428623 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.10993763397492229,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.846220702242779 * pl + (- 0.5298238052169411 * pr) >= 0,
            1 * pr + (- 0.44834787251562125 * pl) >= 0,
            1 * pf + (- 0.10031948755343566 * pb) >= 0,
            0.1893449984044393 * pb + (- 0.5298238052169411 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.10993763397492229,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.846220702242779 * pl + (- 0.5298238052169411 * pr) >= 0,
            1 * pr + (- 0.44834787251562125 * pl) >= 0,
            1 * pf + (- 0.10031948755343566 * pb) >= 0,
            0.1893449984044393 * pb + (- 0.9593281228804464 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.10993763397492229,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.846220702242779 * pl + (- 0.5298238052169411 * pr) >= 0,
            1 * pr + (-0.44834787251562125 * pl) >= 0,
            1 * pf + (-0.10031948755343566 * pb) >= 0,
            0.1893449984044393 * pb + (-0.5298238052169411 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.10993763397492229,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.846220702242779 * pl + (- 0.5298238052169411 * pr) >= 0,
            1 * pr + (- 0.44834787251562125 * pl) >= 0,
            1 * pf + (- 0.10031948755343566 * pb) >= 0,
