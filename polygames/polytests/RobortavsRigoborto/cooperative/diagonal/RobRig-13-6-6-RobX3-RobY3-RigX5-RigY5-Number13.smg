//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.1295042458577368
// Q_TERRAIN[0][1] = 0.34262899648226847
// Q_TERRAIN[0][2] = 0.34204095900805537
// Q_TERRAIN[0][3] = 0.4246680806949651
// Q_TERRAIN[0][4] = 0.0928620869368677
// Q_TERRAIN[0][5] = 0.11527930448273405
// Q_TERRAIN[1][0] = 0.07357995908420889
// Q_TERRAIN[1][1] = 0.11258146778105632
// Q_TERRAIN[1][2] = 0.3670118011063865
// Q_TERRAIN[1][3] = 0.06510651137987844
// Q_TERRAIN[1][4] = 0.26565737592350913
// Q_TERRAIN[1][5] = 0.10695376524587036
// Q_TERRAIN[2][0] = 0.14732837688168127
// Q_TERRAIN[2][1] = 0.2157901641961063
// Q_TERRAIN[2][2] = 0.4188282552516491
// Q_TERRAIN[2][3] = 0.3042010739371432
// Q_TERRAIN[2][4] = 0.007216196481045933
// Q_TERRAIN[2][5] = 0.13791842696957834
// Q_TERRAIN[3][0] = 0.07335516097005729
// Q_TERRAIN[3][1] = 0.4356423645992199
// Q_TERRAIN[3][2] = 0.40486980560553026
// Q_TERRAIN[3][3] = 0.4030234190167872
// Q_TERRAIN[3][4] = 0.4131826700682412
// Q_TERRAIN[3][5] = 0.3723750764011038
// Q_TERRAIN[4][0] = 0.4746617083978174
// Q_TERRAIN[4][1] = 0.3968852753826035
// Q_TERRAIN[4][2] = 0.128353988214348
// Q_TERRAIN[4][3] = 0.42496950639049647
// Q_TERRAIN[4][4] = 0.24339274651646908
// Q_TERRAIN[4][5] = 0.37750192563870055
// Q_TERRAIN[5][0] = 0.28206929930084035
// Q_TERRAIN[5][1] = 0.2147888230932069
// Q_TERRAIN[5][2] = 0.1821013126098714
// Q_TERRAIN[5][3] = 0.21491113543005524
// Q_TERRAIN[5][4] = 0.15688068291266288
// Q_TERRAIN[5][5] = 0.05868002528689514

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.639287286917495
// F_SLOPE[0][1] =  0.5965172742871157
// F_SLOPE[0][2] =  0.9713623711897403
// F_SLOPE[0][3] =  0.38184530211057455
// F_SLOPE[0][4] =  0.10845271663649148
// F_SLOPE[0][5] =  0.49682298283509096
// F_SLOPE[1][0] =  -0.7302924776020696
// F_SLOPE[1][1] =  0.3536431301973617
// F_SLOPE[1][2] =  -0.11320009028947453
// F_SLOPE[1][3] =  -0.6467325047655763
// F_SLOPE[1][4] =  -0.5947467359988101
// F_SLOPE[1][5] =  0.045386602822668376
// F_SLOPE[2][0] =  -0.4933764879239706
// F_SLOPE[2][1] =  -0.08108195272442287
// F_SLOPE[2][2] =  0.21099755585397273
// F_SLOPE[2][3] =  -0.20848526225585595
// F_SLOPE[2][4] =  -0.7384380761205778
// F_SLOPE[2][5] =  -0.018285728245579058
// F_SLOPE[3][0] =  -0.5291060125029605
// F_SLOPE[3][1] =  -0.5286433415618363
// F_SLOPE[3][2] =  -0.6110620990165117
// F_SLOPE[3][3] =  -0.26712018056062803
// F_SLOPE[3][4] =  -0.8534484441521639
// F_SLOPE[3][5] =  0.30246354086825167
// F_SLOPE[4][0] =  0.9073320845313875
// F_SLOPE[4][1] =  -0.22062247988311934
// F_SLOPE[4][2] =  0.4377639803933402
// F_SLOPE[4][3] =  0.8659556339309231
// F_SLOPE[4][4] =  -0.9135829176767947
// F_SLOPE[4][5] =  -0.7165088728364224
// F_SLOPE[5][0] =  0.6121905550082114
// F_SLOPE[5][1] =  0.6762907571363028
// F_SLOPE[5][2] =  0.2781110294714466
// F_SLOPE[5][3] =  -0.6804865638442101
// F_SLOPE[5][4] =  -0.17301819121457118
// F_SLOPE[5][5] =  0.7364830412161012

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.7723848485940628
// L_SLOPE[0][1]   =  0.606344243147841
// L_SLOPE[0][2]   =  -0.5938834144861511
// L_SLOPE[0][3]   =  0.7073084358945223
// L_SLOPE[0][4]   =  -0.25048751353691334
// L_SLOPE[0][5]   =  0.43302218104689905
// L_SLOPE[1][0]   =  -0.7259849920654411
// L_SLOPE[1][1]   =  0.9426065788254234
// L_SLOPE[1][2]   =  0.20700000580637412
// L_SLOPE[1][3]   =  0.4454286321452956
// L_SLOPE[1][4]   =  -0.5765686204795399
// L_SLOPE[1][5]   =  0.2344809925938136
// L_SLOPE[2][0]   =  0.1617491051822153
// L_SLOPE[2][1]   =  0.18244996724497908
// L_SLOPE[2][2]   =  -0.28129771973155115
// L_SLOPE[2][3]   =  0.455387153772828
// L_SLOPE[2][4]   =  -0.3173322203434852
// L_SLOPE[2][5]   =  -0.4093498558867792
// L_SLOPE[3][0]   =  -0.6710331322639964
// L_SLOPE[3][1]   =  0.36806254916329384
// L_SLOPE[3][2]   =  -0.7754796460178806
// L_SLOPE[3][3]   =  -0.5488851790528253
// L_SLOPE[3][4]   =  -0.8617121513315269
// L_SLOPE[3][5]   =  0.2870536088215154
// L_SLOPE[4][0]   =  0.11230598102523204
// L_SLOPE[4][1]   =  0.0866311892145506
// L_SLOPE[4][2]   =  -0.9223450128569206
// L_SLOPE[4][3]   =  -0.12081879637604276
// L_SLOPE[4][4]   =  -0.3138818942741759
// L_SLOPE[4][5]   =  -0.8146761428328504
// L_SLOPE[5][0]   =  -0.9940509181248474
// L_SLOPE[5][1]   =  0.9958275453833736
// L_SLOPE[5][2]   =  -0.7569676129811389
// L_SLOPE[5][3]   =  -0.3969937725851507
// L_SLOPE[5][4]   =  -0.462111360355588
// L_SLOPE[5][5]   =  0.19451781658840073
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 3;
    robrow : [0..6] init 3;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.41154759354342363,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.19813802287731677 * pr) >= 0,
            0.22761515140593724 * pr + (- 0.8704957541422632 * pl) >= 0,
            0.36071271308250497 * pf + (- 0.8704957541422632 * pb) >= 0,
            1 * pb + (- 0.313998885203457 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.41154759354342363,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.19813802287731677 * pr) >= 0,
            0.22761515140593724 * pr + (- 0.8704957541422632 * pl) >= 0,
            0.36071271308250497 * pf + (- 0.8704957541422632 * pb) >= 0,
            1 * pb + (- 0.313998885203457 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.41154759354342363,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.19813802287731677 * pr) >= 0,
            0.22761515140593724 * pr + (-0.8704957541422632 * pl) >= 0,
            0.36071271308250497 * pf + (-0.8704957541422632 * pb) >= 0,
            1 * pb + (-0.313998885203457 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.41154759354342363,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.19813802287731677 * pr) >= 0,
            0.22761515140593724 * pr + (- 0.8704957541422632 * pl) >= 0,
            0.36071271308250497 * pf + (- 0.8704957541422632 * pb) >= 0,
            1 * pb + (- 0.313998885203457 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.23678765240137034,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.25877787992243595 * pr) >= 0,
            0.39365575685215903 * pr + (- 0.6573710035177316 * pl) >= 0,
            0.40348272571288435 * pf + (- 0.6573710035177316 * pb) >= 0,
            1 * pb + (- 0.2652378443039484 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.23678765240137034,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.25877787992243595 * pr) >= 0,
            0.39365575685215903 * pr + (- 0.6573710035177316 * pl) >= 0,
            0.40348272571288435 * pf + (- 0.6573710035177316 * pb) >= 0,
            1 * pb + (- 0.2652378443039484 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.23678765240137034,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.25877787992243595 * pr) >= 0,
            0.39365575685215903 * pr + (-0.6573710035177316 * pl) >= 0,
            0.40348272571288435 * pf + (-0.6573710035177316 * pb) >= 0,
            1 * pb + (-0.2652378443039484 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.23678765240137034,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.25877787992243595 * pr) >= 0,
            0.39365575685215903 * pr + (- 0.6573710035177316 * pl) >= 0,
            0.40348272571288435 * pf + (- 0.6573710035177316 * pb) >= 0,
            1 * pb + (- 0.2652378443039484 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.16377414900676246,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4061165855138489 * pl + (- 0.6579590409919447 * pr) >= 0,
            1 * pr + (- 0.2672080791356151 * pl) >= 0,
            0.028637628810259663 * pf + (- 0.6579590409919447 * pb) >= 0,
            1 * pb + (- 0.018842386788281734 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.16377414900676246,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4061165855138489 * pl + (- 0.6579590409919447 * pr) >= 0,
            1 * pr + (- 0.2672080791356151 * pl) >= 0,
            0.028637628810259663 * pf + (- 0.6579590409919447 * pb) >= 0,
            1 * pb + (- 0.018842386788281734 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.16377414900676246,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4061165855138489 * pl + (- 0.6579590409919447 * pr) >= 0,
            1 * pr + (-0.2672080791356151 * pl) >= 0,
            0.028637628810259663 * pf + (-0.6579590409919447 * pb) >= 0,
            1 * pb + (-0.018842386788281734 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.16377414900676246,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4061165855138489 * pl + (- 0.6579590409919447 * pr) >= 0,
            1 * pr + (- 0.2672080791356151 * pl) >= 0,
            0.028637628810259663 * pf + (- 0.6579590409919447 * pb) >= 0,
            1 * pb + (- 0.018842386788281734 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.16579625199723735,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.16839479934119714 * pr) >= 0,
            0.2926915641054777 * pr + (- 0.5753319193050349 * pl) >= 0,
            0.6181546978894255 * pf + (- 0.5753319193050349 * pb) >= 0,
            1 * pb + (- 0.35564412876414714 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.16579625199723735,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.16839479934119714 * pr) >= 0,
            0.2926915641054777 * pr + (- 0.5753319193050349 * pl) >= 0,
            0.6181546978894255 * pf + (- 0.5753319193050349 * pb) >= 0,
            1 * pb + (- 0.35564412876414714 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.16579625199723735,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.16839479934119714 * pr) >= 0,
            0.2926915641054777 * pr + (-0.5753319193050349 * pl) >= 0,
            0.6181546978894255 * pf + (-0.5753319193050349 * pb) >= 0,
            1 * pb + (-0.35564412876414714 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.16579625199723735,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.16839479934119714 * pr) >= 0,
            0.2926915641054777 * pr + (- 0.5753319193050349 * pl) >= 0,
            0.6181546978894255 * pf + (- 0.5753319193050349 * pb) >= 0,
            1 * pb + (- 0.35564412876414714 * pf) >= 0
