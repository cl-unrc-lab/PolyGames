//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.16191638241658118
// Q_TERRAIN[0][1] = 0.07542458696225096
// Q_TERRAIN[0][2] = 0.3254672365199269
// Q_TERRAIN[0][3] = 0.03621814333377138
// Q_TERRAIN[0][4] = 0.2679410021533446
// Q_TERRAIN[0][5] = 0.18284445845629277
// Q_TERRAIN[1][0] = 0.028999462387353403
// Q_TERRAIN[1][1] = 0.25371786659471013
// Q_TERRAIN[1][2] = 0.01874782922099244
// Q_TERRAIN[1][3] = 0.21682284183119294
// Q_TERRAIN[1][4] = 0.03492771178730947
// Q_TERRAIN[1][5] = 0.04535650667193253
// Q_TERRAIN[2][0] = 0.21225959457125698
// Q_TERRAIN[2][1] = 0.41342606233601903
// Q_TERRAIN[2][2] = 0.061900980574822795
// Q_TERRAIN[2][3] = 0.11161948230350727
// Q_TERRAIN[2][4] = 0.31371661120279465
// Q_TERRAIN[2][5] = 0.4738544712285028
// Q_TERRAIN[3][0] = 0.28855147430874933
// Q_TERRAIN[3][1] = 0.19834023732539008
// Q_TERRAIN[3][2] = 0.48812755279646003
// Q_TERRAIN[3][3] = 0.02329134030887814
// Q_TERRAIN[3][4] = 0.42923422952433976
// Q_TERRAIN[3][5] = 0.14480464316583813
// Q_TERRAIN[4][0] = 0.07212754167871877
// Q_TERRAIN[4][1] = 0.05889611903918418
// Q_TERRAIN[4][2] = 0.15424091205096718
// Q_TERRAIN[4][3] = 0.4080631795600157
// Q_TERRAIN[4][4] = 0.09036318996196874
// Q_TERRAIN[4][5] = 0.2908000818312331
// Q_TERRAIN[5][0] = 0.31945673446309203
// Q_TERRAIN[5][1] = 0.1861987713628656
// Q_TERRAIN[5][2] = 0.2738722328547789
// Q_TERRAIN[5][3] = 0.03139448748666157
// Q_TERRAIN[5][4] = 0.02980058498311633
// Q_TERRAIN[5][5] = 0.10297935640966327

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.3607999463635718
// F_SLOPE[0][1] =  -0.14481538866119426
// F_SLOPE[0][2] =  -0.37170565924641696
// F_SLOPE[0][3] =  0.17112372701527745
// F_SLOPE[0][4] =  -0.09363124725844929
// F_SLOPE[0][5] =  -0.4004660062726353
// F_SLOPE[1][0] =  0.5887589630449823
// F_SLOPE[1][1] =  0.3979888674591425
// F_SLOPE[1][2] =  -0.5118069785556942
// F_SLOPE[1][3] =  0.148847420517342
// F_SLOPE[1][4] =  0.050393007622902886
// F_SLOPE[1][5] =  0.7502749911468578
// F_SLOPE[2][0] =  0.4588905788784352
// F_SLOPE[2][1] =  -0.42412447021962696
// F_SLOPE[2][2] =  0.9603496949851642
// F_SLOPE[2][3] =  -0.7638684434900758
// F_SLOPE[2][4] =  -0.1637543564295456
// F_SLOPE[2][5] =  0.5142818591304987
// F_SLOPE[3][0] =  -0.6960309306789905
// F_SLOPE[3][1] =  -0.022073799048388798
// F_SLOPE[3][2] =  -0.9215854859051247
// F_SLOPE[3][3] =  0.3364317130687904
// F_SLOPE[3][4] =  0.5291417324256262
// F_SLOPE[3][5] =  0.14605188055476792
// F_SLOPE[4][0] =  0.7509556236617765
// F_SLOPE[4][1] =  -0.37250497430380647
// F_SLOPE[4][2] =  0.3905907325473186
// F_SLOPE[4][3] =  0.18873975421003686
// F_SLOPE[4][4] =  0.1597904085649844
// F_SLOPE[4][5] =  -0.0875893373971739
// F_SLOPE[5][0] =  0.6799355610250828
// F_SLOPE[5][1] =  0.8893621902158748
// F_SLOPE[5][2] =  -0.05180332516071107
// F_SLOPE[5][3] =  0.3283044109493489
// F_SLOPE[5][4] =  -0.8786611448055606
// F_SLOPE[5][5] =  0.4029840426088478

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.29425770905533755
// L_SLOPE[0][1]   =  0.9861918789332682
// L_SLOPE[0][2]   =  0.6438495732194298
// L_SLOPE[0][3]   =  -0.43080893581170154
// L_SLOPE[0][4]   =  -0.22841711510657836
// L_SLOPE[0][5]   =  0.33730543176837635
// L_SLOPE[1][0]   =  -0.9548741438888229
// L_SLOPE[1][1]   =  -0.07660942740046828
// L_SLOPE[1][2]   =  -0.6639032421869109
// L_SLOPE[1][3]   =  -0.7658084110365362
// L_SLOPE[1][4]   =  -0.8820911613373792
// L_SLOPE[1][5]   =  0.5364659769450415
// L_SLOPE[2][0]   =  -0.7413195559626315
// L_SLOPE[2][1]   =  -0.5047703326061714
// L_SLOPE[2][2]   =  -0.21810059373354584
// L_SLOPE[2][3]   =  0.7428439482525988
// L_SLOPE[2][4]   =  -0.8388373975997228
// L_SLOPE[2][5]   =  -0.10162519810133808
// L_SLOPE[3][0]   =  0.0988798182880748
// L_SLOPE[3][1]   =  0.766767652883025
// L_SLOPE[3][2]   =  0.6385596756714826
// L_SLOPE[3][3]   =  0.7279689393970303
// L_SLOPE[3][4]   =  -0.4431578709722057
// L_SLOPE[3][5]   =  -0.16940696557660284
// L_SLOPE[4][0]   =  -0.2824576693367504
// L_SLOPE[4][1]   =  0.768385654396434
// L_SLOPE[4][2]   =  0.9154624079279825
// L_SLOPE[4][3]   =  -0.6981581884177821
// L_SLOPE[4][4]   =  -0.6475645430192594
// L_SLOPE[4][5]   =  -0.5360862663609285
// L_SLOPE[5][0]   =  -0.5333278326382778
// L_SLOPE[5][1]   =  -0.030074539317286764
// L_SLOPE[5][2]   =  0.17824700746451128
// L_SLOPE[5][3]   =  -0.47450676140292414
// L_SLOPE[5][4]   =  -0.9918127932298721
// L_SLOPE[5][5]   =  -0.16210699774934412
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 3;
    robrow : [0..6] init 3;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5636388726960808,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5914710522765123 * pr) >= 0,
            0.7057422909446625 * pr + (- 0.8380836175834188 * pl) >= 0,
            0.6392000536364282 * pf + (- 0.8380836175834188 * pb) >= 0,
            1 * pb + (- 0.5357030933111331 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5636388726960808,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5914710522765123 * pr) >= 0,
            0.7057422909446625 * pr + (- 0.8380836175834188 * pl) >= 0,
            0.6392000536364282 * pf + (- 0.8380836175834188 * pb) >= 0,
            1 * pb + (- 0.5357030933111331 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5636388726960808,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5914710522765123 * pr) >= 0,
            0.7057422909446625 * pr + (-0.8380836175834188 * pl) >= 0,
            0.6392000536364282 * pf + (-0.8380836175834188 * pb) >= 0,
            1 * pb + (-0.5357030933111331 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5636388726960808,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5914710522765123 * pr) >= 0,
            0.7057422909446625 * pr + (- 0.8380836175834188 * pl) >= 0,
            0.6392000536364282 * pf + (- 0.8380836175834188 * pb) >= 0,
            1 * pb + (- 0.5357030933111331 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4304796593616351,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.012766649238548792 * pr) >= 0,
            0.013808121066731793 * pr + (- 0.924575413037749 * pl) >= 0,
            1 * pf + (- 0.7906826652521032 * pb) >= 0,
            0.8551846113388057 * pb + (- 0.924575413037749 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4304796593616351,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.012766649238548792 * pr) >= 0,
            0.013808121066731793 * pr + (- 0.924575413037749 * pl) >= 0,
            1 * pf + (- 0.7906826652521032 * pb) >= 0,
            0.8551846113388057 * pb + (- 1.0584681608233948 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4304796593616351,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.012766649238548792 * pr) >= 0,
            0.013808121066731793 * pr + (-0.924575413037749 * pl) >= 0,
            1 * pf + (-0.7906826652521032 * pb) >= 0,
            0.8551846113388057 * pb + (-0.924575413037749 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4304796593616351,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.012766649238548792 * pr) >= 0,
            0.013808121066731793 * pr + (- 0.924575413037749 * pl) >= 0,
            1 * pf + (- 0.7906826652521032 * pb) >= 0,
            0.8551846113388057 * pb + (- 0.924575413037749 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2864164122816759,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.24023513159090543 * pr) >= 0,
            0.3561504267805702 * pr + (- 0.6745327634800731 * pl) >= 0,
            1 * pf + (- 0.42380511794740505 * pb) >= 0,
            0.628294340753583 * pb + (- 0.6745327634800731 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2864164122816759,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.24023513159090543 * pr) >= 0,
            0.3561504267805702 * pr + (- 0.6745327634800731 * pl) >= 0,
            1 * pf + (- 0.42380511794740505 * pb) >= 0,
            0.628294340753583 * pb + (- 0.9252604090127411 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2864164122816759,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.24023513159090543 * pr) >= 0,
            0.3561504267805702 * pr + (-0.6745327634800731 * pl) >= 0,
            1 * pf + (-0.42380511794740505 * pb) >= 0,
            0.628294340753583 * pb + (-0.6745327634800731 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2864164122816759,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.24023513159090543 * pr) >= 0,
            0.3561504267805702 * pr + (- 0.6745327634800731 * pl) >= 0,
            1 * pf + (- 0.42380511794740505 * pb) >= 0,
            0.628294340753583 * pb + (- 0.6745327634800731 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6996763406165311,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5691910641882985 * pl + (- 0.9637818566662286 * pr) >= 0,
            1 * pr + (- 0.5485760206412248 * pl) >= 0,
            0.8288762729847226 * pf + (- 0.9637818566662286 * pb) >= 0,
            1 * pb + (- 0.7988559133237997 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6996763406165311,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5691910641882985 * pl + (- 0.9637818566662286 * pr) >= 0,
            1 * pr + (- 0.5485760206412248 * pl) >= 0,
            0.8288762729847226 * pf + (- 0.9637818566662286 * pb) >= 0,
            1 * pb + (- 0.7988559133237997 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6996763406165311,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5691910641882985 * pl + (- 0.9637818566662286 * pr) >= 0,
            1 * pr + (-0.5485760206412248 * pl) >= 0,
            0.8288762729847226 * pf + (-0.9637818566662286 * pb) >= 0,
            1 * pb + (-0.7988559133237997 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6996763406165311,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5691910641882985 * pl + (- 0.9637818566662286 * pr) >= 0,
            1 * pr + (- 0.5485760206412248 * pl) >= 0,
            0.8288762729847226 * pf + (- 0.9637818566662286 * pb) >= 0,
            1 * pb + (- 0.7988559133237997 * pf) >= 0
