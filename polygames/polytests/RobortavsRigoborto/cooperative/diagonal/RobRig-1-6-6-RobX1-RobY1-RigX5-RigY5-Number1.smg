//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.06718212205620061
// Q_TERRAIN[0][1] = 0.42371686846861634
// Q_TERRAIN[0][2] = 0.381887309488307
// Q_TERRAIN[0][3] = 0.12753451286971085
// Q_TERRAIN[0][4] = 0.24771754354597048
// Q_TERRAIN[0][5] = 0.22474553239436906
// Q_TERRAIN[1][0] = 0.3257964863613815
// Q_TERRAIN[1][1] = 0.3943616755677566
// Q_TERRAIN[1][2] = 0.04692979338711745
// Q_TERRAIN[1][3] = 0.014173738261003155
// Q_TERRAIN[1][4] = 0.41788255195993484
// Q_TERRAIN[1][5] = 0.21638353395252669
// Q_TERRAIN[2][0] = 0.381140041228971
// Q_TERRAIN[2][1] = 0.0010530266755553463
// Q_TERRAIN[2][2] = 0.2226935970274007
// Q_TERRAIN[2][3] = 0.3607700161703913
// Q_TERRAIN[2][4] = 0.11438111063522632
// Q_TERRAIN[2][5] = 0.47263534777696115
// Q_TERRAIN[3][0] = 0.4507137288057418
// Q_TERRAIN[3][1] = 0.015294991516776768
// Q_TERRAIN[3][2] = 0.0127229304967304
// Q_TERRAIN[3][3] = 0.2707062363967483
// Q_TERRAIN[3][4] = 0.4695745813892553
// Q_TERRAIN[3][5] = 0.19060211884410622
// Q_TERRAIN[4][0] = 0.10829969856530669
// Q_TERRAIN[4][1] = 0.21105828779135866
// Q_TERRAIN[4][2] = 0.014520393787433972
// Q_TERRAIN[4][3] = 0.11084583313651752
// Q_TERRAIN[4][4] = 0.21894379682528603
// Q_TERRAIN[4][5] = 0.24790612069092532
// Q_TERRAIN[5][0] = 0.11654222512878631
// Q_TERRAIN[5][1] = 0.11543327077049215
// Q_TERRAIN[5][2] = 0.1093905186688443
// Q_TERRAIN[5][3] = 0.2298017328688668
// Q_TERRAIN[5][4] = 0.14489080729524279
// Q_TERRAIN[5][5] = 0.010744852632954438

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.6751559513251457
// F_SLOPE[0][1] =  0.11290864530486688
// F_SLOPE[0][2] =  0.28458872586489115
// F_SLOPE[0][3] =  -0.6281874682105646
// F_SLOPE[0][4] =  0.9850868243521302
// F_SLOPE[0][5] =  0.7198930575905798
// F_SLOPE[1][0] =  -0.7582200803883872
// F_SLOPE[1][1] =  -0.3346096292797418
// F_SLOPE[1][2] =  0.44296881516653674
// F_SLOPE[1][3] =  0.4223835393905593
// F_SLOPE[1][4] =  0.8728811735989193
// F_SLOPE[1][5] =  -0.15578600007716958
// F_SLOPE[2][0] =  0.660071386548654
// F_SLOPE[2][1] =  0.34061113282814204
// F_SLOPE[2][2] =  -0.3932629781341648
// F_SLOPE[2][3] =  0.1751612122871189
// F_SLOPE[2][4] =  0.7649580016637154
// F_SLOPE[2][5] =  0.6923948368566255
// F_SLOPE[3][0] =  0.010567641159200836
// F_SLOPE[3][1] =  0.17800451596510336
// F_SLOPE[3][2] =  -0.9309483396973168
// F_SLOPE[3][3] =  -0.5145200529138647
// F_SLOPE[3][4] =  0.5948084951086057
// F_SLOPE[3][5] =  -0.17137200139845143
// F_SLOPE[4][0] =  -0.6539851968418982
// F_SLOPE[4][1] =  0.09759752277630596
// F_SLOPE[4][2] =  0.40608152413126297
// F_SLOPE[4][3] =  0.3489716610046545
// F_SLOPE[4][4] =  -0.25059395899671943
// F_SLOPE[4][5] =  -0.12207673991087375
// F_SLOPE[5][0] =  0.016852976499963646
// F_SLOPE[5][1] =  0.5568852300002916
// F_SLOPE[5][2] =  0.041876835226290376
// F_SLOPE[5][3] =  -0.21348981007154788
// F_SLOPE[5][4] =  -0.02061295907548355
// F_SLOPE[5][5] =  -0.9408500720661859

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.9130254192869451
// L_SLOPE[0][1]   =  0.406764177207672
// L_SLOPE[0][2]   =  0.9663754346193478
// L_SLOPE[0][3]   =  0.18636746076011512
// L_SLOPE[0][4]   =  -0.21280062724417204
// L_SLOPE[0][5]   =  -0.6593016062886374
// L_SLOPE[1][0]   =  0.004477116866966169
// L_SLOPE[1][1]   =  0.9641532750770685
// L_SLOPE[1][2]   =  0.5410462796616011
// L_SLOPE[1][3]   =  0.07923489689955754
// L_SLOPE[1][4]   =  0.7205795578410992
// L_SLOPE[1][5]   =  -0.5356477438739708
// L_SLOPE[2][0]   =  0.027543326375274013
// L_SLOPE[2][1]   =  0.904934776536539
// L_SLOPE[2][2]   =  0.15558961560240614
// L_SLOPE[2][3]   =  -0.08173653617866328
// L_SLOPE[2][4]   =  -0.46144104511715756
// L_SLOPE[2][5]   =  0.09599261893249778
// L_SLOPE[3][0]   =  0.9142325629204537
// L_SLOPE[3][1]   =  -0.9885817410992142
// L_SLOPE[3][2]   =  0.5673104652307797
// L_SLOPE[3][3]   =  0.6409718238509639
// L_SLOPE[3][4]   =  0.7723591616520165
// L_SLOPE[3][5]   =  0.4810068236663927
// L_SLOPE[4][0]   =  0.6182798017449591
// L_SLOPE[4][1]   =  0.0373565670460041
// L_SLOPE[4][2]   =  0.12271572955675802
// L_SLOPE[4][3]   =  -0.14781864062369965
// L_SLOPE[4][4]   =  -0.8877534049585192
// L_SLOPE[4][5]   =  0.7400203103532796
// L_SLOPE[5][0]   =  0.1399986677527605
// L_SLOPE[5][1]   =  -0.6003211596457139
// L_SLOPE[5][2]   =  0.00944093485772668
// L_SLOPE[5][3]   =  -0.030149775544531687
// L_SLOPE[5][4]   =  -0.2864200709100886
// L_SLOPE[5][5]   =  -0.30784416196369024
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 1;
    robrow : [0..6] init 1;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4469444654091127,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08697458071305486 * pl + (- 0.9328178779437994 * pr) >= 0,
            1 * pr + (- 0.08113144381580355 * pl) >= 0,
            0.3248440486748543 * pf + (- 0.9328178779437994 * pb) >= 0,
            1 * pb + (- 0.30302033614754986 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4469444654091127,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08697458071305486 * pl + (- 0.9328178779437994 * pr) >= 0,
            1 * pr + (- 0.08113144381580355 * pl) >= 0,
            0.3248440486748543 * pf + (- 0.9328178779437994 * pb) >= 0,
            1 * pb + (- 0.30302033614754986 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4469444654091127,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08697458071305486 * pl + (- 0.9328178779437994 * pr) >= 0,
            1 * pr + (-0.08113144381580355 * pl) >= 0,
            0.3248440486748543 * pf + (-0.9328178779437994 * pb) >= 0,
            1 * pb + (-0.30302033614754986 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.4469444654091127,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.08697458071305486 * pl + (- 0.9328178779437994 * pr) >= 0,
            1 * pr + (- 0.08113144381580355 * pl) >= 0,
            0.3248440486748543 * pf + (- 0.9328178779437994 * pb) >= 0,
            1 * pb + (- 0.30302033614754986 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3394103163786477,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.34187179769535975 * pr) >= 0,
            0.593235822792328 * pr + (- 0.5762831315313837 * pl) >= 0,
            0.8870913546951331 * pf + (- 0.5762831315313837 * pb) >= 0,
            1 * pb + (- 0.5112157838381287 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3394103163786477,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.34187179769535975 * pr) >= 0,
            0.593235822792328 * pr + (- 0.5762831315313837 * pl) >= 0,
            0.8870913546951331 * pf + (- 0.5762831315313837 * pb) >= 0,
            1 * pb + (- 0.5112157838381287 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3394103163786477,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.34187179769535975 * pr) >= 0,
            0.593235822792328 * pr + (-0.5762831315313837 * pl) >= 0,
            0.8870913546951331 * pf + (-0.5762831315313837 * pb) >= 0,
            1 * pb + (-0.5112157838381287 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3394103163786477,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.34187179769535975 * pr) >= 0,
            0.593235822792328 * pr + (- 0.5762831315313837 * pl) >= 0,
            0.8870913546951331 * pf + (- 0.5762831315313837 * pb) >= 0,
            1 * pb + (- 0.5112157838381287 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1301403870922988,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.02078377057472124 * pr) >= 0,
            0.03362456538065217 * pr + (- 0.6181126905116929 * pl) >= 0,
            0.7154112741351089 * pf + (- 0.6181126905116929 * pb) >= 0,
            1 * pb + (- 0.4422047874780505 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1301403870922988,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.02078377057472124 * pr) >= 0,
            0.03362456538065217 * pr + (- 0.6181126905116929 * pl) >= 0,
            0.7154112741351089 * pf + (- 0.6181126905116929 * pb) >= 0,
            1 * pb + (- 0.4422047874780505 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1301403870922988,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.02078377057472124 * pr) >= 0,
            0.03362456538065217 * pr + (-0.6181126905116929 * pl) >= 0,
            0.7154112741351089 * pf + (-0.6181126905116929 * pb) >= 0,
            1 * pb + (-0.4422047874780505 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1301403870922988,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.02078377057472124 * pr) >= 0,
            0.03362456538065217 * pr + (- 0.6181126905116929 * pl) >= 0,
            0.7154112741351089 * pf + (- 0.6181126905116929 * pb) >= 0,
            1 * pb + (- 0.4422047874780505 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5237248743108135,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.7098663096929803 * pr) >= 0,
            0.8136325392398849 * pr + (- 0.8724654871302892 * pl) >= 0,
            1 * pf + (- 0.32439360166881587 * pb) >= 0,
            0.3718125317894354 * pb + (- 0.8724654871302892 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5237248743108135,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.7098663096929803 * pr) >= 0,
            0.8136325392398849 * pr + (- 0.8724654871302892 * pl) >= 0,
            1 * pf + (- 0.32439360166881587 * pb) >= 0,
            0.3718125317894354 * pb + (- 1.4205373725917625 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5237248743108135,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.7098663096929803 * pr) >= 0,
            0.8136325392398849 * pr + (-0.8724654871302892 * pl) >= 0,
            1 * pf + (-0.32439360166881587 * pb) >= 0,
            0.3718125317894354 * pb + (-0.8724654871302892 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5237248743108135,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.7098663096929803 * pr) >= 0,
            0.8136325392398849 * pr + (- 0.8724654871302892 * pl) >= 0,
            1 * pf + (- 0.32439360166881587 * pb) >= 0,
