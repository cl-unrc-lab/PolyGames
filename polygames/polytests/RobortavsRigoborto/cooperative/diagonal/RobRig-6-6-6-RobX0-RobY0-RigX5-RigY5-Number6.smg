//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.3966700418808315
// Q_TERRAIN[0][1] = 0.4109770211598634
// Q_TERRAIN[0][2] = 0.24251731396547266
// Q_TERRAIN[0][3] = 0.13081074147232896
// Q_TERRAIN[0][4] = 0.00022585744253550422
// Q_TERRAIN[0][5] = 0.3314092814418838
// Q_TERRAIN[1][0] = 0.2351271285322225
// Q_TERRAIN[1][1] = 0.37986531754894654
// Q_TERRAIN[1][2] = 0.18658018603692078
// Q_TERRAIN[1][3] = 0.3850699179689951
// Q_TERRAIN[1][4] = 0.13634904283598537
// Q_TERRAIN[1][5] = 0.4009577415813018
// Q_TERRAIN[2][0] = 0.364912416311008
// Q_TERRAIN[2][1] = 0.2070032205826517
// Q_TERRAIN[2][2] = 0.26915260977763844
// Q_TERRAIN[2][3] = 0.3410258706443392
// Q_TERRAIN[2][4] = 0.0964924378820437
// Q_TERRAIN[2][5] = 0.27680758274914213
// Q_TERRAIN[3][0] = 0.4025620249244866
// Q_TERRAIN[3][1] = 0.13276052721925102
// Q_TERRAIN[3][2] = 0.4016826548056566
// Q_TERRAIN[3][3] = 0.34284494105022045
// Q_TERRAIN[3][4] = 0.42214116239808247
// Q_TERRAIN[3][5] = 0.16779100891290716
// Q_TERRAIN[4][0] = 0.04656729609571614
// Q_TERRAIN[4][1] = 0.40014135990271293
// Q_TERRAIN[4][2] = 0.4023907566461215
// Q_TERRAIN[4][3] = 0.2226062070564216
// Q_TERRAIN[4][4] = 0.04689018709796983
// Q_TERRAIN[4][5] = 0.0985810223994672
// Q_TERRAIN[5][0] = 0.3174594260618495
// Q_TERRAIN[5][1] = 0.1455917809067328
// Q_TERRAIN[5][2] = 0.47568650188178974
// Q_TERRAIN[5][3] = 0.29428489842550376
// Q_TERRAIN[5][4] = 0.10043715994024344
// Q_TERRAIN[5][5] = 0.32770199668659206

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  -0.27924086918380775
// F_SLOPE[0][1] =  0.8654744302142128
// F_SLOPE[0][2] =  0.819022405054018
// F_SLOPE[0][3] =  0.029302322505158074
// F_SLOPE[0][4] =  0.2891436214749894
// F_SLOPE[0][5] =  0.3958207054795082
// F_SLOPE[1][0] =  0.6110098437024742
// F_SLOPE[1][1] =  0.9527500110312352
// F_SLOPE[1][2] =  -0.9431560392159455
// F_SLOPE[1][3] =  -0.27724715702391123
// F_SLOPE[1][4] =  0.20349448069466058
// F_SLOPE[1][5] =  -0.3913511878642497
// F_SLOPE[2][0] =  0.17831348060942687
// F_SLOPE[2][1] =  -0.8206250742054411
// F_SLOPE[2][2] =  0.7601576846631826
// F_SLOPE[2][3] =  0.0505263686049795
// F_SLOPE[2][4] =  -0.7663512139289321
// F_SLOPE[2][5] =  0.3254823426587079
// F_SLOPE[3][0] =  -0.3754386794715623
// F_SLOPE[3][1] =  -0.6075517329602436
// F_SLOPE[3][2] =  -0.03251143958063829
// F_SLOPE[3][3] =  -0.7237889081635596
// F_SLOPE[3][4] =  -0.5802294487654596
// F_SLOPE[3][5] =  0.7310783993599514
// F_SLOPE[4][0] =  0.3964474875053843
// F_SLOPE[4][1] =  -0.9749546022899946
// F_SLOPE[4][2] =  0.5561150188616335
// F_SLOPE[4][3] =  -0.9658825002910614
// F_SLOPE[4][4] =  -0.3341758764126037
// F_SLOPE[4][5] =  0.8088757048749329
// F_SLOPE[5][0] =  0.24053051499453693
// F_SLOPE[5][1] =  -0.3877509478534438
// F_SLOPE[5][2] =  -0.24519040394762426
// F_SLOPE[5][3] =  -0.22166883514599212
// F_SLOPE[5][4] =  -0.7463305491398344
// F_SLOPE[5][5] =  0.9997571928614051

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.8923557224072676
// L_SLOPE[0][1]   =  -0.15422268816933093
// L_SLOPE[0][2]   =  0.4926260709513357
// L_SLOPE[0][3]   =  -0.2044714078905947
// L_SLOPE[0][4]   =  0.9619470602460705
// L_SLOPE[0][5]   =  -0.5093779145827158
// L_SLOPE[1][0]   =  0.958512069121854
// L_SLOPE[1][1]   =  0.7845139891383266
// L_SLOPE[1][2]   =  0.3404342214833951
// L_SLOPE[1][3]   =  0.7790250993685781
// L_SLOPE[1][4]   =  -0.10561167025702822
// L_SLOPE[1][5]   =  0.6625190284850977
// L_SLOPE[2][0]   =  0.5921976726721345
// L_SLOPE[2][1]   =  0.03337333241732088
// L_SLOPE[2][2]   =  -0.058140392549905995
// L_SLOPE[2][3]   =  0.4113459559758368
// L_SLOPE[2][4]   =  -0.1818724730502792
// L_SLOPE[2][5]   =  -0.8281382442691121
// L_SLOPE[3][0]   =  0.4930317801263884
// L_SLOPE[3][1]   =  -0.46836056632759915
// L_SLOPE[3][2]   =  -0.024672005733440416
// L_SLOPE[3][3]   =  0.5680585498373787
// L_SLOPE[3][4]   =  -0.6557437923768026
// L_SLOPE[3][5]   =  -0.956253282160427
// L_SLOPE[4][0]   =  -0.7530093751678237
// L_SLOPE[4][1]   =  0.17883112731245254
// L_SLOPE[4][2]   =  -0.2779017509883781
// L_SLOPE[4][3]   =  -0.4873755797336021
// L_SLOPE[4][4]   =  -0.0969335089707355
// L_SLOPE[4][5]   =  0.8551942187081658
// L_SLOPE[5][0]   =  -0.4904731961852129
// L_SLOPE[5][1]   =  -0.17885679115459463
// L_SLOPE[5][2]   =  0.7585877242944075
// L_SLOPE[5][3]   =  0.2243543190569368
// L_SLOPE[5][4]   =  -0.46412499841324606
// L_SLOPE[5][5]   =  -0.050582145805842416
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 0;
    robrow : [0..6] init 0;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14212275609670588,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.10764427759273243 * pl + (- 0.6033299581191685 * pr) >= 0,
            1 * pr + (- 0.06494501749179139 * pl) >= 0,
            1 * pf + (- 0.4348555762093415 * pb) >= 0,
            0.7207591308161923 * pb + (- 0.6033299581191685 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14212275609670588,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.10764427759273243 * pl + (- 0.6033299581191685 * pr) >= 0,
            1 * pr + (- 0.06494501749179139 * pl) >= 0,
            1 * pf + (- 0.4348555762093415 * pb) >= 0,
            0.7207591308161923 * pb + (- 0.7718043400289953 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14212275609670588,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.10764427759273243 * pl + (- 0.6033299581191685 * pr) >= 0,
            1 * pr + (-0.06494501749179139 * pl) >= 0,
            1 * pf + (-0.4348555762093415 * pb) >= 0,
            0.7207591308161923 * pb + (-0.6033299581191685 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14212275609670588,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.10764427759273243 * pl + (- 0.6033299581191685 * pr) >= 0,
            1 * pr + (- 0.06494501749179139 * pl) >= 0,
            1 * pf + (- 0.4348555762093415 * pb) >= 0,
            0.7207591308161923 * pb + (- 0.6033299581191685 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14591231623309264,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8457773118306691 * pl + (- 0.5890229788401367 * pr) >= 0,
            1 * pr + (- 0.49818227164990386 * pl) >= 0,
            0.13452556978578722 * pf + (- 0.5890229788401367 * pb) >= 0,
            1 * pb + (- 0.07923865184539107 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14591231623309264,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8457773118306691 * pl + (- 0.5890229788401367 * pr) >= 0,
            1 * pr + (- 0.49818227164990386 * pl) >= 0,
            0.13452556978578722 * pf + (- 0.5890229788401367 * pb) >= 0,
            1 * pb + (- 0.07923865184539107 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14591231623309264,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8457773118306691 * pl + (- 0.5890229788401367 * pr) >= 0,
            1 * pr + (-0.49818227164990386 * pl) >= 0,
            0.13452556978578722 * pf + (-0.5890229788401367 * pb) >= 0,
            1 * pb + (-0.07923865184539107 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.14591231623309264,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8457773118306691 * pl + (- 0.5890229788401367 * pr) >= 0,
            1 * pr + (- 0.49818227164990386 * pl) >= 0,
            0.13452556978578722 * pf + (- 0.5890229788401367 * pb) >= 0,
            1 * pb + (- 0.07923865184539107 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3033943427432877,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.38432696659967397 * pr) >= 0,
            0.5073739290486643 * pr + (- 0.7574826860345274 * pl) >= 0,
            0.18097759494598198 * pf + (- 0.7574826860345274 * pb) >= 0,
            1 * pb + (- 0.13708739473175113 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3033943427432877,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.38432696659967397 * pr) >= 0,
            0.5073739290486643 * pr + (- 0.7574826860345274 * pl) >= 0,
            0.18097759494598198 * pf + (- 0.7574826860345274 * pb) >= 0,
            1 * pb + (- 0.13708739473175113 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3033943427432877,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.38432696659967397 * pr) >= 0,
            0.5073739290486643 * pr + (-0.7574826860345274 * pl) >= 0,
            0.18097759494598198 * pf + (-0.7574826860345274 * pb) >= 0,
            1 * pb + (-0.13708739473175113 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3033943427432877,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.38432696659967397 * pr) >= 0,
            0.5073739290486643 * pr + (- 0.7574826860345274 * pl) >= 0,
            0.18097759494598198 * pf + (- 0.7574826860345274 * pb) >= 0,
            1 * pb + (- 0.13708739473175113 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.7552981368983416,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7955285921094053 * pl + (- 0.869189258527671 * pr) >= 0,
            1 * pr + (- 0.691464907113136 * pl) >= 0,
            0.9706976774948419 * pf + (- 0.869189258527671 * pb) >= 0,
            1 * pb + (- 0.843719994556274 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.7552981368983416,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7955285921094053 * pl + (- 0.869189258527671 * pr) >= 0,
            1 * pr + (- 0.691464907113136 * pl) >= 0,
            0.9706976774948419 * pf + (- 0.869189258527671 * pb) >= 0,
            1 * pb + (- 0.843719994556274 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.7552981368983416,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7955285921094053 * pl + (- 0.869189258527671 * pr) >= 0,
            1 * pr + (-0.691464907113136 * pl) >= 0,
            0.9706976774948419 * pf + (-0.869189258527671 * pb) >= 0,
            1 * pb + (-0.843719994556274 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.7552981368983416,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7955285921094053 * pl + (- 0.869189258527671 * pr) >= 0,
            1 * pr + (- 0.691464907113136 * pl) >= 0,
            0.9706976774948419 * pf + (- 0.869189258527671 * pb) >= 0,
            1 * pb + (- 0.843719994556274 * pf) >= 0
