//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.2261897767549093
// Q_TERRAIN[0][1] = 0.279886193040248
// Q_TERRAIN[0][2] = 0.4621052920118647
// Q_TERRAIN[0][3] = 0.23282503504988666
// Q_TERRAIN[0][4] = 0.25392063653113556
// Q_TERRAIN[0][5] = 0.2936924144249485
// Q_TERRAIN[1][0] = 0.09233017192743831
// Q_TERRAIN[1][1] = 0.25595431952090275
// Q_TERRAIN[1][2] = 0.31494136010840096
// Q_TERRAIN[1][3] = 0.3964884362599763
// Q_TERRAIN[1][4] = 0.047061728114609236
// Q_TERRAIN[1][5] = 0.15170063131226275
// Q_TERRAIN[2][0] = 0.0453352687459197
// Q_TERRAIN[2][1] = 0.40482226718358877
// Q_TERRAIN[2][2] = 0.34671924127061954
// Q_TERRAIN[2][3] = 0.020940168184923003
// Q_TERRAIN[2][4] = 0.4910967103993891
// Q_TERRAIN[2][5] = 0.4823788905627834
// Q_TERRAIN[3][0] = 0.3269612667669202
// Q_TERRAIN[3][1] = 0.3077813522892854
// Q_TERRAIN[3][2] = 0.07874704757008122
// Q_TERRAIN[3][3] = 0.007500368474802455
// Q_TERRAIN[3][4] = 0.2641906330852394
// Q_TERRAIN[3][5] = 0.02977555258442749
// Q_TERRAIN[4][0] = 0.09510413139896456
// Q_TERRAIN[4][1] = 0.12097150683260738
// Q_TERRAIN[4][2] = 0.015041294612394285
// Q_TERRAIN[4][3] = 0.23196723061164226
// Q_TERRAIN[4][4] = 0.2202655583283284
// Q_TERRAIN[4][5] = 0.421213564259266
// Q_TERRAIN[5][0] = 0.25956205738203836
// Q_TERRAIN[5][1] = 0.32014585395958856
// Q_TERRAIN[5][2] = 0.24988657610339582
// Q_TERRAIN[5][3] = 0.3312247659451841
// Q_TERRAIN[5][4] = 0.22866494079977884
// Q_TERRAIN[5][5] = 0.13908144983194293

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.9953124009261687
// F_SLOPE[0][1] =  0.9913832833123983
// F_SLOPE[0][2] =  0.6804310989857236
// F_SLOPE[0][3] =  0.4156192429958989
// F_SLOPE[0][4] =  -0.3694455659689002
// F_SLOPE[0][5] =  -0.5406681967841889
// F_SLOPE[1][0] =  -0.42192010537159574
// F_SLOPE[1][1] =  -0.8595530008801482
// F_SLOPE[1][2] =  0.532575772820814
// F_SLOPE[1][3] =  -0.19920039016301794
// F_SLOPE[1][4] =  0.6931672437623573
// F_SLOPE[1][5] =  -0.226972936588131
// F_SLOPE[2][0] =  0.916084766639627
// F_SLOPE[2][1] =  0.6946195466056089
// F_SLOPE[2][2] =  -0.9989101258888591
// F_SLOPE[2][3] =  -0.5805651705407777
// F_SLOPE[2][4] =  0.8205438562083629
// F_SLOPE[2][5] =  -0.06002544797266718
// F_SLOPE[3][0] =  0.9607178823485842
// F_SLOPE[3][1] =  -0.2051512238414377
// F_SLOPE[3][2] =  -0.8539233123326042
// F_SLOPE[3][3] =  0.25890982446804833
// F_SLOPE[3][4] =  0.5570217173533016
// F_SLOPE[3][5] =  -0.4604488262997146
// F_SLOPE[4][0] =  -0.8257116032956597
// F_SLOPE[4][1] =  -0.3348287490733042
// F_SLOPE[4][2] =  0.9281524331875282
// F_SLOPE[4][3] =  0.5160810339875177
// F_SLOPE[4][4] =  -0.7640166411608984
// F_SLOPE[4][5] =  -0.50722410221374
// F_SLOPE[5][0] =  -0.7979073820865898
// F_SLOPE[5][1] =  -0.8802131941178466
// F_SLOPE[5][2] =  0.5940430236879481
// F_SLOPE[5][3] =  -0.6446437436032677
// F_SLOPE[5][4] =  0.11859028322078968
// F_SLOPE[5][5] =  -0.10515024499795689

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.6186311694192679
// L_SLOPE[0][1]   =  0.46378843142870063
// L_SLOPE[0][2]   =  -0.7380658325667606
// L_SLOPE[0][3]   =  0.28743024742233425
// L_SLOPE[0][4]   =  -0.7669840247205888
// L_SLOPE[0][5]   =  -0.15848876550715807
// L_SLOPE[1][0]   =  -0.5742686539818211
// L_SLOPE[1][1]   =  -0.4604100456188034
// L_SLOPE[1][2]   =  0.941858112437383
// L_SLOPE[1][3]   =  0.6068230061641429
// L_SLOPE[1][4]   =  -0.391709700258021
// L_SLOPE[1][5]   =  0.7697302254979417
// L_SLOPE[2][0]   =  -0.5785795571311212
// L_SLOPE[2][1]   =  -0.2114507258558913
// L_SLOPE[2][2]   =  0.708753803402461
// L_SLOPE[2][3]   =  0.283671313180921
// L_SLOPE[2][4]   =  -0.7993344956322341
// L_SLOPE[2][5]   =  0.9786033950203448
// L_SLOPE[3][0]   =  -0.5735132628449549
// L_SLOPE[3][1]   =  -0.48344488427675913
// L_SLOPE[3][2]   =  0.5453793795456463
// L_SLOPE[3][3]   =  -0.3420891489045401
// L_SLOPE[3][4]   =  -0.4073504748021073
// L_SLOPE[3][5]   =  -0.8532028932231517
// L_SLOPE[4][0]   =  -0.8197656540761395
// L_SLOPE[4][1]   =  0.16546959633510405
// L_SLOPE[4][2]   =  -0.5139741597248753
// L_SLOPE[4][3]   =  0.20256768716387752
// L_SLOPE[4][4]   =  -0.2565919068135436
// L_SLOPE[4][5]   =  -0.09358379055230204
// L_SLOPE[5][0]   =  0.918269344974626
// L_SLOPE[5][1]   =  -0.03255093347490989
// L_SLOPE[5][2]   =  0.14914249085989506
// L_SLOPE[5][3]   =  0.7330513356044446
// L_SLOPE[5][4]   =  -0.6343445684426297
// L_SLOPE[5][5]   =  -0.6917293621478784
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 1;
    robrow : [0..6] init 1;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.27470407533359986,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3813688305807321 * pl + (- 0.7738102232450907 * pr) >= 0,
            1 * pr + (- 0.2951070999303955 * pl) >= 0,
            0.004687599073831317 * pf + (- 0.7738102232450907 * pb) >= 0,
            1 * pb + (- 0.0036273120858048916 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.27470407533359986,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3813688305807321 * pl + (- 0.7738102232450907 * pr) >= 0,
            1 * pr + (- 0.2951070999303955 * pl) >= 0,
            0.004687599073831317 * pf + (- 0.7738102232450907 * pb) >= 0,
            1 * pb + (- 0.0036273120858048916 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.27470407533359986,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3813688305807321 * pl + (- 0.7738102232450907 * pr) >= 0,
            1 * pr + (-0.2951070999303955 * pl) >= 0,
            0.004687599073831317 * pf + (-0.7738102232450907 * pb) >= 0,
            1 * pb + (-0.0036273120858048916 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.27470407533359986,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3813688305807321 * pl + (- 0.7738102232450907 * pr) >= 0,
            1 * pr + (- 0.2951070999303955 * pl) >= 0,
            0.004687599073831317 * pf + (- 0.7738102232450907 * pb) >= 0,
            1 * pb + (- 0.0036273120858048916 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22242399854524875,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.3861333539797385 * pr) >= 0,
            0.5362115685712994 * pr + (- 0.720113806959752 * pl) >= 0,
            0.008616716687601667 * pf + (- 0.720113806959752 * pb) >= 0,
            1 * pb + (- 0.00620501665740246 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22242399854524875,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.3861333539797385 * pr) >= 0,
            0.5362115685712994 * pr + (- 0.720113806959752 * pl) >= 0,
            0.008616716687601667 * pf + (- 0.720113806959752 * pb) >= 0,
            1 * pb + (- 0.00620501665740246 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22242399854524875,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.3861333539797385 * pr) >= 0,
            0.5362115685712994 * pr + (-0.720113806959752 * pl) >= 0,
            0.008616716687601667 * pf + (-0.720113806959752 * pb) >= 0,
            1 * pb + (-0.00620501665740246 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22242399854524875,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.3861333539797385 * pr) >= 0,
            0.5362115685712994 * pr + (- 0.720113806959752 * pl) >= 0,
            0.008616716687601667 * pf + (- 0.720113806959752 * pb) >= 0,
            1 * pb + (- 0.00620501665740246 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.07974771500050015,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2619341674332394 * pl + (- 0.5378947079881353 * pr) >= 0,
            1 * pr + (- 0.14089300250361764 * pl) >= 0,
            0.3195689010142764 * pf + (- 0.5378947079881353 * pb) >= 0,
            1 * pb + (- 0.17189442069316352 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.07974771500050015,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2619341674332394 * pl + (- 0.5378947079881353 * pr) >= 0,
            1 * pr + (- 0.14089300250361764 * pl) >= 0,
            0.3195689010142764 * pf + (- 0.5378947079881353 * pb) >= 0,
            1 * pb + (- 0.17189442069316352 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.07974771500050015,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2619341674332394 * pl + (- 0.5378947079881353 * pr) >= 0,
            1 * pr + (-0.14089300250361764 * pl) >= 0,
            0.3195689010142764 * pf + (-0.5378947079881353 * pb) >= 0,
            1 * pb + (-0.17189442069316352 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.07974771500050015,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.2619341674332394 * pl + (- 0.5378947079881353 * pr) >= 0,
            1 * pr + (- 0.14089300250361764 * pl) >= 0,
            0.3195689010142764 * pf + (- 0.5378947079881353 * pb) >= 0,
            1 * pb + (- 0.17189442069316352 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.47538099066489403,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5466656749582817 * pr) >= 0,
            0.7125697525776657 * pr + (- 0.7671749649501134 * pl) >= 0,
            0.5843807570041011 * pf + (- 0.7671749649501134 * pb) >= 0,
            1 * pb + (- 0.448322286772142 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.47538099066489403,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5466656749582817 * pr) >= 0,
            0.7125697525776657 * pr + (- 0.7671749649501134 * pl) >= 0,
            0.5843807570041011 * pf + (- 0.7671749649501134 * pb) >= 0,
            1 * pb + (- 0.448322286772142 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.47538099066489403,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5466656749582817 * pr) >= 0,
            0.7125697525776657 * pr + (-0.7671749649501134 * pl) >= 0,
            0.5843807570041011 * pf + (-0.7671749649501134 * pb) >= 0,
            1 * pb + (-0.448322286772142 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.47538099066489403,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5466656749582817 * pr) >= 0,
            0.7125697525776657 * pr + (- 0.7671749649501134 * pl) >= 0,
            0.5843807570041011 * pf + (- 0.7671749649501134 * pb) >= 0,
