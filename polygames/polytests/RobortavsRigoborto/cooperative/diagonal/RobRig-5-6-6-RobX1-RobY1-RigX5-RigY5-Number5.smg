//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.31145084744485096
// Q_TERRAIN[0][1] = 0.3708934946303647
// Q_TERRAIN[0][2] = 0.3975967827828483
// Q_TERRAIN[0][3] = 0.47122514188852516
// Q_TERRAIN[0][4] = 0.36994928736996535
// Q_TERRAIN[0][5] = 0.4611624983327085
// Q_TERRAIN[1][0] = 0.014502614141807368
// Q_TERRAIN[1][1] = 0.23281132718905267
// Q_TERRAIN[1][2] = 0.47167835849915685
// Q_TERRAIN[1][3] = 0.3244872765684621
// Q_TERRAIN[1][4] = 0.45045024587531135
// Q_TERRAIN[1][5] = 0.05660298232657218
// Q_TERRAIN[2][0] = 0.23453452389108187
// Q_TERRAIN[2][1] = 0.12328641630991516
// Q_TERRAIN[2][2] = 0.2718804296179652
// Q_TERRAIN[2][3] = 0.2869705939640504
// Q_TERRAIN[2][4] = 0.0065570947944511015
// Q_TERRAIN[2][5] = 0.10836490023192408
// Q_TERRAIN[3][0] = 0.13974118300555516
// Q_TERRAIN[3][1] = 0.45817268590427596
// Q_TERRAIN[3][2] = 0.38286272581457087
// Q_TERRAIN[3][3] = 0.07980210617901912
// Q_TERRAIN[3][4] = 0.39857349571560224
// Q_TERRAIN[3][5] = 0.06938370919945158
// Q_TERRAIN[4][0] = 0.3087262602330583
// Q_TERRAIN[4][1] = 0.06334961627513486
// Q_TERRAIN[4][2] = 0.0008874311012673219
// Q_TERRAIN[4][3] = 0.43570237236214104
// Q_TERRAIN[4][4] = 0.10472819124755894
// Q_TERRAIN[4][5] = 0.10774058461236613
// Q_TERRAIN[5][0] = 0.49121055441296263
// Q_TERRAIN[5][1] = 0.43620388271840094
// Q_TERRAIN[5][2] = 0.14465258387346325
// Q_TERRAIN[5][3] = 0.48073899447504176
// Q_TERRAIN[5][4] = 0.2696117344354053
// Q_TERRAIN[5][5] = 0.33891523862529616

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  -0.5904409709324143
// F_SLOPE[0][1] =  0.8819520021759981
// F_SLOPE[0][2] =  0.3812838822138165
// F_SLOPE[0][3] =  0.9331286246343908
// F_SLOPE[0][4] =  0.787483355152957
// F_SLOPE[0][5] =  -0.4024222042922645
// F_SLOPE[1][0] =  -0.2776201305552317
// F_SLOPE[1][1] =  -0.6680878857405088
// F_SLOPE[1][2] =  -0.708596180918635
// F_SLOPE[1][3] =  -0.8697205732486475
// F_SLOPE[1][4] =  -0.39728179846107503
// F_SLOPE[1][5] =  0.20621999481530873
// F_SLOPE[2][0] =  -0.9932337612512865
// F_SLOPE[2][1] =  0.35586849909538243
// F_SLOPE[2][2] =  -0.3242062767442697
// F_SLOPE[2][3] =  -0.3800841367937424
// F_SLOPE[2][4] =  0.6370361492941417
// F_SLOPE[2][5] =  -0.03850962673992209
// F_SLOPE[3][0] =  -0.3684137883071119
// F_SLOPE[3][1] =  -0.03756322752627228
// F_SLOPE[3][2] =  0.4093382682818185
// F_SLOPE[3][3] =  -0.8859981409284201
// F_SLOPE[3][4] =  0.9501991262884706
// F_SLOPE[3][5] =  -0.9542688734945586
// F_SLOPE[4][0] =  0.4995900445825465
// F_SLOPE[4][1] =  0.6897617787762593
// F_SLOPE[4][2] =  -0.9638649292429398
// F_SLOPE[4][3] =  0.5754766079608684
// F_SLOPE[4][4] =  -0.26763104831627893
// F_SLOPE[4][5] =  0.15703765811374915
// F_SLOPE[5][0] =  -0.9818432263609431
// F_SLOPE[5][1] =  -0.906545762602117
// F_SLOPE[5][2] =  -0.6381610240979043
// F_SLOPE[5][3] =  0.9103597991823327
// F_SLOPE[5][4] =  -0.6069566589739837
// F_SLOPE[5][5] =  0.5114728249026355

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.8593106391950422
// L_SLOPE[0][1]   =  0.8840876588553988
// L_SLOPE[0][2]   =  -0.31123637389397607
// L_SLOPE[0][3]   =  -0.29041358988417554
// L_SLOPE[0][4]   =  0.04940364138623998
// L_SLOPE[0][5]   =  0.5512060293979906
// L_SLOPE[1][0]   =  -0.7838942618703342
// L_SLOPE[1][1]   =  0.49679611296932613
// L_SLOPE[1][2]   =  0.5944533551826656
// L_SLOPE[1][3]   =  0.7193886383751602
// L_SLOPE[1][4]   =  -0.926736840114345
// L_SLOPE[1][5]   =  0.8916003700843675
// L_SLOPE[2][0]   =  -0.8176402716564628
// L_SLOPE[2][1]   =  -0.31851892899155554
// L_SLOPE[2][2]   =  0.2216550761852485
// L_SLOPE[2][3]   =  0.8361743710666243
// L_SLOPE[2][4]   =  -0.3200809467483108
// L_SLOPE[2][5]   =  0.8483952388555813
// L_SLOPE[3][0]   =  0.09028807419647777
// L_SLOPE[3][1]   =  -0.37509926131418614
// L_SLOPE[3][2]   =  -0.3664000286732456
// L_SLOPE[3][3]   =  -0.6450444489900229
// L_SLOPE[3][4]   =  -0.843607535558853
// L_SLOPE[3][5]   =  -0.7022639107535029
// L_SLOPE[4][0]   =  0.3783491746977503
// L_SLOPE[4][1]   =  0.9934536290734077
// L_SLOPE[4][2]   =  -0.6769410711507675
// L_SLOPE[4][3]   =  -0.9028956729030875
// L_SLOPE[4][4]   =  0.9733982175685347
// L_SLOPE[4][5]   =  0.06706148272166867
// L_SLOPE[5][0]   =  -0.18822395754119037
// L_SLOPE[5][1]   =  -0.5253267922914253
// L_SLOPE[5][2]   =  0.1879204413865938
// L_SLOPE[5][3]   =  0.6525910235972532
// L_SLOPE[5][4]   =  -0.0886697970186705
// L_SLOPE[5][5]   =  -0.1564854361768213
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 1;
    robrow : [0..6] init 1;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2173594515608579,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.09687154015577926 * pr) >= 0,
            0.14068936080495775 * pr + (- 0.688549152555149 * pl) >= 0,
            1 * pf + (- 0.2820015223857958 * pb) >= 0,
            0.4095590290675857 * pb + (- 0.688549152555149 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2173594515608579,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.09687154015577926 * pr) >= 0,
            0.14068936080495775 * pr + (- 0.688549152555149 * pl) >= 0,
            1 * pf + (- 0.2820015223857958 * pb) >= 0,
            0.4095590290675857 * pb + (- 1.0950967827245024 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2173594515608579,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.09687154015577926 * pr) >= 0,
            0.14068936080495775 * pr + (-0.688549152555149 * pl) >= 0,
            1 * pf + (-0.2820015223857958 * pb) >= 0,
            0.4095590290675857 * pb + (-0.688549152555149 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2173594515608579,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.09687154015577926 * pr) >= 0,
            0.14068936080495775 * pr + (- 0.688549152555149 * pl) >= 0,
            1 * pf + (- 0.2820015223857958 * pb) >= 0,
            0.4095590290675857 * pb + (- 0.688549152555149 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1359481152672417,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07292120786669308 * pr) >= 0,
            0.11591234114460125 * pr + (- 0.6291065053696353 * pl) >= 0,
            0.11804799782400188 * pf + (- 0.6291065053696353 * pb) >= 0,
            1 * pb + (- 0.07426476337694014 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1359481152672417,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07292120786669308 * pr) >= 0,
            0.11591234114460125 * pr + (- 0.6291065053696353 * pl) >= 0,
            0.11804799782400188 * pf + (- 0.6291065053696353 * pb) >= 0,
            1 * pb + (- 0.07426476337694014 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1359481152672417,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07292120786669308 * pr) >= 0,
            0.11591234114460125 * pr + (-0.6291065053696353 * pl) >= 0,
            0.11804799782400188 * pf + (-0.6291065053696353 * pb) >= 0,
            1 * pb + (-0.07426476337694014 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1359481152672417,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.07292120786669308 * pr) >= 0,
            0.11591234114460125 * pr + (- 0.6291065053696353 * pl) >= 0,
            0.11804799782400188 * pf + (- 0.6291065053696353 * pb) >= 0,
            1 * pb + (- 0.07426476337694014 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3154777956254784,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6887636261060239 * pl + (- 0.6024032172171516 * pr) >= 0,
            1 * pr + (- 0.41491342426842015 * pl) >= 0,
            0.6187161177861835 * pf + (- 0.6024032172171516 * pb) >= 0,
            1 * pb + (- 0.3727165798985031 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3154777956254784,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6887636261060239 * pl + (- 0.6024032172171516 * pr) >= 0,
            1 * pr + (- 0.41491342426842015 * pl) >= 0,
            0.6187161177861835 * pf + (- 0.6024032172171516 * pb) >= 0,
            1 * pb + (- 0.3727165798985031 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3154777956254784,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6887636261060239 * pl + (- 0.6024032172171516 * pr) >= 0,
            1 * pr + (-0.41491342426842015 * pl) >= 0,
            0.6187161177861835 * pf + (-0.6024032172171516 * pb) >= 0,
            1 * pb + (-0.3727165798985031 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3154777956254784,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6887636261060239 * pl + (- 0.6024032172171516 * pr) >= 0,
            1 * pr + (- 0.41491342426842015 * pl) >= 0,
            0.6187161177861835 * pf + (- 0.6024032172171516 * pb) >= 0,
            1 * pb + (- 0.3727165798985031 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.05250036770407007,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7095864101158245 * pl + (- 0.5287748581114748 * pr) >= 0,
            1 * pr + (- 0.3752114533268259 * pl) >= 0,
            0.06687137536560916 * pf + (- 0.5287748581114748 * pb) >= 0,
            1 * pb + (- 0.03535990202066916 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.05250036770407007,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7095864101158245 * pl + (- 0.5287748581114748 * pr) >= 0,
            1 * pr + (- 0.3752114533268259 * pl) >= 0,
            0.06687137536560916 * pf + (- 0.5287748581114748 * pb) >= 0,
            1 * pb + (- 0.03535990202066916 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.05250036770407007,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7095864101158245 * pl + (- 0.5287748581114748 * pr) >= 0,
            1 * pr + (-0.3752114533268259 * pl) >= 0,
            0.06687137536560916 * pf + (-0.5287748581114748 * pb) >= 0,
            1 * pb + (-0.03535990202066916 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.05250036770407007,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7095864101158245 * pl + (- 0.5287748581114748 * pr) >= 0,
            1 * pr + (- 0.3752114533268259 * pl) >= 0,
            0.06687137536560916 * pf + (- 0.5287748581114748 * pb) >= 0,
            1 * pb + (- 0.03535990202066916 * pf) >= 0
