//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.23728533934427404
// Q_TERRAIN[0][1] = 0.32873625132862766
// Q_TERRAIN[0][2] = 0.33320523556241904
// Q_TERRAIN[0][3] = 0.07130017646268388
// Q_TERRAIN[0][4] = 0.005430221545033975
// Q_TERRAIN[0][5] = 0.1873772460316822
// Q_TERRAIN[1][0] = 0.1370240697391657
// Q_TERRAIN[1][1] = 0.4051740261175419
// Q_TERRAIN[1][2] = 0.3452963265193423
// Q_TERRAIN[1][3] = 0.3007285193638666
// Q_TERRAIN[1][4] = 0.279095023876674
// Q_TERRAIN[1][5] = 0.3306605429360005
// Q_TERRAIN[2][0] = 0.0726513973550515
// Q_TERRAIN[2][1] = 0.2200273959623849
// Q_TERRAIN[2][2] = 0.08113366119444432
// Q_TERRAIN[2][3] = 0.4529864907646613
// Q_TERRAIN[2][4] = 0.029412163705433036
// Q_TERRAIN[2][5] = 0.4094100639210402
// Q_TERRAIN[3][0] = 0.037304816817938735
// Q_TERRAIN[3][1] = 0.34347275204677086
// Q_TERRAIN[3][2] = 0.1684997963958838
// Q_TERRAIN[3][3] = 0.20230714156432456
// Q_TERRAIN[3][4] = 0.4212016839062809
// Q_TERRAIN[3][5] = 0.009302150156001388
// Q_TERRAIN[4][0] = 0.030392348094484434
// Q_TERRAIN[4][1] = 0.45751682170497343
// Q_TERRAIN[4][2] = 0.25446295821385073
// Q_TERRAIN[4][3] = 0.04548899452929167
// Q_TERRAIN[4][4] = 0.4935669952027848
// Q_TERRAIN[4][5] = 0.4733565093716353
// Q_TERRAIN[5][0] = 0.056263818073513217
// Q_TERRAIN[5][1] = 0.2116033061270468
// Q_TERRAIN[5][2] = 0.06753475047458202
// Q_TERRAIN[5][3] = 0.15627034709613408
// Q_TERRAIN[5][4] = 0.3107259741357161
// Q_TERRAIN[5][5] = 0.08176206415949067

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.39366897770129117
// F_SLOPE[0][1] =  -0.8972933656699904
// F_SLOPE[0][2] =  -0.6575718148462824
// F_SLOPE[0][3] =  0.6313952965081153
// F_SLOPE[0][4] =  -0.19896260488869255
// F_SLOPE[0][5] =  -0.16231957572476685
// F_SLOPE[1][0] =  0.19194195374235679
// F_SLOPE[1][1] =  -0.046463510255569274
// F_SLOPE[1][2] =  -0.2308372178502507
// F_SLOPE[1][3] =  -0.9390112364183674
// F_SLOPE[1][4] =  0.45265485469496025
// F_SLOPE[1][5] =  0.9349177657345891
// F_SLOPE[2][0] =  0.9526075391069868
// F_SLOPE[2][1] =  0.32719208689874013
// F_SLOPE[2][2] =  -0.28730961768198293
// F_SLOPE[2][3] =  -0.27374288639229816
// F_SLOPE[2][4] =  0.38022892751685045
// F_SLOPE[2][5] =  0.3475456432983668
// F_SLOPE[3][0] =  -0.7723351977411257
// F_SLOPE[3][1] =  -0.5300551453943156
// F_SLOPE[3][2] =  -0.2733552400579151
// F_SLOPE[3][3] =  0.022701003748621718
// F_SLOPE[3][4] =  0.6202141458553372
// F_SLOPE[3][5] =  2.4246862656784884e-05
// F_SLOPE[4][0] =  -0.9437134656173696
// F_SLOPE[4][1] =  0.6451352366668501
// F_SLOPE[4][2] =  -0.13969124804862187
// F_SLOPE[4][3] =  0.03799460866661275
// F_SLOPE[4][4] =  -0.5556640971354492
// F_SLOPE[4][5] =  -0.14551389152581296
// F_SLOPE[5][0] =  -0.22350775890938568
// F_SLOPE[5][1] =  0.5438371540201958
// F_SLOPE[5][2] =  -0.7947736419246241
// F_SLOPE[5][3] =  0.09994273216487004
// F_SLOPE[5][4] =  -0.6439009446206543
// F_SLOPE[5][5] =  0.391791079547807

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.9263078207748769
// L_SLOPE[0][1]   =  -0.44690474125296276
// L_SLOPE[0][2]   =  -0.3116430252482325
// L_SLOPE[0][3]   =  0.2738592732828311
// L_SLOPE[0][4]   =  -0.8958823604283039
// L_SLOPE[0][5]   =  -0.08147592293760852
// L_SLOPE[1][0]   =  -0.5824131318977532
// L_SLOPE[1][1]   =  -0.4362084052617732
// L_SLOPE[1][2]   =  -0.0474751338817514
// L_SLOPE[1][3]   =  0.917496202223596
// L_SLOPE[1][4]   =  -0.03795098900925575
// L_SLOPE[1][5]   =  0.9117837546546521
// L_SLOPE[2][0]   =  -0.6648739954124778
// L_SLOPE[2][1]   =  0.8484994850882379
// L_SLOPE[2][2]   =  -0.2716144445255204
// L_SLOPE[2][3]   =  -0.6215354387992922
// L_SLOPE[2][4]   =  0.49705554872578683
// L_SLOPE[2][5]   =  0.8240837843256221
// L_SLOPE[3][0]   =  -0.9866514958784265
// L_SLOPE[3][1]   =  -0.46349190301518384
// L_SLOPE[3][2]   =  0.541345518847903
// L_SLOPE[3][3]   =  -0.3164205226370691
// L_SLOPE[3][4]   =  -0.5168265432872483
// L_SLOPE[3][5]   =  -0.9827402904420104
// L_SLOPE[4][0]   =  -0.9199541174239558
// L_SLOPE[4][1]   =  0.23815418952790623
// L_SLOPE[4][2]   =  0.967630138411405
// L_SLOPE[4][3]   =  0.9969902716064794
// L_SLOPE[4][4]   =  0.007198961895803269
// L_SLOPE[4][5]   =  -0.9521808635069866
// L_SLOPE[5][0]   =  -0.3550871479218338
// L_SLOPE[5][1]   =  0.57480427128952
// L_SLOPE[5][2]   =  0.6639085602676933
// L_SLOPE[5][3]   =  0.2788221257643011
// L_SLOPE[5][4]   =  -0.5409715505812323
// L_SLOPE[5][5]   =  0.05447415265741573
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 5;
    robrow : [0..6] init 5;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28505558783822016,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.07369217922512306 * pl + (- 0.762714660655726 * pr) >= 0,
            1 * pr + (- 0.056206105470670675 * pl) >= 0,
            0.6063310222987088 * pf + (- 0.762714660655726 * pb) >= 0,
            1 * pb + (- 0.4624575599175991 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28505558783822016,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.07369217922512306 * pl + (- 0.762714660655726 * pr) >= 0,
            1 * pr + (- 0.056206105470670675 * pl) >= 0,
            0.6063310222987088 * pf + (- 0.762714660655726 * pb) >= 0,
            1 * pb + (- 0.4624575599175991 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28505558783822016,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.07369217922512306 * pl + (- 0.762714660655726 * pr) >= 0,
            1 * pr + (-0.056206105470670675 * pl) >= 0,
            0.6063310222987088 * pf + (-0.762714660655726 * pb) >= 0,
            1 * pb + (-0.4624575599175991 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28505558783822016,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.07369217922512306 * pl + (- 0.762714660655726 * pr) >= 0,
            1 * pr + (- 0.056206105470670675 * pl) >= 0,
            0.6063310222987088 * pf + (- 0.762714660655726 * pb) >= 0,
            1 * pb + (- 0.4624575599175991 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1996670249162693,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5530952587470372 * pl + (- 0.6712637486713724 * pr) >= 0,
            1 * pr + (- 0.3712727967588989 * pl) >= 0,
            1 * pf + (- 0.0689432403737821 * pb) >= 0,
            0.1027066343300096 * pb + (- 0.6712637486713724 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1996670249162693,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5530952587470372 * pl + (- 0.6712637486713724 * pr) >= 0,
            1 * pr + (- 0.3712727967588989 * pl) >= 0,
            1 * pf + (- 0.0689432403737821 * pb) >= 0,
            0.1027066343300096 * pb + (- 1.2735842569689626 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1996670249162693,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5530952587470372 * pl + (- 0.6712637486713724 * pr) >= 0,
            1 * pr + (-0.3712727967588989 * pl) >= 0,
            1 * pf + (-0.0689432403737821 * pb) >= 0,
            0.1027066343300096 * pb + (-0.6712637486713724 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1996670249162693,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.5530952587470372 * pl + (- 0.6712637486713724 * pr) >= 0,
            1 * pr + (- 0.3712727967588989 * pl) >= 0,
            1 * pf + (- 0.0689432403737821 * pb) >= 0,
            0.1027066343300096 * pb + (- 0.6712637486713724 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28465117923865657,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6883569747517675 * pl + (- 0.6667947644375809 * pr) >= 0,
            1 * pr + (- 0.4589928268285706 * pl) >= 0,
            1 * pf + (- 0.2283293210563615 * pb) >= 0,
            0.34242818515371765 * pb + (- 0.6667947644375809 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28465117923865657,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6883569747517675 * pl + (- 0.6667947644375809 * pr) >= 0,
            1 * pr + (- 0.4589928268285706 * pl) >= 0,
            1 * pf + (- 0.2283293210563615 * pb) >= 0,
            0.34242818515371765 * pb + (- 1.1052602078188003 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28465117923865657,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6883569747517675 * pl + (- 0.6667947644375809 * pr) >= 0,
            1 * pr + (-0.4589928268285706 * pl) >= 0,
            1 * pf + (-0.2283293210563615 * pb) >= 0,
            0.34242818515371765 * pb + (-0.6667947644375809 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.28465117923865657,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6883569747517675 * pl + (- 0.6667947644375809 * pr) >= 0,
            1 * pr + (- 0.4589928268285706 * pl) >= 0,
            1 * pf + (- 0.2283293210563615 * pb) >= 0,
            0.34242818515371765 * pb + (- 0.6667947644375809 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5625292671697979,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6743667647654932 * pr) >= 0,
            0.7261407267171689 * pr + (- 0.9286998235373161 * pl) >= 0,
            0.3686047034918847 * pf + (- 0.9286998235373161 * pb) >= 0,
            1 * pb + (- 0.342323123087938 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5625292671697979,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6743667647654932 * pr) >= 0,
            0.7261407267171689 * pr + (- 0.9286998235373161 * pl) >= 0,
            0.3686047034918847 * pf + (- 0.9286998235373161 * pb) >= 0,
            1 * pb + (- 0.342323123087938 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5625292671697979,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6743667647654932 * pr) >= 0,
            0.7261407267171689 * pr + (-0.9286998235373161 * pl) >= 0,
            0.3686047034918847 * pf + (-0.9286998235373161 * pb) >= 0,
            1 * pb + (-0.342323123087938 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5625292671697979,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6743667647654932 * pr) >= 0,
            0.7261407267171689 * pr + (- 0.9286998235373161 * pl) >= 0,
            0.3686047034918847 * pf + (- 0.9286998235373161 * pb) >= 0,
            1 * pb + (- 0.342323123087938 * pf) >= 0
