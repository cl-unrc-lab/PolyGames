//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.28570129734495675
// Q_TERRAIN[0][1] = 0.2144445273375573
// Q_TERRAIN[0][2] = 0.2890456505672352
// Q_TERRAIN[0][3] = 0.10304911606975087
// Q_TERRAIN[0][4] = 0.40666062567866
// Q_TERRAIN[0][5] = 0.41179443626672274
// Q_TERRAIN[1][0] = 0.3267362669505879
// Q_TERRAIN[1][1] = 0.08011477825940982
// Q_TERRAIN[1][2] = 0.2603346798199623
// Q_TERRAIN[1][3] = 0.16388640581104658
// Q_TERRAIN[1][4] = 0.12499833834320018
// Q_TERRAIN[1][5] = 0.47640845457295583
// Q_TERRAIN[2][0] = 0.4982784962697276
// Q_TERRAIN[2][1] = 0.022278191225216515
// Q_TERRAIN[2][2] = 0.4300805186431455
// Q_TERRAIN[2][3] = 0.3015953054840925
// Q_TERRAIN[2][4] = 0.19080299295955894
// Q_TERRAIN[2][5] = 0.14180910895335758
// Q_TERRAIN[3][0] = 0.337482423567478
// Q_TERRAIN[3][1] = 0.22841557552915281
// Q_TERRAIN[3][2] = 0.34293074273729734
// Q_TERRAIN[3][3] = 0.33092316002617556
// Q_TERRAIN[3][4] = 0.0664890723561064
// Q_TERRAIN[3][5] = 0.38391890697199527
// Q_TERRAIN[4][0] = 0.49120662450559543
// Q_TERRAIN[4][1] = 0.4846940802024594
// Q_TERRAIN[4][2] = 0.3066634102733545
// Q_TERRAIN[4][3] = 0.02213031643231045
// Q_TERRAIN[4][4] = 0.002027572079203732
// Q_TERRAIN[4][5] = 0.06698626352456694
// Q_TERRAIN[5][0] = 0.470501135697917
// Q_TERRAIN[5][1] = 0.15143028101453615
// Q_TERRAIN[5][2] = 0.1830728008302132
// Q_TERRAIN[5][3] = 0.44909812226959417
// Q_TERRAIN[5][4] = 0.15718190247822533
// Q_TERRAIN[5][5] = 0.27449109200620275

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  -0.1279380847517555
// F_SLOPE[0][1] =  -0.8700116477462989
// F_SLOPE[0][2] =  0.1690924514038603
// F_SLOPE[0][3] =  0.6881357953238043
// F_SLOPE[0][4] =  -0.6871621632251872
// F_SLOPE[0][5] =  -0.551402062627917
// F_SLOPE[1][0] =  -0.17425958457031854
// F_SLOPE[1][1] =  -0.926150261882742
// F_SLOPE[1][2] =  -0.006793002766903644
// F_SLOPE[1][3] =  0.6359657288592637
// F_SLOPE[1][4] =  0.3157818775182182
// F_SLOPE[1][5] =  0.06696747130554415
// F_SLOPE[2][0] =  0.7102514815472001
// F_SLOPE[2][1] =  -0.7006237300571969
// F_SLOPE[2][2] =  0.13447095372624784
// F_SLOPE[2][3] =  -0.25165036450382217
// F_SLOPE[2][4] =  0.2026090942272789
// F_SLOPE[2][5] =  -0.7741685962111275
// F_SLOPE[3][0] =  0.5510254021456558
// F_SLOPE[3][1] =  -0.8067883336312947
// F_SLOPE[3][2] =  -0.6672725084135049
// F_SLOPE[3][3] =  0.6148995040495113
// F_SLOPE[3][4] =  0.8953878484469815
// F_SLOPE[3][5] =  -0.13353699489702842
// F_SLOPE[4][0] =  -0.17183833650339753
// F_SLOPE[4][1] =  -0.5090362477184898
// F_SLOPE[4][2] =  -0.45059321606884595
// F_SLOPE[4][3] =  0.23450554194833262
// F_SLOPE[4][4] =  -0.6430791785585495
// F_SLOPE[4][5] =  -0.7610349913384458
// F_SLOPE[5][0] =  -0.08853028263792351
// F_SLOPE[5][1] =  -0.6701243868407356
// F_SLOPE[5][2] =  0.2974496624324541
// F_SLOPE[5][3] =  0.6421113487229939
// F_SLOPE[5][4] =  0.5550227787507986
// F_SLOPE[5][5] =  -0.03973321955130493

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.30485748755836606
// L_SLOPE[0][1]   =  -0.1305789020111312
// L_SLOPE[0][2]   =  -0.9899828501813033
// L_SLOPE[0][3]   =  0.42514640157927475
// L_SLOPE[0][4]   =  -0.3366855547290091
// L_SLOPE[0][5]   =  -0.3611535244789321
// L_SLOPE[1][0]   =  -0.8401499351595749
// L_SLOPE[1][1]   =  -0.10388814799796786
// L_SLOPE[1][2]   =  0.1656979346011882
// L_SLOPE[1][3]   =  -0.218826116314232
// L_SLOPE[1][4]   =  0.7390910907948056
// L_SLOPE[1][5]   =  0.3467064334970258
// L_SLOPE[2][0]   =  -0.5171835163783902
// L_SLOPE[2][1]   =  0.0507076977531804
// L_SLOPE[2][2]   =  0.8210676352931949
// L_SLOPE[2][3]   =  0.040219388642825704
// L_SLOPE[2][4]   =  0.2042097374778986
// L_SLOPE[2][5]   =  -0.8744527523769581
// L_SLOPE[3][0]   =  -0.021227766956471328
// L_SLOPE[3][1]   =  -0.07711747440713124
// L_SLOPE[3][2]   =  -0.19774023986219524
// L_SLOPE[3][3]   =  -0.15912928370695578
// L_SLOPE[3][4]   =  0.16987009866879155
// L_SLOPE[3][5]   =  0.07733409684628634
// L_SLOPE[4][0]   =  -0.02020848241812745
// L_SLOPE[4][1]   =  -0.6684071189355847
// L_SLOPE[4][2]   =  -0.117306365092825
// L_SLOPE[4][3]   =  0.937356397121885
// L_SLOPE[4][4]   =  -0.1696526135643346
// L_SLOPE[4][5]   =  -0.9293643404243377
// L_SLOPE[5][0]   =  -0.9943391466352594
// L_SLOPE[5][1]   =  0.07083690263242581
// L_SLOPE[5][2]   =  -0.8988541163558073
// L_SLOPE[5][3]   =  -0.8145131893156166
// L_SLOPE[5][4]   =  -0.7824871747460618
// L_SLOPE[5][5]   =  -0.09184333930236055
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 2;
    robrow : [0..6] init 2;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5174023580402072,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6951425124416339 * pl + (- 0.7142987026550432 * pr) >= 0,
            1 * pr + (- 0.49653939479742637 * pl) >= 0,
            1 * pf + (- 0.6229126946966933 * pb) >= 0,
            0.8720619152482445 * pb + (- 0.7142987026550432 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5174023580402072,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6951425124416339 * pl + (- 0.7142987026550432 * pr) >= 0,
            1 * pr + (- 0.49653939479742637 * pl) >= 0,
            1 * pf + (- 0.6229126946966933 * pb) >= 0,
            0.8720619152482445 * pb + (- 0.8056847106133932 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5174023580402072,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6951425124416339 * pl + (- 0.7142987026550432 * pr) >= 0,
            1 * pr + (-0.49653939479742637 * pl) >= 0,
            1 * pf + (-0.6229126946966933 * pb) >= 0,
            0.8720619152482445 * pb + (-0.7142987026550432 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5174023580402072,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.6951425124416339 * pl + (- 0.7142987026550432 * pr) >= 0,
            1 * pr + (- 0.49653939479742637 * pl) >= 0,
            1 * pf + (- 0.6229126946966933 * pb) >= 0,
            0.8720619152482445 * pb + (- 0.7142987026550432 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.342062780633531,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8694210979888688 * pl + (- 0.7855554726624427 * pr) >= 0,
            1 * pr + (- 0.6829785015733458 * pl) >= 0,
            1 * pf + (- 0.10211306149526826 * pb) >= 0,
            0.1299883522537011 * pb + (- 0.7855554726624427 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.342062780633531,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8694210979888688 * pl + (- 0.7855554726624427 * pr) >= 0,
            1 * pr + (- 0.6829785015733458 * pl) >= 0,
            1 * pf + (- 0.10211306149526826 * pb) >= 0,
            0.1299883522537011 * pb + (- 1.4689978838296172 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.342062780633531,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8694210979888688 * pl + (- 0.7855554726624427 * pr) >= 0,
            1 * pr + (-0.6829785015733458 * pl) >= 0,
            1 * pf + (-0.10211306149526826 * pb) >= 0,
            0.1299883522537011 * pb + (-0.7855554726624427 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.342062780633531,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.8694210979888688 * pl + (- 0.7855554726624427 * pr) >= 0,
            1 * pr + (- 0.6829785015733458 * pl) >= 0,
            1 * pf + (- 0.10211306149526826 * pb) >= 0,
            0.1299883522537011 * pb + (- 0.7855554726624427 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.21511601213265164,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.010017149818696724 * pl + (- 0.7109543494327648 * pr) >= 0,
            1 * pr + (- 0.007121736232522068 * pl) >= 0,
            0.8309075485961397 * pf + (- 0.7109543494327648 * pb) >= 0,
            1 * pb + (- 0.5907373356509419 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.21511601213265164,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.010017149818696724 * pl + (- 0.7109543494327648 * pr) >= 0,
            1 * pr + (- 0.007121736232522068 * pl) >= 0,
            0.8309075485961397 * pf + (- 0.7109543494327648 * pb) >= 0,
            1 * pb + (- 0.5907373356509419 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.21511601213265164,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.010017149818696724 * pl + (- 0.7109543494327648 * pr) >= 0,
            1 * pr + (-0.007121736232522068 * pl) >= 0,
            0.8309075485961397 * pf + (-0.7109543494327648 * pb) >= 0,
            1 * pb + (-0.5907373356509419 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.21511601213265164,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.010017149818696724 * pl + (- 0.7109543494327648 * pr) >= 0,
            1 * pr + (- 0.007121736232522068 * pl) >= 0,
            0.8309075485961397 * pf + (- 0.7109543494327648 * pb) >= 0,
            1 * pb + (- 0.5907373356509419 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.48658901406861343,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.515615443233954 * pr) >= 0,
            0.5748535984207253 * pr + (- 0.8969508839302491 * pl) >= 0,
            0.3118642046761957 * pf + (- 0.8969508839302491 * pb) >= 0,
            1 * pb + (- 0.2797268740505179 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.48658901406861343,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.515615443233954 * pr) >= 0,
            0.5748535984207253 * pr + (- 0.8969508839302491 * pl) >= 0,
            0.3118642046761957 * pf + (- 0.8969508839302491 * pb) >= 0,
            1 * pb + (- 0.2797268740505179 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.48658901406861343,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.515615443233954 * pr) >= 0,
            0.5748535984207253 * pr + (-0.8969508839302491 * pl) >= 0,
            0.3118642046761957 * pf + (-0.8969508839302491 * pb) >= 0,
            1 * pb + (-0.2797268740505179 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.48658901406861343,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.515615443233954 * pr) >= 0,
            0.5748535984207253 * pr + (- 0.8969508839302491 * pl) >= 0,
            0.3118642046761957 * pf + (- 0.8969508839302491 * pb) >= 0,
