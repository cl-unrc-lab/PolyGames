//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.4780171359446247
// Q_TERRAIN[0][1] = 0.4739137435296747
// Q_TERRAIN[0][2] = 0.028275683863404344
// Q_TERRAIN[0][3] = 0.042435997579460816
// Q_TERRAIN[0][4] = 0.4177494390647248
// Q_TERRAIN[0][5] = 0.36798499453426164
// Q_TERRAIN[1][0] = 0.33486520072011045
// Q_TERRAIN[1][1] = 0.1540682287945721
// Q_TERRAIN[1][2] = 0.3029720828392312
// Q_TERRAIN[1][3] = 0.30340086682041895
// Q_TERRAIN[1][4] = 0.29060200855600155
// Q_TERRAIN[1][5] = 0.07919143512740279
// Q_TERRAIN[2][0] = 0.21533482014563432
// Q_TERRAIN[2][1] = 0.19676591010268568
// Q_TERRAIN[2][2] = 0.3615060406187329
// Q_TERRAIN[2][3] = 0.49740978147487136
// Q_TERRAIN[2][4] = 0.4746977365466218
// Q_TERRAIN[2][5] = 0.2720885237146604
// Q_TERRAIN[3][0] = 0.2224270943629268
// Q_TERRAIN[3][1] = 0.13412037082466405
// Q_TERRAIN[3][2] = 0.017962164696428806
// Q_TERRAIN[3][3] = 0.013722428545409504
// Q_TERRAIN[3][4] = 0.23244693104865605
// Q_TERRAIN[3][5] = 0.1592325639268387
// Q_TERRAIN[4][0] = 0.1900074609503558
// Q_TERRAIN[4][1] = 0.4458947289141437
// Q_TERRAIN[4][2] = 0.26287638457301415
// Q_TERRAIN[4][3] = 0.28025518051324944
// Q_TERRAIN[4][4] = 0.11806170355753104
// Q_TERRAIN[4][5] = 0.011929039570391098
// Q_TERRAIN[5][0] = 0.16257146438058
// Q_TERRAIN[5][1] = 0.06834869649323333
// Q_TERRAIN[5][2] = 0.2551119229186006
// Q_TERRAIN[5][3] = 0.499341784096276
// Q_TERRAIN[5][4] = 0.33723984867293505
// Q_TERRAIN[5][5] = 0.09092174841157219

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.787143073165977
// F_SLOPE[0][1] =  0.5935198428432791
// F_SLOPE[0][2] =  0.4688033837879555
// F_SLOPE[0][3] =  0.8131872997951219
// F_SLOPE[0][4] =  0.525770967666142
// F_SLOPE[0][5] =  0.5794952749235265
// F_SLOPE[1][0] =  -0.292426044316793
// F_SLOPE[1][1] =  0.9619531461442532
// F_SLOPE[1][2] =  0.9238018757964515
// F_SLOPE[1][3] =  -0.6776306933919622
// F_SLOPE[1][4] =  0.5080081433037442
// F_SLOPE[1][5] =  0.43030179647490696
// F_SLOPE[2][0] =  -0.07718660451604475
// F_SLOPE[2][1] =  0.06071143224689002
// F_SLOPE[2][2] =  -0.01997215629961735
// F_SLOPE[2][3] =  0.8496641441891406
// F_SLOPE[2][4] =  0.0016821252613097304
// F_SLOPE[2][5] =  0.6630489795836245
// F_SLOPE[3][0] =  -0.2921515902625682
// F_SLOPE[3][1] =  0.7657018371625062
// F_SLOPE[3][2] =  0.7994011775132515
// F_SLOPE[3][3] =  -0.07797567023672469
// F_SLOPE[3][4] =  0.13541014084048864
// F_SLOPE[3][5] =  0.8406608783838576
// F_SLOPE[4][0] =  0.4475459077440367
// F_SLOPE[4][1] =  -0.026782890276829896
// F_SLOPE[4][2] =  -0.5563779780179783
// F_SLOPE[4][3] =  -0.350665512462204
// F_SLOPE[4][4] =  0.39914327614048717
// F_SLOPE[4][5] =  -0.6678606290117477
// F_SLOPE[5][0] =  0.8158809932521891
// F_SLOPE[5][1] =  -0.4637249742003673
// F_SLOPE[5][2] =  0.8227556717360935
// F_SLOPE[5][3] =  -0.3808737501010786
// F_SLOPE[5][4] =  0.914723423112316
// F_SLOPE[5][5] =  0.4124116127352093

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  0.008497633966635165
// L_SLOPE[0][1]   =  0.035495512297104126
// L_SLOPE[0][2]   =  0.30282879793358153
// L_SLOPE[0][3]   =  0.1758894235889692
// L_SLOPE[0][4]   =  -0.3763113508979996
// L_SLOPE[0][5]   =  -0.5843630509241455
// L_SLOPE[1][0]   =  0.023783316710564995
// L_SLOPE[1][1]   =  0.8683087182675573
// L_SLOPE[1][2]   =  0.24653017345174466
// L_SLOPE[1][3]   =  -0.8492492618519092
// L_SLOPE[1][4]   =  0.6407999894240337
// L_SLOPE[1][5]   =  0.4518985749545963
// L_SLOPE[2][0]   =  0.8153072419026417
// L_SLOPE[2][1]   =  -0.617194533391765
// L_SLOPE[2][2]   =  0.4895654485547083
// L_SLOPE[2][3]   =  -0.8824822072026886
// L_SLOPE[2][4]   =  0.30581985486909935
// L_SLOPE[2][5]   =  -0.4538005353257013
// L_SLOPE[3][0]   =  -0.5467669415104739
// L_SLOPE[3][1]   =  0.7509823428964757
// L_SLOPE[3][2]   =  -0.7874680347089502
// L_SLOPE[3][3]   =  0.04472533071785989
// L_SLOPE[3][4]   =  0.7078860143697441
// L_SLOPE[3][5]   =  -0.5103360440619662
// L_SLOPE[4][0]   =  -0.579042122608707
// L_SLOPE[4][1]   =  0.7611635187325598
// L_SLOPE[4][2]   =  -0.15416470322060793
// L_SLOPE[4][3]   =  0.43392219780995056
// L_SLOPE[4][4]   =  -0.9362538597465098
// L_SLOPE[4][5]   =  -0.2752861773935187
// L_SLOPE[5][0]   =  -0.6562380157485352
// L_SLOPE[5][1]   =  0.34553088282708355
// L_SLOPE[5][2]   =  -0.8341936451908489
// L_SLOPE[5][3]   =  0.9091243306914953
// L_SLOPE[5][4]   =  -0.9493105703461979
// L_SLOPE[5][5]   =  0.45884701488360813
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 3;
    robrow : [0..6] init 3;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.12750693734663765,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5175472447397769 * pr) >= 0,
            0.9915023660333648 * pr + (- 0.5219828640553753 * pl) >= 0,
            0.21285692683402302 * pf + (- 0.5219828640553753 * pb) >= 0,
            1 * pb + (- 0.11110766830284881 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.12750693734663765,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5175472447397769 * pr) >= 0,
            0.9915023660333648 * pr + (- 0.5219828640553753 * pl) >= 0,
            0.21285692683402302 * pf + (- 0.5219828640553753 * pb) >= 0,
            1 * pb + (- 0.11110766830284881 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.12750693734663765,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5175472447397769 * pr) >= 0,
            0.9915023660333648 * pr + (-0.5219828640553753 * pl) >= 0,
            0.21285692683402302 * pf + (-0.5219828640553753 * pb) >= 0,
            1 * pb + (-0.11110766830284881 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.12750693734663765,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5175472447397769 * pr) >= 0,
            0.9915023660333648 * pr + (- 0.5219828640553753 * pl) >= 0,
            0.21285692683402302 * pf + (- 0.5219828640553753 * pb) >= 0,
            1 * pb + (- 0.11110766830284881 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22211222434024314,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5074125552844454 * pr) >= 0,
            0.9645044877028959 * pr + (- 0.5260862564703253 * pl) >= 0,
            0.4064801571567209 * pf + (- 0.5260862564703253 * pb) >= 0,
            1 * pb + (- 0.2138436242080488 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22211222434024314,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5074125552844454 * pr) >= 0,
            0.9645044877028959 * pr + (- 0.5260862564703253 * pl) >= 0,
            0.4064801571567209 * pf + (- 0.5260862564703253 * pb) >= 0,
            1 * pb + (- 0.2138436242080488 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22211222434024314,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5074125552844454 * pr) >= 0,
            0.9645044877028959 * pr + (-0.5260862564703253 * pl) >= 0,
            0.4064801571567209 * pf + (-0.5260862564703253 * pb) >= 0,
            1 * pb + (-0.2138436242080488 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.22211222434024314,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5074125552844454 * pr) >= 0,
            0.9645044877028959 * pr + (- 0.5260862564703253 * pl) >= 0,
            0.4064801571567209 * pf + (- 0.5260862564703253 * pb) >= 0,
            1 * pb + (- 0.2138436242080488 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6568918078656782,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6774582095581188 * pr) >= 0,
            0.6971712020664185 * pr + (- 0.9717243161365956 * pl) >= 0,
            0.5311966162120445 * pf + (- 0.9717243161365956 * pb) >= 0,
            1 * pb + (- 0.5161766686227226 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6568918078656782,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6774582095581188 * pr) >= 0,
            0.6971712020664185 * pr + (- 0.9717243161365956 * pl) >= 0,
            0.5311966162120445 * pf + (- 0.9717243161365956 * pb) >= 0,
            1 * pb + (- 0.5161766686227226 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6568918078656782,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6774582095581188 * pr) >= 0,
            0.6971712020664185 * pr + (-0.9717243161365956 * pl) >= 0,
            0.5311966162120445 * pf + (-0.9717243161365956 * pb) >= 0,
            1 * pb + (-0.5161766686227226 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6568918078656782,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6774582095581188 * pr) >= 0,
            0.6971712020664185 * pr + (- 0.9717243161365956 * pl) >= 0,
            0.5311966162120445 * pf + (- 0.9717243161365956 * pb) >= 0,
            1 * pb + (- 0.5161766686227226 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5345411634439108,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.7891386219852442 * pr) >= 0,
            0.8241105764110308 * pr + (- 0.9575640024205392 * pl) >= 0,
            0.18681270020487806 * pf + (- 0.9575640024205392 * pb) >= 0,
            1 * pb + (- 0.17888511691117132 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5345411634439108,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.7891386219852442 * pr) >= 0,
            0.8241105764110308 * pr + (- 0.9575640024205392 * pl) >= 0,
            0.18681270020487806 * pf + (- 0.9575640024205392 * pb) >= 0,
            1 * pb + (- 0.17888511691117132 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5345411634439108,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.7891386219852442 * pr) >= 0,
            0.8241105764110308 * pr + (-0.9575640024205392 * pl) >= 0,
            0.18681270020487806 * pf + (-0.9575640024205392 * pb) >= 0,
            1 * pb + (-0.17888511691117132 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5345411634439108,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.7891386219852442 * pr) >= 0,
            0.8241105764110308 * pr + (- 0.9575640024205392 * pl) >= 0,
            0.18681270020487806 * pf + (- 0.9575640024205392 * pb) >= 0,
            1 * pb + (- 0.17888511691117132 * pf) >= 0
