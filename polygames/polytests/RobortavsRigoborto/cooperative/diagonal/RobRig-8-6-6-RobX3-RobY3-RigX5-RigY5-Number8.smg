//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // Q_TERRAIN[0][0] = 0.1133529296905244
// Q_TERRAIN[0][1] = 0.4811475179171914
// Q_TERRAIN[0][2] = 0.06316544932542978
// Q_TERRAIN[0][3] = 0.35240846143580395
// Q_TERRAIN[0][4] = 0.04259263402537633
// Q_TERRAIN[0][5] = 0.12372049246454253
// Q_TERRAIN[1][0] = 0.4995642695812895
// Q_TERRAIN[1][1] = 0.1046988159444564
// Q_TERRAIN[1][2] = 0.3209342175360535
// Q_TERRAIN[1][3] = 0.22956688138619835
// Q_TERRAIN[1][4] = 0.22656621556907142
// Q_TERRAIN[1][5] = 0.24749134694458885
// Q_TERRAIN[2][0] = 0.09611542112134108
// Q_TERRAIN[2][1] = 0.41526063681648584
// Q_TERRAIN[2][2] = 0.0447828117202948
// Q_TERRAIN[2][3] = 0.11709147974485268
// Q_TERRAIN[2][4] = 0.009995653112090386
// Q_TERRAIN[2][5] = 0.1333837305015989
// Q_TERRAIN[3][0] = 0.20383193148047857
// Q_TERRAIN[3][1] = 0.45103215020581416
// Q_TERRAIN[3][2] = 0.18953771042079454
// Q_TERRAIN[3][3] = 0.05686546364039996
// Q_TERRAIN[3][4] = 0.12917835301595637
// Q_TERRAIN[3][5] = 0.49580119853553395
// Q_TERRAIN[4][0] = 0.03154434035110926
// Q_TERRAIN[4][1] = 0.3100839809683421
// Q_TERRAIN[4][2] = 0.18860256712037665
// Q_TERRAIN[4][3] = 0.33042158580591624
// Q_TERRAIN[4][4] = 0.16921929357357018
// Q_TERRAIN[4][5] = 0.3456502858029861
// Q_TERRAIN[5][0] = 0.24879026749503602
// Q_TERRAIN[5][1] = 0.32486068277363156
// Q_TERRAIN[5][2] = 0.45068748000232994
// Q_TERRAIN[5][3] = 0.2907682724609699
// Q_TERRAIN[5][4] = 0.0710689895105232
// Q_TERRAIN[5][5] = 0.03218674860788823

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                // F_SLOPE[0][0] =  0.8921028679231529
// F_SLOPE[0][1] =  -0.022666339549128
// F_SLOPE[0][2] =  -0.612292004403356
// F_SLOPE[0][3] =  0.8920886495755991
// F_SLOPE[0][4] =  0.15792357111369326
// F_SLOPE[0][5] =  0.45788291967461037
// F_SLOPE[1][0] =  0.7619193709662098
// F_SLOPE[1][1] =  -0.42869353954017075
// F_SLOPE[1][2] =  -0.2866065225744312
// F_SLOPE[1][3] =  0.7561530087310069
// F_SLOPE[1][4] =  -0.7300485348954835
// F_SLOPE[1][5] =  0.5285905987219792
// F_SLOPE[2][0] =  -0.804767019572735
// F_SLOPE[2][1] =  0.38036251535693744
// F_SLOPE[2][2] =  0.40429083044872427
// F_SLOPE[2][3] =  0.8999994642124542
// F_SLOPE[2][4] =  0.6869859322105631
// F_SLOPE[2][5] =  0.00724280810334843
// F_SLOPE[3][0] =  -0.6047036899806366
// F_SLOPE[3][1] =  -0.6996802634635706
// F_SLOPE[3][2] =  0.05744038945964691
// F_SLOPE[3][3] =  0.01958164061689649
// F_SLOPE[3][4] =  -0.85715833592233
// F_SLOPE[3][5] =  0.8064412602293789
// F_SLOPE[4][0] =  0.014834462300910456
// F_SLOPE[4][1] =  0.40258955277406994
// F_SLOPE[4][2] =  -0.560089940664136
// F_SLOPE[4][3] =  -0.5122274323120088
// F_SLOPE[4][4] =  -0.9761676446243126
// F_SLOPE[4][5] =  -0.31353744536949235
// F_SLOPE[5][0] =  -0.4663154030791883
// F_SLOPE[5][1] =  -0.15319628633897264
// F_SLOPE[5][2] =  -0.2461478963739705
// F_SLOPE[5][3] =  0.6686324135273076
// F_SLOPE[5][4] =  0.7829354318517385
// F_SLOPE[5][5] =  -0.6494980207466972

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                // L_SLOPE[0][0]   =  -0.2074721140226392
// L_SLOPE[0][1]   =  -0.6676366935291316
// L_SLOPE[0][2]   =  0.3263428487197886
// L_SLOPE[0][3]   =  0.9496910575871669
// L_SLOPE[0][4]   =  -0.5963834826190173
// L_SLOPE[0][5]   =  0.5329494798284093
// L_SLOPE[1][0]   =  -0.3999104929494397
// L_SLOPE[1][1]   =  -0.9735647470292763
// L_SLOPE[1][2]   =  0.528596332377981
// L_SLOPE[1][3]   =  -0.3163681501687068
// L_SLOPE[1][4]   =  -0.6596859608720873
// L_SLOPE[1][5]   =  -0.12878540299635222
// L_SLOPE[2][0]   =  -0.536561487033391
// L_SLOPE[2][1]   =  -0.17979804331068272
// L_SLOPE[2][2]   =  -0.10789326716728587
// L_SLOPE[2][3]   =  -0.1640769082287028
// L_SLOPE[2][4]   =  0.1770174364741961
// L_SLOPE[2][5]   =  -0.4225114030116197
// L_SLOPE[3][0]   =  -0.8097765589649513
// L_SLOPE[3][1]   =  -0.8294882526515002
// L_SLOPE[3][2]   =  -0.7869531845408675
// L_SLOPE[3][3]   =  0.04188906442052165
// L_SLOPE[3][4]   =  -0.27967221805965337
// L_SLOPE[3][5]   =  0.6153996428320101
// L_SLOPE[4][0]   =  0.009846590284098289
// L_SLOPE[4][1]   =  0.41635468823511945
// L_SLOPE[4][2]   =  0.9601431281036623
// L_SLOPE[4][3]   =  -0.8740521939146542
// L_SLOPE[4][4]   =  -0.9661156250146792
// L_SLOPE[4][5]   =  -0.7192185917378564
// L_SLOPE[5][0]   =  -0.2273340872197258
// L_SLOPE[5][1]   =  0.14734213234110038
// L_SLOPE[5][2]   =  0.4875038757832493
// L_SLOPE[5][3]   =  -0.297111476578795
// L_SLOPE[5][4]   =  0.9299241954988853
// L_SLOPE[5][5]   =  -0.9941196345411767
smg
player p1
   roborta, [robl], [robr], [robf], [robb]
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb]
endplayer

const int LENGTH = 6;
global sched : [0..1] init 0;

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..5] init 3;
    robrow : [0..6] init 3;
    [robl] (sched = 0) & (robrow = 0) & (robcol = 0) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.42940281330341745,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7925278859773608 * pl + (- 0.8866470703094755 * pr) >= 0,
            1 * pr + (- 0.7026925282403891 * pl) >= 0,
            0.10789713207684715 * pf + (- 0.8866470703094755 * pb) >= 0,
            1 * pb + (- 0.09566667605073106 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 0 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.42940281330341745,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7925278859773608 * pl + (- 0.8866470703094755 * pr) >= 0,
            1 * pr + (- 0.7026925282403891 * pl) >= 0,
            0.10789713207684715 * pf + (- 0.8866470703094755 * pb) >= 0,
            1 * pb + (- 0.09566667605073106 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.42940281330341745,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7925278859773608 * pl + (- 0.8866470703094755 * pr) >= 0,
            1 * pr + (-0.7026925282403891 * pl) >= 0,
            0.10789713207684715 * pf + (-0.8866470703094755 * pb) >= 0,
            1 * pb + (-0.09566667605073106 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 0)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.42940281330341745,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.7925278859773608 * pl + (- 0.8866470703094755 * pr) >= 0,
            1 * pr + (- 0.7026925282403891 * pl) >= 0,
            0.10789713207684715 * pf + (- 0.8866470703094755 * pb) >= 0,
            1 * pb + (- 0.09566667605073106 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 1) & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 0) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.18126740553917298,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3323633064708684 * pl + (- 0.5188524820828087 * pr) >= 0,
            1 * pr + (- 0.1724475265156593 * pl) >= 0,
            1 * pf + (- 0.5070919955480119 * pb) >= 0,
            0.977333660450872 * pb + (- 0.5188524820828087 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 1 & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.18126740553917298,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3323633064708684 * pl + (- 0.5188524820828087 * pr) >= 0,
            1 * pr + (- 0.1724475265156593 * pl) >= 0,
            1 * pf + (- 0.5070919955480119 * pb) >= 0,
            0.977333660450872 * pb + (- 0.5306129686176054 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.18126740553917298,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3323633064708684 * pl + (- 0.5188524820828087 * pr) >= 0,
            1 * pr + (-0.1724475265156593 * pl) >= 0,
            1 * pf + (-0.5070919955480119 * pb) >= 0,
            0.977333660450872 * pb + (-0.5188524820828087 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 1)  & !Collision  -U->
            pl : (robcol' = 0) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.18126740553917298,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.3323633064708684 * pl + (- 0.5188524820828087 * pr) >= 0,
            1 * pr + (- 0.1724475265156593 * pl) >= 0,
            1 * pf + (- 0.5070919955480119 * pb) >= 0,
            0.977333660450872 * pb + (- 0.5188524820828087 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 2) & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 1) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5674256825956682,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6311052946283079 * pr) >= 0,
            0.6736571512802114 * pr + (- 0.9368345506745702 * pl) >= 0,
            1 * pf + (- 0.3632182458477203 * pb) >= 0,
            0.38770799559664404 * pb + (- 0.9368345506745702 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 2 & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 3) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5674256825956682,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6311052946283079 * pr) >= 0,
            0.6736571512802114 * pr + (- 0.9368345506745702 * pl) >= 0,
            1 * pf + (- 0.3632182458477203 * pb) >= 0,
            0.38770799559664404 * pb + (- 1.5104508555014202 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5674256825956682,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6311052946283079 * pr) >= 0,
            0.6736571512802114 * pr + (-0.9368345506745702 * pl) >= 0,
            1 * pf + (-0.3632182458477203 * pb) >= 0,
            0.38770799559664404 * pb + (-0.9368345506745702 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 2)  & !Collision  -U->
            pl : (robcol' = 1) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5674256825956682,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6311052946283079 * pr) >= 0,
            0.6736571512802114 * pr + (- 0.9368345506745702 * pl) >= 0,
            1 * pf + (- 0.3632182458477203 * pb) >= 0,
            0.38770799559664404 * pb + (- 0.9368345506745702 * pf) >= 0
            };
    [robl] (sched = 0) & (robrow = 0) & (robcol = 3) & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 2) & (sched' = 1)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1503059915212921,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.03257964542066414 * pr) >= 0,
            0.050308942412833124 * pr + (- 0.647591538564196 * pl) >= 0,
            0.10791135042440092 * pf + (- 0.647591538564196 * pb) >= 0,
            1 * pb + (- 0.0698824774498779 * pf) >= 0
            };
    [robr] (sched = 0) & robrow = 0 & robcol = 3 & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robcol' = 4) & (sched' = 1)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1503059915212921,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.03257964542066414 * pr) >= 0,
            0.050308942412833124 * pr + (- 0.647591538564196 * pl) >= 0,
            0.10791135042440092 * pf + (- 0.647591538564196 * pb) >= 0,
            1 * pb + (- 0.0698824774498779 * pf) >= 0 
            };
            [robf] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 1) & (sched' = 1)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1503059915212921,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.03257964542066414 * pr) >= 0,
            0.050308942412833124 * pr + (-0.647591538564196 * pl) >= 0,
            0.10791135042440092 * pf + (-0.647591538564196 * pb) >= 0,
            1 * pb + (-0.0698824774498779 * pf) >= 0 
            };

            [robb] (sched = 0) &  (robrow = 0) & (robcol = 3)  & !Collision  -U->
            pl : (robcol' = 2) & (sched' = 1) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 1) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 1) +
            pb : (robrow' = 0) & (sched' = 1) +
            pm : (robrow' = 0) & (sched' = 1)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1503059915212921,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.03257964542066414 * pr) >= 0,
            0.050308942412833124 * pr + (- 0.647591538564196 * pl) >= 0,
            0.10791135042440092 * pf + (- 0.647591538564196 * pb) >= 0,
