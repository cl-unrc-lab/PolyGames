smg

// player 1, roborta
player p1
   roborta, [robl], [robr], [robf], [robb], [rigl_u], [rigr_u], [rigf_u], [rigb_u] 
endplayer

// player 2, rigoborto
player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb], [robl_u], [robr_u], [robf_u], [robb_u]
endplayer

const int LENGTH = 3; // length of the table, if roborta 
global sched : [0..3] init 0; // a scheduler
global robcol : [0..2] init 0; // columns from 0 to length-1
global robrow : [0..3] init 0; // rows from 0 to length, one more for representing the exit
global rigcol : [0..2] init 2;
global rigrow : [0..3] init 2;
global robact : [0..3]; 
global rigact : [0..3];
// These constanst define the uncertainties in the terrain
const q_terrain[2][2] = {} // quality of terrain
const f_slope[2][2] = {} // forward slope
const l_slope[2][2] = {} // side slopes

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand, Rigoborto wants to maximize, that is, to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);
                
// Roborta reached the end fo the grid
    formula Rigwins =  (Collision);
                
// end of game 
    formula end = Collision | Robwins;

// Module for Roborta, in case a collision the games finishes
module roborta
    robcol : [0..2] init 0;
    robrow : [0..3] init 0;
    // in round 0 roborta selects the action
    [robl] (sched = 0) & !end  -> (sched'=1)&(robact'=0);  // these actions indicate which action is taken by roborta
    [robr] (sched = 0) & !end  -> (sched'=1)&(robact'=1); 
    [robb] (sched = 0) & !end  -> (sched'=1)&(robact'=2); 
    [robf] (sched = 0) & !end  -> (sched'=1)&(robact'=3); 
    
    // in scheduler = 1 rigobort selects since the environment behaves in a adversarial way
    [robl_u] (sched = 1) & (robact=0) & !end  -U->
            // The first four probabilistic options corresponds to environments setbacks
            pl : (robcol' = max(0, robcol-1)) & (sched' = 2) +   // it goes to the left
            pr : (robcol' = min(LENGHT-1, robcol+1) & (sched' = 2) +   // it goes to the right 
            pf : (robrow' = min(LENGHT, robrow+1)) & (sched' = 2) +   // it goes forward
            pb : (robrow' = max(0, robrow-1)) & (sched' = 2) +   // it goes back  
            pm : (robcol' = max(0, robrow-1)) & (sched' = 2)     // Command successful
            {
             pm <= 1 - qterrain[robrow][robcol] + (1 - (1 - abs(lslope[robrow][robcol])) * (1 - abs(fslope[robrow][robcol]))) / 2),
             // The following are the conditions for the probabilities of sideways and frontal displacements
             (1-max(0,-lslope[robrow][robcol])) * pl + (- (1 - qterrain[robrow][robcol]) * (1 - max(0,lslope[robrow][robcol])) * pr) >= 0,
             (1-max(0,lslope[robrow][robcol])) * pr + (- (1 - qterrain[robrow][robcol]) * (1 - max(0,-lslope[robrow][robcol])) * pl) >= 0,
             (1-max(0,fslope[robrow][robcol]))  * pf + (- (1 - qterrain[robrow][robcol]) * (1 - max(0,-fslope[robrow][robcol])) * pb) >= 0,
             1-max(0,-fslope[robrow][robcol]) * pb + (- (1 - qterrain[robrow][robcol]) * (1 - max(0,fslope[robrow][robcol])) * pf) >= 0   
            };  
    [robr_u] (sched = 1) & (robact = 1) &  !end  -U->
            pl : (robcol' = {max(0, robcol-1)}) & (sched' = 2) +     // The first four probabilistic options
            pr : (robcol' = {min(width-1, robcol+1)}) & (sched' = 2) +  // corresponds to environments setbacks
            pf : (robrow' = {i+1}) & (sched' = 2) +
            pb : (robrow' = {max(0, irow1)}) & (sched' = 2) +
            pm : (robcol' = {min(width-1, col+1)}) & (sched' = 2)   // Command successful
            {
                pm <= 1 - (qterrain[robrow][robcol] + (1 - (1-abs(lslope[robrow][robcol])) * (1-abs(fslope[robrow][robcol]))) / 2),
                // The following are the conditions for the probabilities of sideways and frontal displacements
                (1-max(0,-lslope[robrow][robcol])) * pl + (- (1 - qterrain[robrow][robcol]) * (1-max(0,lslope[robrow][robcol])) * pr) >= 0,
                (1-max(0,lslope[robrow][robcol])) * pr + (-  (1 - qterrain[robrow][robcol]) * (1-max(0,-lslope[robrow][robcol])) * pl) >= 0,
                (1-max(0,fslope[robrow][robcol])) * pf + (- (1 - qterrain[robrow][robcol]) * (1- max(0,-fslope[robrow][robcol])) * pb) >= 0,
                (1-max(0,-fslope[robrow][robcol]))} * pb + (- {(1 - qterrain[robrow][robcol]) * (1 - fslope[robrow][robcol])} * pf) >= 0     
            };
    [robf_u] (sched = 1) & (robact=3)  & !end  -U->
            pl : (robcol' = max(0, robcol-1)) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = min(width-1, robcol+1)) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = robrow+1) & (sched' = 2) +
            pb : (robrow' = max(0, robrow-1)) & (sched' = 2) +
            pm : (robrow' = robrow+1) & (sched' = 2)                   // Command successful 
            {
                // Success is affected by the quality and inclination of the terrain
                pm <= {1 - (qterrain[robrow][robcol] + (1 - (1-abs(lslope[robrow][robcol])) * (1-abs(fslope[robrow][robcol]))) / 2),
                // The following are the conditions for the probabilities of sideways and frontal displacements
                (1-max(0,-lslope[robrow][robcol]))  * pl + (- (1 - qterrain[robrow][robcol]) * (1-max(0,lslope[robrow][robcol]))  * pr) >= 0,
                (1-max(0,lslope[robrow][robcol]))  * pr + (-(1 - qterrain[robrow][robcol]) * (1-max(0,-lslope[robrow][robcol]))  * pl) >= 0,
                (1-max(0,fslope[robrow][robcol]))  * pf + (-(1 - qterrain[robrow][robcol]) * (1- max(0,-fslope[robrow][robcol]))  * pb) >= 0,
                (1-max(0,-fslope[robrow][robcol])) * pb + (-(1 - qterrain[robrow][robcol]) * (1-max(0,fslope[robrow][robcol]))  * pf) >= 0
            };
    
    module rigoborto
        rigcol : [0..2] init 2;
        rigrow : [0..3] init 3;
    # rigoborto selects an action and rigoborto solves the uncertainty
    [rigl] (sched = 2) & !end  -> (sched'=3)&(rigact'=0);
    [rigr] (sched = 2) & !end  -> (sched'=3)&(rigact'=1); 
    [rigb] (sched = 2) & !end  -> (sched'=3)&(rigact'=2);
    [rigf] (sched = 2) & !end  -> (sched'=3)&(rigact'=3);
    [rigl_u] (sched = 3) & (rigact=0)  & !end  -U->
        pl : (rigcol' = { max(0, robcol-1)}) & (sched' = 0) +        // The first four probabilistic options
        pr : (rigcol' = {min(width-1, robcol+1)}) & (sched' = 0) +   // corresponds to environments setbacks
        pf : (rigrow' = {min(length-1, robrow+1)}) & (sched' = 0) +
        pb : (rigrow' = {max(0, robrow-1)}) & (sched' = 0) +
        pm : (rigcol' = {max(0, robcol-1)}) & (sched' = 0)           // Command successful
        {
                // Success is affected by the quality and inclination of the terrain
	            pm <= {1 - (qterrain[robrow][robcol] + (1 - (1-abs(lslope[robrow][robcol])) * (1-abs(fslope[robrow][robcol]))) / 2)},
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            (1-max(0,-lslope[robrow][robcol]))} * pl + (- (1 - qterrain[robrow][robcol]) * (1-max(0,lslope[robrow][robcol])) * pr) >= 0,
	            (1-max(0,lslope[robrow][robcol])) * pr + (- (1 - qterrain[robrow][robcol]) * (1-max(0,-lslope[robrow][robcol])) * pl) >= 0,
	            (1-max(0,fslope[robrow][robcol])) * pf + (- (1 - qterrain[robrow][robcol]) * (1-max(0,-fslope[robrow][robcol])) * pb) >= 0,
	            (1-max(0,-fslope[robrow][robcol])) * pb + (- (1 - qterrain[robrow][robcol]) * (1-max(0,fslope[robrow][robcol])) * pf) >= 0
        }
    [rigr_u] (sched = 3)& (rigact=1) & !end  -U->
                pl : (rigcol' = {max(0, j-1)}) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = {min(width-1, j+1)}) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = {min(length-1, i+1)}) & (sched' = 0) +
                pb : (rigrow' = {max(0, i-1)}) & (sched' = 0) +
                pm : (rigcol' = {min(width-1, j+1)}) & (sched' = 0)     // Command successful 
    {
                // Success is affected by the quality and inclination of the terrain
	            pm <= {1 - (qterrain[robrow][robcol] + (1 - (1-abs(lslope[robrow][robcol])) * (1-abs(fslope[robrow][robcol]))) / 2)},
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            (1-max(0,-lslope[robrow][robcol]))} * pl + (- (1 - qterrain[robrow][robcol]) * (1-max(0,lslope[robrow][robcol])) * pr) >= 0,
	            (1-max(0,lslope[robrow][robcol])) * pr + (- (1 - qterrain[robrow][robcol]) * (1-max(0,-lslope[robrow][robcol])) * pl) >= 0,
	            (1-max(0,fslope[robrow][robcol])) * pf + (- (1 - qterrain[robrow][robcol]) * (1-max(0,-fslope[robrow][robcol])) * pb) >= 0,
	            (1-max(0,-fslope[robrow][robcol])) * pb + (- (1 - qterrain[robrow][robcol]) * (1-max(0,fslope[robrow][robcol])) * pf) >= 0
    }
    [rigf_u] (sched = 3)& (rigact=3) & !end   -U->
            pl : (rigcol' = {max(0, rigcol-1)}) & (sched' = 0) +         // The first four probabilistic options
            pr : (rigcol' = {min(width-1, rigcol+1)}) & (sched' = 0) +   // corresponds to environments setbacks
            pf : (rigrow' = {min(length-1, rigcol+1)}) & (sched' = 0) +
            pb : (rigrow' = {max(0, rigrow-1)}) & (sched' = 0) +
            pm : (rigrow' = {min(length-1, rigrow+1)}) & (sched' = 0)    // Command successful
        {
                // Success is affected by the quality and inclination of the terrain
	            pm <= {1 - (qterrain[robrow][robcol] + (1 - (1-abs(lslope[robrow][robcol])) * (1-abs(fslope[robrow][robcol]))) / 2)},
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            (1-max(0,-lslope[robrow][robcol]))} * pl + (- (1 - qterrain[robrow][robcol]) * (1-max(0,lslope[robrow][robcol])) * pr) >= 0,
	            (1-max(0,lslope[robrow][robcol])) * pr + (- (1 - qterrain[robrow][robcol]) * (1-max(0,-lslope[robrow][robcol])) * pl) >= 0,
	            (1-max(0,fslope[robrow][robcol])) * pf + (- (1 - qterrain[robrow][robcol]) * (1-max(0,-fslope[robrow][robcol])) * pb) >= 0,
	            (1-max(0,-fslope[robrow][robcol])) * pb + (- (1 - qterrain[robrow][robcol]) * (1-max(0,fslope[robrow][robcol])) * pf) >= 0
        }
        [rigb_u] (sched = 3) & (rigact=2) & !end  -U->
                    pl : (rigcol' = {(max(0, rigcol-1))}) & (sched' = 0) +         // The first four probabilistic options
                    pr : (rigcol' = {(min(width-1, rigcol+1))}) & (sched' = 0) +   // corresponds to environments setbacks
                    pf : (rigrow' = {(min(length-1, rigrow+1))}) & (sched' = 0) +
                    pb : (rigrow' = {max(0, rigrow-1)}) & (sched' = 0) +
                    pm : (rigrow' = {max(0, rigrow-1)}) & (sched' = 0)           // Command successful
        {
            // Success is affected by the quality and inclination of the terrain
            pm <= {1 - (qterrain[robrow][robcol] + (1 - (1-abs(lslope[robrow][robcol])) * (1-abs(fslope[robrow][robcol]))) / 2)},
            // The following are the conditions for the probabilities of sideways and frontal displacements
            (1-max(0,-lslope[robrow][robcol]))} * pl + (- (1 - qterrain[robrow][robcol]) * (1-max(0,lslope[robrow][robcol])) * pr) >= 0,
            (1-max(0,lslope[robrow][robcol])) * pr + (- (1 - qterrain[robrow][robcol]) * (1-max(0,-lslope[robrow][robcol])) * pl) >= 0,
            (1-max(0,fslope[robrow][robcol])) * pf + (- (1 - qterrain[robrow][robcol]) * (1-max(0,-fslope[robrow][robcol])) * pb) >= 0,
            (1-max(0,-fslope[robrow][robcol])) * pb + (- (1 - qterrain[robrow][robcol]) * (1-max(0,fslope[robrow][robcol])) * pf) >= 0
        }
    
    
