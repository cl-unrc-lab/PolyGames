// This is the source specification for the Roborta vs Rigoborto stochastic game
// Rigoborto has to catch Roborta, both robots move in a finite grid, if 
// Roborta reaches the last row then she wins, otherwise Roborto wins. 
// Uncertainty in the game is introduced by the possibility of having mud/ice in the cells
// which introduced some probability of sliding to some sice, similarly the cells may be have
// and inclination to some side, affecting the movements of robots.

smg

// player 1, roborta
player p1
   roborta, [robl], [robr], [robf], [robb], [rigl_u], [rigr_u], [rigf_u], [rigb_u] 
endplayer

// player 2, rigoborto
player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb], [robl_u], [robr_u], [robf_u], [robb_u]
endplayer

const int length; // length of the table, number of rows 
const int width; // number of columns
const double lowerb; // a lower bound on the quality of the terrain, higher is worst
const double upperb; // an upper bound

global sched : [0..3] init 0; // a scheduler
global robact : [0..3] init 0; // an number identifying the action selected by the current robot (it is a turn-based game)
//global rigact : [0..3] init 0; // not needed

// These constanst define the uncertainties in the terrain
const double q_terrain[width][length] = uniform(lowerb,upperb); // quality of terrain, uniformly generated
const double f_slope[width][length] = uniform(-1.0, 1.0);// forward slope, uniformly generated
const double l_slope[width][length] = uniform(-1.0, 1.0);// side slopes, uniformly generated

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand, Rigoborto wants to maximize, that is, to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < length : 1;
    !Collision & robrow = length : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
formula Robwins =  (robrow = length);
                
// Roborta reached the end fo the grid
formula Rigwins =  (Collision);
                
// end of game 
formula end = Collision | Robwins;

// equation for terrain
equation TerrainUncertainty 
parameters: i, j;
uncertain: &pm, &pr, &pl,  &pf, &pb;
    &pm <= 1 - q_terrain[i][j] + ((1 - (1 - abs(l_slope[i][j])) * (1 - abs(f_slope[i][j]))) / 2),
    // The following are the conditions for the probabilities of sideways and frontal displacements
    &pl*(1-max(0,-l_slope[i][j]))  + &pr* (- (1 - q_terrain[i][j]) * (1 - max(0,l_slope[i][j]))) >= 0,
    &pr*(1-max(0,l_slope[i][j]))  +  &pl * (- (1 - q_terrain[i][j]) * (1 - max(0,-l_slope[i][j])) ) >= 0,
    &pf*(1-max(0,f_slope[i][j]))    +  &pb *(- (1 - q_terrain[i][j]) * (1 - max(0,-f_slope[i][j])) ) >= 0,
    &pb*(1-max(0,-f_slope[i][j]))  +  &pf *(- (1 - q_terrain[i][j]) * (1 - max(0,f_slope[i][j])) ) >= 0
endequation

// Module for Roborta, in case a collision the game finishes
module roborta
    robcol : [0..width-1] init 0;
    robrow : [0..length] init 0;
    // in round 0 roborta selects the action
    [robl] (sched = 0) & !end & robrow < length  -> (sched'=1)&(robact'=0);  // these actions indicate which action is taken by roborta
    [robr] (sched = 0) & !end & robrow < length -> (sched'=1)&(robact'=1); 
    [robb] (sched = 0) & !end & robrow < length -> (sched'=1)&(robact'=2); 
    [robf] (sched = 0) & !end & robrow < length -> (sched'=1)&(robact'=3); 
    
    // if scheduler = 1 rigobort selects since the environment behaves in a adversarial way
    [robl_u] (sched = 1) & (robact=0) & !end& robrow < length -U->
            // The first four probabilistic options corresponds to environments setbacks
            &pl : (robcol' = max(0, robcol-1)) & (sched' = 2) +   // it goes to the left
            &pr : (robcol' = min(width-1, robcol+1)) & (sched' = 2) +   // it goes to the right 
            &pf : (robrow' = min(length, robrow+1)) & (sched' = 2) +   // it goes forward
            &pb : (robrow' = max(0, robrow-1)) & (sched' = 2) +   // it goes back  
            &pm : (robcol' = max(0, robcol-1)) & (sched' = 2)     // Command successful
            instance TerrainUncertainty(robrow, robcol);
    [robr_u] (sched = 1) & (robact = 1) &  !end & robrow < length -U->
            &pl : (robcol' = max(0, robcol-1)) & (sched' = 2) +     // The first four probabilistic options
            &pr : (robcol' = min(width-1, robcol+1)) & (sched' = 2) +  // corresponds to environments setbacks
            &pf : (robrow' = robrow+1) & (sched' = 2) +
            &pb : (robrow' = max(0, robrow-1)) & (sched' = 2) +
            &pm : (robcol' = min(width-1, robcol+1)) & (sched' = 2)   // Command successful
            instance TerrainUncertainty(robrow, robcol);
    [robb_u] (sched = 1) & (robact=2)  & !end & robrow < length -U->
            &pl : (robcol' = max(0, robcol-1)) & (sched' = 2) +         // The first four probabilistic options
            &pr : (robcol' = min(width-1, robcol+1)) & (sched' = 2) +   // corresponds to environments setbacks
            &pf : (robrow' = robrow+1) & (sched' = 2) +
            &pb : (robrow' = max(0, robrow-1)) & (sched' = 2) +
            &pm : (robrow' =  max(0, robrow-1)) & (sched' = 2)                   // Command successful 
            instance TerrainUncertainty(robrow, robcol);  
    [robf_u] (sched = 1) & (robact=3)  & !end & robrow < length -U->
            &pl : (robcol' = max(0, robcol-1)) & (sched' = 2) +         // The first four probabilistic options
            &pr : (robcol' = min(width-1, robcol+1)) & (sched' = 2) +   // corresponds to environments setbacks
            &pf : (robrow' = robrow+1) & (sched' = 2) +
            &pb : (robrow' = max(0, robrow-1)) & (sched' = 2) +
            &pm : (robrow' = robrow+1) & (sched' = 2)                   // Command successful 
            instance TerrainUncertainty(robrow, robcol);
    
endmodule

// module for rigoborto
module rigoborto
        rigcol : [0..width-1] init width-1;
        rigrow : [0..length-1] init length-1;
    // rigoborto selects an action and rigoborto solves the uncertainty
    [rigl] (sched = 2) & !end & rigrow < length -> (sched'=3)&(robact'=0);
    [rigr] (sched = 2) & !end & rigrow < length -> (sched'=3)&(robact'=1); 
    [rigb] (sched = 2) & !end & rigrow < length -> (sched'=3)&(robact'=2);
    [rigf] (sched = 2) & !end & rigrow < length -> (sched'=3)&(robact'=3);
    [rigl_u] (sched = 3) & (robact=0)  & !end & rigrow < length  -U->
        &pl : (rigcol' =  max(0, rigcol-1)) & (sched' = 0) +        // The first four probabilistic options
        &pr : (rigcol' = min(width-1, rigcol+1)) & (sched' = 0) +   // corresponds to environments setbacks
        &pf : (rigrow' = min(length-1, rigrow+1)) & (sched' = 0) +
        &pb : (rigrow' = max(0, rigrow-1)) & (sched' = 0) +
        &pm : (rigcol' = max(0, rigcol-1)) & (sched' = 0)           // Command successful
        instance TerrainUncertainty(rigrow, rigcol);
    [rigr_u] (sched = 3)& (robact=1) & !end & rigrow < length -U->
                &pl : (rigcol' = max(0, rigcol-1)) & (sched' = 0) +         // The first four probabilistic options
                &pr : (rigcol' = min(width-1, rigcol+1)) & (sched' = 0) +   // corresponds to environments setbacks
                &pf : (rigrow' = min(length-1, rigrow+1)) & (sched' = 0) +
                &pb : (rigrow' = max(0, rigrow-1)) & (sched' = 0) +
                &pm : (rigcol' = min(width-1, rigcol+1)) & (sched' = 0)     // Command successful 
                instance TerrainUncertainty(rigrow, rigcol);
    [rigf_u] (sched = 3)& (robact=3) & !end & rigrow < length  -U->
            &pl : (rigcol' = max(0, rigcol-1)) & (sched' = 0) +         // The first four probabilistic options
            &pr : (rigcol' = min(width-1, rigcol+1)) & (sched' = 0) +   // corresponds to environments setbacks
            &pf : (rigrow' = min(length-1, rigcol+1)) & (sched' = 0) +
            &pb : (rigrow' = max(0, rigrow-1)) & (sched' = 0) +
            &pm : (rigrow' = min(length-1, rigrow+1)) & (sched' = 0)    // Command successful
            instance TerrainUncertainty(rigrow, rigcol);
    [rigb_u] (sched = 3) & (robact=2) & !end & rigrow < length  -U->
                    &pl : (rigcol' = (max(0, rigcol-1))) & (sched' = 0) +         // The first four probabilistic options
                    &pr : (rigcol' = (min(width-1, rigcol+1))) & (sched' = 0) +   // corresponds to environments setbacks
                    &pf : (rigrow' = (min(length-1, rigrow+1))) & (sched' = 0) +
                    &pb : (rigrow' = max(0, rigrow-1)) & (sched' = 0) +
                    &pm : (rigrow' = max(0, rigrow-1)) & (sched' = 0)           // Command successful
                    instance TerrainUncertainty(rigrow, rigcol);
endmodule
    
    
