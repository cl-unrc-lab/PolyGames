 // Module for Rigoborto, in case a collision the games finishes
            module rigoborto
            //rigcol : [0..3] init 3;
            //rigrow : [0..4] init 3;
                [rigl] (sched = 2) & !end  -> (sched'=3)&(rigact'=0); 
    [rigr] (sched = 2) & !end  -> (sched'=3)&(rigact'=1); 
