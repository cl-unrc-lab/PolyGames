//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // const Q_TERRAIN_0_0 = 0.4150178466371635;
// const Q_TERRAIN_0_1 = 0.3351527832070355;
// const Q_TERRAIN_0_2 = 0.1516842554664588;
// const Q_TERRAIN_0_3 = 0.2937903030717797;
// const Q_TERRAIN_1_0 = 0.44123950041592885;
// const Q_TERRAIN_1_1 = 0.4230987092141564;
// const Q_TERRAIN_1_2 = 0.2526419102898002;
// const Q_TERRAIN_1_3 = 0.29450112899127584;
// const Q_TERRAIN_2_0 = 0.017262915075670793;
// const Q_TERRAIN_2_1 = 0.12136998677153382;
// const Q_TERRAIN_2_2 = 0.3987021237771514;
// const Q_TERRAIN_2_3 = 0.20715699965038714;
// const Q_TERRAIN_3_0 = 0.08650370078952546;
// const Q_TERRAIN_3_1 = 0.2743993806940765;
// const Q_TERRAIN_3_2 = 0.35152038103281574;
// const Q_TERRAIN_3_3 = 0.3372429152511636;

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                 //F_SLOPE_0_0 =  -0.25059395899671943;
 //F_SLOPE_0_1 =  -0.12207673991087375;
 //F_SLOPE_0_2 =  0.016852976499963646;
 //F_SLOPE_0_3 =  0.5568852300002916;
 //F_SLOPE_1_0 =  0.041876835226290376;
 //F_SLOPE_1_1 =  -0.21348981007154788;
 //F_SLOPE_1_2 =  -0.02061295907548355;
 //F_SLOPE_1_3 =  -0.9408500720661859;
 //F_SLOPE_2_0 =  -0.9130254192869451;
 //F_SLOPE_2_1 =  0.406764177207672;
 //F_SLOPE_2_2 =  0.9663754346193478;
 //F_SLOPE_2_3 =  0.18636746076011512;
 //F_SLOPE_3_0 =  -0.21280062724417204;
 //F_SLOPE_3_1 =  -0.6593016062886374;
 //F_SLOPE_3_2 =  0.004477116866966169;
 //F_SLOPE_3_3 =  0.9641532750770685;

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                //L_SLOPE_0_0   =  0.5410462796616011;
//L_SLOPE_0_1   =  0.07923489689955754;
//L_SLOPE_0_2   =  0.7205795578410992;
//L_SLOPE_0_3   =  -0.5356477438739708;
//L_SLOPE_1_0   =  0.027543326375274013;
//L_SLOPE_1_1   =  0.904934776536539;
//L_SLOPE_1_2   =  0.15558961560240614;
//L_SLOPE_1_3   =  -0.08173653617866328;
//L_SLOPE_2_0   =  -0.46144104511715756;
//L_SLOPE_2_1   =  0.09599261893249778;
//L_SLOPE_2_2   =  0.9142325629204537;
//L_SLOPE_2_3   =  -0.9885817410992142;
//L_SLOPE_3_0   =  0.5673104652307797;
//L_SLOPE_3_1   =  0.6409718238509639;
//L_SLOPE_3_2   =  0.7723591616520165;
//L_SLOPE_3_3   =  0.4810068236663927;
smg
player p1
   roborta, [robl], [robr], [robf], [robb], [rigl_u], [rigr_u], [rigf_u], [rigb_u] 
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb], [robl_u], [robr_u], [robf_u], [robb_u]
endplayer

const int LENGTH = 4;
global sched : [0..3] init 0;
global robcol : [0..3] init 0; 
                    global robrow : [0..4] init 0;
global rigcol : [0..3] init 3;
                    global rigrow : [0..4] init 3;
            global robact : [0..3];
global rigact : [0..3];

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);
                
// Roborta reached the end fo the grid
    formula Rigwins =  (Collision);
                
// end of game 
    formula end = Collision | Robwins;

// Module for Roborta, in case a collision the games finishes
module roborta
    // robcol : [0..3] init 0;
    // robrow : [0..4] init 0;
    [robl] (sched = 0) & !end  -> (sched'=1)&(robact'=0); 
    [robr] (sched = 0) & !end  -> (sched'=1)&(robact'=1); 
    [robb] (sched = 0) & !end  -> (sched'=1)&(robact'=2); 
    [robf] (sched = 0) & !end  -> (sched'=1)&(robact'=3); 
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 0) & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 0) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.25695349864409955,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.26847973561744165 * pr) >= 0,
            0.4589537203383989 * pr + (- 0.5849821533628365 * pl) >= 0,
            1 * pf + (- 0.43838915960921726 * pb) >= 0,
            0.7494060410032806 * pb + (- 0.5849821533628365 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 0 & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 1) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.25695349864409955,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.26847973561744165 * pr) >= 0,
            0.4589537203383989 * pr + (- 0.5849821533628365 * pl) >= 0,
            1 * pf + (- 0.43838915960921726 * pb) >= 0,
            0.7494060410032806 * pb + (- 0.7315751471164559 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 0)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.25695349864409955,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.26847973561744165 * pr) >= 0,
            0.4589537203383989 * pr + (-0.5849821533628365 * pl) >= 0,
            1 * pf + (-0.43838915960921726 * pb) >= 0,
            0.7494060410032806 * pb + (-0.5849821533628365 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 0)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.25695349864409955,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.26847973561744165 * pr) >= 0,
            0.4589537203383989 * pr + (- 0.5849821533628365 * pl) >= 0,
            1 * pf + (- 0.43838915960921726 * pb) >= 0,
            0.7494060410032806 * pb + (- 0.5849821533628365 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 1) & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 0) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5690277673380849,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6121681161164161 * pr) >= 0,
            0.9207651031004425 * pr + (- 0.6648472167929644 * pl) >= 0,
            1 * pf + (- 0.5836848360280614 * pb) >= 0,
            0.8779232600891262 * pb + (- 0.6648472167929644 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 1 & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 2) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5690277673380849,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6121681161164161 * pr) >= 0,
            0.9207651031004425 * pr + (- 0.6648472167929644 * pl) >= 0,
            1 * pf + (- 0.5836848360280614 * pb) >= 0,
            0.8779232600891262 * pb + (- 0.7460095975578674 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 1)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5690277673380849,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6121681161164161 * pr) >= 0,
            0.9207651031004425 * pr + (-0.6648472167929644 * pl) >= 0,
            1 * pf + (-0.5836848360280614 * pb) >= 0,
            0.8779232600891262 * pb + (-0.6648472167929644 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 1)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5690277673380849,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.6121681161164161 * pr) >= 0,
            0.9207651031004425 * pr + (- 0.6648472167929644 * pl) >= 0,
            1 * pf + (- 0.5836848360280614 * pb) >= 0,
            0.8779232600891262 * pb + (- 0.6648472167929644 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 2) & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 1) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.48567143254033485,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.23703676042791924 * pr) >= 0,
            0.27942044215890083 * pr + (- 0.8483157445335412 * pl) >= 0,
            0.9831470235000364 * pf + (- 0.8483157445335412 * pb) >= 0,
            1 * pb + (- 0.8340190992263683 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 2 & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 3) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.48567143254033485,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.23703676042791924 * pr) >= 0,
            0.27942044215890083 * pr + (- 0.8483157445335412 * pl) >= 0,
            0.9831470235000364 * pf + (- 0.8483157445335412 * pb) >= 0,
            1 * pb + (- 0.8340190992263683 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 2)  & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.48567143254033485,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.23703676042791924 * pr) >= 0,
            0.27942044215890083 * pr + (-0.8483157445335412 * pl) >= 0,
            0.9831470235000364 * pf + (-0.8483157445335412 * pb) >= 0,
            1 * pb + (-0.8340190992263683 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 2)  & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.48567143254033485,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.23703676042791924 * pr) >= 0,
            0.27942044215890083 * pr + (- 0.8483157445335412 * pl) >= 0,
            0.9831470235000364 * pf + (- 0.8483157445335412 * pb) >= 0,
            1 * pb + (- 0.8340190992263683 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 3) & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 2) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.30909036851428584,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.46435225612602915 * pl + (- 0.7062096969282203 * pr) >= 0,
            1 * pr + (- 0.3279300660666984 * pl) >= 0,
            0.44311476999970845 * pf + (- 0.7062096969282203 * pb) >= 0,
            1 * pb + (- 0.3129319474259122 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 3 & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 3) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.30909036851428584,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.46435225612602915 * pl + (- 0.7062096969282203 * pr) >= 0,
            1 * pr + (- 0.3279300660666984 * pl) >= 0,
            0.44311476999970845 * pf + (- 0.7062096969282203 * pb) >= 0,
            1 * pb + (- 0.3129319474259122 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 3)  & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.30909036851428584,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.46435225612602915 * pl + (- 0.7062096969282203 * pr) >= 0,
            1 * pr + (-0.3279300660666984 * pl) >= 0,
            0.44311476999970845 * pf + (-0.7062096969282203 * pb) >= 0,
            1 * pb + (-0.3129319474259122 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 3)  & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.30909036851428584,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.46435225612602915 * pl + (- 0.7062096969282203 * pr) >= 0,
            1 * pr + (- 0.3279300660666984 * pl) >= 0,
            0.44311476999970845 * pf + (- 0.7062096969282203 * pb) >= 0,
            1 * pb + (- 0.3129319474259122 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 1) & (robcol = 0) & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 2) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 0) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5246271324533895,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5433703767784159 * pr) >= 0,
            0.972456673624726 * pr + (- 0.5587604995840711 * pl) >= 0,
            0.9581231647737096 * pf + (- 0.5587604995840711 * pb) >= 0,
            1 * pb + (- 0.5353613782120293 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 1 & robcol = 0 & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 2) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 1) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5246271324533895,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5433703767784159 * pr) >= 0,
            0.972456673624726 * pr + (- 0.5587604995840711 * pl) >= 0,
            0.9581231647737096 * pf + (- 0.5587604995840711 * pb) >= 0,
            1 * pb + (- 0.5353613782120293 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 1) & (robcol = 0)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 2) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 2) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.5246271324533895,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.5433703767784159 * pr) >= 0,
            0.972456673624726 * pr + (-0.5587604995840711 * pl) >= 0,
            0.9581231647737096 * pf + (-0.5587604995840711 * pb) >= 0,
