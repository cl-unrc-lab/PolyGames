//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // const Q_TERRAIN_0_0 = 0.2965918651900288;
// const Q_TERRAIN_0_1 = 0.196799843188957;
// const Q_TERRAIN_0_2 = 0.08517459842784064;
// const Q_TERRAIN_0_3 = 0.25111927921674154;
// const Q_TERRAIN_0_4 = 0.4910383187692671;
// const Q_TERRAIN_1_0 = 0.3852615699154003;
// const Q_TERRAIN_1_1 = 0.2698087242248894;
// const Q_TERRAIN_1_2 = 0.4301448894602748;
// const Q_TERRAIN_1_3 = 0.11608806403150729;
// const Q_TERRAIN_1_4 = 0.2568858315938185;
// const Q_TERRAIN_2_0 = 0.47623369413413474;
// const Q_TERRAIN_2_1 = 0.28889740390060153;
// const Q_TERRAIN_2_2 = 0.22956586595533418;
// const Q_TERRAIN_2_3 = 0.1346397387207106;
// const Q_TERRAIN_2_4 = 0.27399815473312444;
// const Q_TERRAIN_3_0 = 0.47855814073011343;
// const Q_TERRAIN_3_1 = 0.0028545647251964623;
// const Q_TERRAIN_3_2 = 0.3918276163076949;
// const Q_TERRAIN_3_3 = 0.41024295596274096;
// const Q_TERRAIN_3_4 = 0.4430897904130041;
// const Q_TERRAIN_4_0 = 0.3702517059165982;
// const Q_TERRAIN_4_1 = 0.4045699504362398;
// const Q_TERRAIN_4_2 = 0.259339141761501;
// const Q_TERRAIN_4_3 = 0.2806789323891895;
// const Q_TERRAIN_4_4 = 0.2130453398440751;

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                 //F_SLOPE_0_0 =  -0.8877534049585192;
 //F_SLOPE_0_1 =  0.7400203103532796;
 //F_SLOPE_0_2 =  0.1399986677527605;
 //F_SLOPE_0_3 =  -0.6003211596457139;
 //F_SLOPE_0_4 =  0.00944093485772668;
 //F_SLOPE_1_0 =  -0.030149775544531687;
 //F_SLOPE_1_1 =  -0.2864200709100886;
 //F_SLOPE_1_2 =  -0.30784416196369024;
 //F_SLOPE_1_3 =  0.07695759147568859;
 //F_SLOPE_1_4 =  0.24697890559501023;
 //F_SLOPE_2_0 =  0.22490492956545127;
 //F_SLOPE_2_1 =  -0.08370639980055117;
 //F_SLOPE_2_2 =  -0.9440500318323153;
 //F_SLOPE_2_3 =  -0.5407899374459522;
 //F_SLOPE_2_4 =  -0.6455774821228346;
 //F_SLOPE_3_0 =  0.16892174155688267;
 //F_SLOPE_3_1 =  0.7220177217066497;
 //F_SLOPE_3_2 =  0.5968778811548521;
 //F_SLOPE_3_3 =  0.5941951252709925;
 //F_SLOPE_3_4 =  0.6328747411213818;
 //F_SLOPE_4_0 =  -0.4894119198253881;
 //F_SLOPE_4_1 =  0.683489664548192;
 //F_SLOPE_4_2 =  0.3462270508774141;
 //F_SLOPE_4_3 =  -0.8335317243922042;
 //F_SLOPE_4_4 =  -0.9666187397688808;

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                //L_SLOPE_0_0   =  -0.9708800501503754;
//L_SLOPE_0_1   =  0.5111735505043964;
//L_SLOPE_0_2   =  -0.5008815486931544;
//L_SLOPE_0_3   =  -0.7810227454112812;
//L_SLOPE_0_4   =  0.24960416830495258;
//L_SLOPE_1_0   =  -0.31115427180701016;
//L_SLOPE_1_1   =  -0.8609692429383053;
//L_SLOPE_1_2   =  -0.680748950612305;
//L_SLOPE_1_3   =  0.05476079809602563;
//L_SLOPE_1_4   =  -0.6637101075551435;
//L_SLOPE_2_0   =  -0.4541711263626398;
//L_SLOPE_2_1   =  0.42317985437054584;
//L_SLOPE_2_2   =  -0.09059673990867223;
//L_SLOPE_2_3   =  -0.35599646722534817;
//L_SLOPE_2_4   =  -0.052457971659442215;
//L_SLOPE_3_0   =  -0.9527308447360259;
//L_SLOPE_3_1   =  -0.22688579047706026;
//L_SLOPE_3_2   =  -0.15816264158184823;
//L_SLOPE_3_3   =  -0.6239213904973742;
//L_SLOPE_3_4   =  -0.7824766151091733;
//L_SLOPE_4_0   =  0.7996370007120404;
//L_SLOPE_4_1   =  0.020231961857352765;
//L_SLOPE_4_2   =  -0.5818180148964598;
//L_SLOPE_4_3   =  0.21129728006803306;
//L_SLOPE_4_4   =  0.6340793367557738;
smg
player p1
   roborta, [robl], [robr], [robf], [robb], [rigl_u], [rigr_u], [rigf_u], [rigb_u] 
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb], [robl_u], [robr_u], [robf_u], [robb_u]
endplayer

const int LENGTH = 5;
global sched : [0..3] init 0;
global robcol : [0..4] init 0; 
                    global robrow : [0..5] init 0;
global rigcol : [0..4] init 4;
                    global rigrow : [0..5] init 4;
            global robact : [0..3];
global rigact : [0..3];

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);
                
// Roborta reached the end fo the grid
    formula Rigwins =  (Collision);
                
// end of game 
    formula end = Collision | Robwins;

// Module for Roborta, in case a collision the games finishes
module roborta
    // robcol : [0..4] init 0;
    // robrow : [0..5] init 0;
    [robl] (sched = 0) & !end  -> (sched'=1)&(robact'=0); 
    [robr] (sched = 0) & !end  -> (sched'=1)&(robact'=1); 
    [robb] (sched = 0) & !end  -> (sched'=1)&(robact'=2); 
    [robf] (sched = 0) & !end  -> (sched'=1)&(robact'=3); 
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 0) & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 0) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2050424424191708,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.029119949849624627 * pl + (- 0.7034081348099712 * pr) >= 0,
            1 * pr + (- 0.02048320960948436 * pl) >= 0,
            1 * pf + (- 0.07895516805689819 * pb) >= 0,
            0.11224659504148082 * pb + (- 0.7034081348099712 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 0 & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 1) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2050424424191708,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.029119949849624627 * pl + (- 0.7034081348099712 * pr) >= 0,
            1 * pr + (- 0.02048320960948436 * pl) >= 0,
            1 * pf + (- 0.07895516805689819 * pb) >= 0,
            0.11224659504148082 * pb + (- 1.3278611015630442 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 0)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2050424424191708,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.029119949849624627 * pl + (- 0.7034081348099712 * pr) >= 0,
            1 * pr + (-0.02048320960948436 * pl) >= 0,
            1 * pf + (-0.07895516805689819 * pb) >= 0,
            0.11224659504148082 * pb + (-0.7034081348099712 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 0)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2050424424191708,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.029119949849624627 * pl + (- 0.7034081348099712 * pr) >= 0,
            1 * pr + (- 0.02048320960948436 * pl) >= 0,
            1 * pf + (- 0.07895516805689819 * pb) >= 0,
            0.11224659504148082 * pb + (- 0.7034081348099712 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 1) & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 0) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3667426311265307,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.39262548088825416 * pr) >= 0,
            0.4888264494956036 * pr + (- 0.803200156811043 * pl) >= 0,
            0.25997968964672036 * pf + (- 0.803200156811043 * pb) >= 0,
            1 * pb + (- 0.20881572749193208 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 1 & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 2) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3667426311265307,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.39262548088825416 * pr) >= 0,
            0.4888264494956036 * pr + (- 0.803200156811043 * pl) >= 0,
            0.25997968964672036 * pf + (- 0.803200156811043 * pb) >= 0,
            1 * pb + (- 0.20881572749193208 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 1)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3667426311265307,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.39262548088825416 * pr) >= 0,
            0.4888264494956036 * pr + (-0.803200156811043 * pl) >= 0,
            0.25997968964672036 * pf + (-0.803200156811043 * pb) >= 0,
            1 * pb + (-0.20881572749193208 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 1)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3667426311265307,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.39262548088825416 * pr) >= 0,
            0.4888264494956036 * pr + (- 0.803200156811043 * pl) >= 0,
            0.25997968964672036 * pf + (- 0.803200156811043 * pb) >= 0,
            1 * pb + (- 0.20881572749193208 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 2) & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 1) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6294466681086925,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4991184513068456 * pl + (- 0.9148254015721593 * pr) >= 0,
            1 * pr + (- 0.45660623764885927 * pl) >= 0,
            0.8600013322472395 * pf + (- 0.9148254015721593 * pb) >= 0,
            1 * pb + (- 0.7867510641256729 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 2 & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 3) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6294466681086925,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4991184513068456 * pl + (- 0.9148254015721593 * pr) >= 0,
            1 * pr + (- 0.45660623764885927 * pl) >= 0,
            0.8600013322472395 * pf + (- 0.9148254015721593 * pb) >= 0,
            1 * pb + (- 0.7867510641256729 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 2)  & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6294466681086925,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4991184513068456 * pl + (- 0.9148254015721593 * pr) >= 0,
            1 * pr + (-0.45660623764885927 * pl) >= 0,
            0.8600013322472395 * pf + (-0.9148254015721593 * pb) >= 0,
            1 * pb + (-0.7867510641256729 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 2)  & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.6294466681086925,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.4991184513068456 * pl + (- 0.9148254015721593 * pr) >= 0,
            1 * pr + (- 0.45660623764885927 * pl) >= 0,
            0.8600013322472395 * pf + (- 0.9148254015721593 * pb) >= 0,
            1 * pb + (- 0.7867510641256729 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 3) & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 2) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2926410083722506,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.21897725458871875 * pl + (- 0.7488807207832584 * pr) >= 0,
            1 * pr + (- 0.16398784425153878 * pl) >= 0,
            1 * pf + (- 0.2993117780463347 * pb) >= 0,
            0.39967884035428614 * pb + (- 0.7488807207832584 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 3 & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 4) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2926410083722506,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.21897725458871875 * pl + (- 0.7488807207832584 * pr) >= 0,
            1 * pr + (- 0.16398784425153878 * pl) >= 0,
            1 * pf + (- 0.2993117780463347 * pb) >= 0,
            0.39967884035428614 * pb + (- 1.1984496635201822 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 3)  & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2926410083722506,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.21897725458871875 * pl + (- 0.7488807207832584 * pr) >= 0,
            1 * pr + (-0.16398784425153878 * pl) >= 0,
            1 * pf + (-0.2993117780463347 * pb) >= 0,
            0.39967884035428614 * pb + (-0.7488807207832584 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 3)  & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2926410083722506,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.21897725458871875 * pl + (- 0.7488807207832584 * pr) >= 0,
            1 * pr + (- 0.16398784425153878 * pl) >= 0,
            1 * pf + (- 0.2993117780463347 * pb) >= 0,
            0.39967884035428614 * pb + (- 0.7488807207832584 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 4) & !end  -U->
            pl : (robcol' = 3) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 3) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.3806173779959853,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.38192272408804545 * pr) >= 0,
            0.7503958316950474 * pr + (- 0.5089616812307329 * pl) >= 0,
            0.9905590651422733 * pf + (- 0.5089616812307329 * pb) >= 0,
            1 * pb + (- 0.5041566071531546 * pf) >= 0
