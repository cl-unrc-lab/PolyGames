	            0.3076051631433745 * pr + (- 0.9892551473670456 * pl) >= 0,
	            0.5570311848334633 * pf + (- 0.9892551473670456 * pb) >= 0,
	            1 * pb + (- 0.5510459668404677 * pf) >= 0
                };

                [rigf_u] (sched = 3)& (rigact=3) & !end  & rigrow = 2 & rigcol = 2 -U->
                pl : (rigcol' = 1) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 2) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 2) & (sched' = 0) +
                pb : (rigrow' = 1) & (sched' = 0) +
                pm : (rigrow' = 2) & (sched' = 0)    // Command successful
                {
                // Success is affected by the quality and inclination of the terrain
	            pm <= 0.5749279816103678,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            1 * pl + (- 0.30429999099626304 * pr) >= 0,
	            0.3076051631433745 * pr + (- 0.9892551473670456 * pl) >= 0,
	            0.5570311848334633 * pf + (- 0.9892551473670456 * pb) >= 0,
	            1 * pb + (- 0.5510459668404677 * pf) >= 0
                };

                [rigb_u] (sched = 3) & (rigact=2) &  rigrow = 2 & rigcol = 2 & !end  -U->
                pl : (rigcol' = 1) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 2) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 2) & (sched' = 0) +
                pb : (rigrow' = 1) & (sched' = 0) +
                pm : (rigrow' = 1) & (sched' = 0)           // Command successful
                {
	            // Success is affected by the quality and inclination of the terrain
	            pm <= 0.5749279816103678,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            1 * pl + (- 0.30429999099626304 * pr) >= 0,
	            0.3076051631433745 * pr + (- 0.9892551473670456 * pl) >= 0,
	            0.5570311848334633 * pf + (- 0.9892551473670456 * pb) >= 0,
	            1 * pb + (- 0.5510459668404677 * pf) >= 0
                };endmodule
