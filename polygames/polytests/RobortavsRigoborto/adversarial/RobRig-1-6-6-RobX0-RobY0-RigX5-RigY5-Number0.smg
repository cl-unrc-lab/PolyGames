//Since PRISM does not support arrays we use directly the constants as defined below:
// Terrain quality:
                    // Q_TERRAIN is a constant (WIDTH x LENGTH) matrix of floats in the interval [0,0.5]
                    // where 0 means "optimal quality" while 0.5 corresponds to the worst quality)
                // const Q_TERRAIN_0_0 = 0.26923939786892215;
// const Q_TERRAIN_0_1 = 0.31174472639875256;
// const Q_TERRAIN_0_2 = 0.3062262323913628;
// const Q_TERRAIN_0_3 = 0.2290734000498622;
// const Q_TERRAIN_0_4 = 0.013987492041921179;
// const Q_TERRAIN_0_5 = 0.11480251563851196;
// const Q_TERRAIN_1_0 = 0.08860562946929135;
// const Q_TERRAIN_1_1 = 0.29223043538922067;
// const Q_TERRAIN_1_2 = 0.4305044304266624;
// const Q_TERRAIN_1_3 = 0.399219470288713;
// const Q_TERRAIN_1_4 = 0.3985487813177481;
// const Q_TERRAIN_1_5 = 0.40821868528034544;
// const Q_TERRAIN_2_0 = 0.12764702004365297;
// const Q_TERRAIN_2_1 = 0.420872416137048;
// const Q_TERRAIN_2_2 = 0.33655676271935353;
// const Q_TERRAIN_2_3 = 0.04161706890194894;
// const Q_TERRAIN_2_4 = 0.0083453150577798;
// const Q_TERRAIN_2_5 = 0.007279987462406157;
// const Q_TERRAIN_3_0 = 0.3777933876260991;
// const Q_TERRAIN_3_1 = 0.1247796128267114;
// const Q_TERRAIN_3_2 = 0.05474431364717969;
// const Q_TERRAIN_3_3 = 0.31240104207623814;
// const Q_TERRAIN_3_4 = 0.17221143204824746;
// const Q_TERRAIN_3_5 = 0.034757689265423664;
// const Q_TERRAIN_4_0 = 0.07981276234692375;
// const Q_TERRAIN_4_1 = 0.2636901995240064;
// const Q_TERRAIN_4_2 = 0.08407247311121413;
// const Q_TERRAIN_4_3 = 0.13645721840934005;
// const Q_TERRAIN_4_4 = 0.35579496359263646;
// const Q_TERRAIN_4_5 = 0.22735081502283194;
// const Q_TERRAIN_5_0 = 0.16100088319366296;
// const Q_TERRAIN_5_1 = 0.23688550708513945;
// const Q_TERRAIN_5_2 = 0.011817288815993532;
// const Q_TERRAIN_5_3 = 0.19327855238073494;
// const Q_TERRAIN_5_4 = 0.21045933960453794;
// const Q_TERRAIN_5_5 = 0.09401965237565646;

                // F_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the frontal inclination where 0 indicats that the terrain has no frontal inclination,
                // -1 is the maximum descending inclination, and 1 is the maximum ascending inclination.
                 //F_SLOPE_0_0 =  -0.7824766151091733;
 //F_SLOPE_0_1 =  0.7996370007120404;
 //F_SLOPE_0_2 =  0.020231961857352765;
 //F_SLOPE_0_3 =  -0.5818180148964598;
 //F_SLOPE_0_4 =  0.21129728006803306;
 //F_SLOPE_0_5 =  0.6340793367557738;
 //F_SLOPE_1_0 =  -0.9583637829814253;
 //F_SLOPE_1_1 =  -0.9642709583444093;
 //F_SLOPE_1_2 =  -0.707076519201308;
 //F_SLOPE_1_3 =  0.43767094552357966;
 //F_SLOPE_1_4 =  -0.6795448147405907;
 //F_SLOPE_1_5 =  0.4092112557040051;
 //F_SLOPE_2_0 =  0.356351590553895;
 //F_SLOPE_2_1 =  0.08940432715780888;
 //F_SLOPE_2_2 =  -0.5588005039546469;
 //F_SLOPE_2_3 =  0.9511890356357668;
 //F_SLOPE_2_4 =  0.595621715412302;
 //F_SLOPE_2_5 =  0.03319903389878598;
 //F_SLOPE_3_0 =  -0.5536084395066585;
 //F_SLOPE_3_1 =  0.2970128361985127;
 //F_SLOPE_3_2 =  -0.21020398028340082;
 //F_SLOPE_3_3 =  0.15169192557611333;
 //F_SLOPE_3_4 =  -0.3575083813097495;
 //F_SLOPE_3_5 =  0.2618957225426939;
 //F_SLOPE_4_0 =  -0.8824297675870174;
 //F_SLOPE_4_1 =  -0.4027881007539733;
 //F_SLOPE_4_2 =  0.9358066203017783;
 //F_SLOPE_4_3 =  0.7510684884703185;
 //F_SLOPE_4_4 =  -0.38722675933350814;
 //F_SLOPE_4_5 =  0.7170288127131186;
 //F_SLOPE_5_0 =  -0.3792727452937319;
 //F_SLOPE_5_1 =  0.8785768642705649;
 //F_SLOPE_5_2 =  0.48768423733424227;
 //F_SLOPE_5_3 =  -0.167655474469949;
 //F_SLOPE_5_4 =  -0.4952837954403293;
 //F_SLOPE_5_5 =  -0.9830394750726623;

                // L_SLOPE is a constant (WIDTH x LENGTH) matrix of floats in the interval [-1,1]
                // corresponding to the lateral inclination where 0 indicats that the terrain has no lateral inclination,
                // -1 is the maximum inclination towards the left, and 1 is the maximum inclination towards the right.
                //L_SLOPE_0_0   =  0.7574357964176932;
//L_SLOPE_0_1   =  -0.9241669388028388;
//L_SLOPE_0_2   =  0.6388282212255945;
//L_SLOPE_0_3   =  0.924402250361636;
//L_SLOPE_0_4   =  0.1405611404903604;
//L_SLOPE_0_5   =  -0.6569658096445627;
//L_SLOPE_1_0   =  0.7355621288699867;
//L_SLOPE_1_1   =  0.9475504723193833;
//L_SLOPE_1_2   =  0.4080462846601427;
//L_SLOPE_1_3   =  0.017747492155780975;
//L_SLOPE_1_4   =  -0.24406233131278388;
//L_SLOPE_1_5   =  -0.30613823087475667;
//L_SLOPE_2_0   =  -0.5884764854105906;
//L_SLOPE_2_1   =  0.34830602849372827;
//L_SLOPE_2_2   =  -0.13409975779936745;
//L_SLOPE_2_3   =  -0.6117627100296208;
//L_SLOPE_2_4   =  -0.7911515543169694;
//L_SLOPE_2_5   =  0.3319150565573652;
//L_SLOPE_3_0   =  -0.4078546538336969;
//L_SLOPE_3_1   =  -0.00040015552639682817;
//L_SLOPE_3_2   =  -0.34930869024800737;
//L_SLOPE_3_3   =  0.7432430148471103;
//L_SLOPE_3_4   =  0.7993565392695623;
//L_SLOPE_3_5   =  -0.9638140327190565;
//L_SLOPE_4_0   =  -0.5982939771184812;
//L_SLOPE_4_1   =  -0.34451858980746497;
//L_SLOPE_4_2   =  0.9740994358560522;
//L_SLOPE_4_3   =  0.5654007514587511;
//L_SLOPE_4_4   =  -0.3218087042981326;
//L_SLOPE_4_5   =  -0.5739404072383725;
//L_SLOPE_5_0   =  0.34891013944752647;
//L_SLOPE_5_1   =  0.6754021403079287;
//L_SLOPE_5_2   =  0.8643749437872545;
//L_SLOPE_5_3   =  -0.31230037041836045;
//L_SLOPE_5_4   =  0.7647864049329272;
//L_SLOPE_5_5   =  0.37422036430731476;
smg
player p1
   roborta, [robl], [robr], [robf], [robb], [rigl_u], [rigr_u], [rigf_u], [rigb_u] 
endplayer

player p2
  rigoborto, [rigl], [rigr], [rigf], [rigb], [robl_u], [robr_u], [robf_u], [robb_u]
endplayer

const int LENGTH = 6;
global sched : [0..3] init 0;
global robcol : [0..5] init 0; 
                    global robrow : [0..6] init 0;
global rigcol : [0..5] init 5;
                    global rigrow : [0..6] init 5;
            global robact : [0..3];
global rigact : [0..3];

// In this case Roborta is a minimizer she wants to reach the exit asap
// on the other hand Rigoborto wants to maximize, that is to stop Roborta.
rewards "r0"
    Collision : 10;
    !Collision & robrow < LENGTH : 1;
    !Collision & robrow = LENGTH : 0;
endrewards
                  
// Roborta and Rigoborto occupy the same cell producing a collision
    formula Collision = (robcol = rigcol) & (robrow = rigrow);

// Roborta reached the end fo the grid
    formula Robwins =  (robrow = LENGTH);
                
// Roborta reached the end fo the grid
    formula Rigwins =  (Collision);
                
// end of game 
    formula end = Collision | Robwins;

// Module for Roborta, in case a collision the games finishes
module roborta
    // robcol : [0..5] init 0;
    // robrow : [0..6] init 0;
    [robl] (sched = 0) & !end  -> (sched'=1)&(robact'=0); 
    [robr] (sched = 0) & !end  -> (sched'=1)&(robact'=1); 
    [robb] (sched = 0) & !end  -> (sched'=1)&(robact'=2); 
    [robf] (sched = 0) & !end  -> (sched'=1)&(robact'=3); 
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 0) & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 0) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2571422954393634,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.17725636346525186 * pr) >= 0,
            0.2425642035823068 * pr + (- 0.7307606021310779 * pl) >= 0,
            1 * pf + (- 0.1589575197204107 * pb) >= 0,
            0.21752338489082668 * pb + (- 0.7307606021310779 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 0 & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 1) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2571422954393634,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.17725636346525186 * pr) >= 0,
            0.2425642035823068 * pr + (- 0.7307606021310779 * pl) >= 0,
            1 * pf + (- 0.1589575197204107 * pb) >= 0,
            0.21752338489082668 * pb + (- 1.302563684541745 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 0)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2571422954393634,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.17725636346525186 * pr) >= 0,
            0.2425642035823068 * pr + (-0.7307606021310779 * pl) >= 0,
            1 * pf + (-0.1589575197204107 * pb) >= 0,
            0.21752338489082668 * pb + (-0.7307606021310779 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 0)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2571422954393634,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.17725636346525186 * pr) >= 0,
            0.2425642035823068 * pr + (- 0.7307606021310779 * pl) >= 0,
            1 * pf + (- 0.1589575197204107 * pb) >= 0,
            0.21752338489082668 * pb + (- 0.7307606021310779 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 1) & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 0) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1958523433945727,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.07583306119716116 * pl + (- 0.6882552736012475 * pr) >= 0,
            1 * pr + (- 0.052192504282272296 * pl) >= 0,
            0.20036299928795964 * pf + (- 0.6882552736012475 * pb) >= 0,
            1 * pb + (- 0.13790089089450122 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 1 & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 2) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1958523433945727,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.07583306119716116 * pl + (- 0.6882552736012475 * pr) >= 0,
            1 * pr + (- 0.052192504282272296 * pl) >= 0,
            0.20036299928795964 * pf + (- 0.6882552736012475 * pb) >= 0,
            1 * pb + (- 0.13790089089450122 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 1)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1958523433945727,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.07583306119716116 * pl + (- 0.6882552736012475 * pr) >= 0,
            1 * pr + (-0.052192504282272296 * pl) >= 0,
            0.20036299928795964 * pf + (-0.6882552736012475 * pb) >= 0,
            1 * pb + (-0.13790089089450122 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 1)  & !end  -U->
            pl : (robcol' = 0) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 2) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.1958523433945727,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            0.07583306119716116 * pl + (- 0.6882552736012475 * pr) >= 0,
            1 * pr + (- 0.052192504282272296 * pl) >= 0,
            0.20036299928795964 * pf + (- 0.6882552736012475 * pb) >= 0,
            1 * pb + (- 0.13790089089450122 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 2) & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 1) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.370706050169782,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.25057150571423253 * pr) >= 0,
            0.36117177877440554 * pr + (- 0.6937737676086372 * pl) >= 0,
            0.9797680381426472 * pf + (- 0.6937737676086372 * pb) >= 0,
            1 * pb + (- 0.6797373632047473 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 2 & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 3) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.370706050169782,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.25057150571423253 * pr) >= 0,
            0.36117177877440554 * pr + (- 0.6937737676086372 * pl) >= 0,
            0.9797680381426472 * pf + (- 0.6937737676086372 * pb) >= 0,
            1 * pb + (- 0.6797373632047473 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 2)  & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.370706050169782,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.25057150571423253 * pr) >= 0,
            0.36117177877440554 * pr + (-0.6937737676086372 * pl) >= 0,
            0.9797680381426472 * pf + (-0.6937737676086372 * pb) >= 0,
            1 * pb + (-0.6797373632047473 * pf) >= 0 
            };

            [robb_u] (sched = 1) & (robact=2) & (robrow = 0) & (robcol = 2)  & !end  -U->
            pl : (robcol' = 1) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 3) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 0) & (sched' = 2)           // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.370706050169782,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.25057150571423253 * pr) >= 0,
            0.36117177877440554 * pr + (- 0.6937737676086372 * pl) >= 0,
            0.9797680381426472 * pf + (- 0.6937737676086372 * pb) >= 0,
            1 * pb + (- 0.6797373632047473 * pf) >= 0
            };
    [robl_u] (sched = 1) & (robact=0) & (robrow = 0) & (robcol = 3) & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 2) & (sched' = 2)            // Command successful
            {
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2867334084567035,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.05828031609258569 * pr) >= 0,
            0.07559774963836396 * pr + (- 0.7709265999501378 * pl) >= 0,
            1 * pf + (- 0.3223876159362714 * pb) >= 0,
            0.4181819851035402 * pb + (- 0.7709265999501378 * pf) >= 0
            };
    [robr_u] (sched = 1) & (robact = 1) & robrow = 0 & robcol = 3 & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 4) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robcol' = 4) & (sched' = 2)     // Command successful
            {    
            // Success is affected by the quality and inclination of the terrain
            pm <= 0.2867334084567035,
            // The following are the conditions for the probabilities of sideways and frontal displacements
            1 * pl + (- 0.05828031609258569 * pr) >= 0,
            0.07559774963836396 * pr + (- 0.7709265999501378 * pl) >= 0,
            1 * pf + (- 0.3223876159362714 * pb) >= 0,
            0.4181819851035402 * pb + (- 1.219465583964004 * pf) >= 0 
            };
            [robf_u] (sched = 1) & (robact=3) &  (robrow = 0) & (robcol = 3)  & !end  -U->
            pl : (robcol' = 2) & (sched' = 2) +         // The first four probabilistic options
            pr : (robcol' = 1) & (sched' = 2) +   // corresponds to environments setbacks
            pf : (robrow' = 1) & (sched' = 2) +
            pb : (robrow' = 0) & (sched' = 2) +
            pm : (robrow' = 1) & (sched' = 2)                   // Command successful 
            {
            // Success is affected by the quality and inclination of the terrain
