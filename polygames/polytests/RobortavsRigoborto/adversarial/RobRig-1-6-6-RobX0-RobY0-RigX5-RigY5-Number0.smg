                pl : (rigcol' = 4) & (sched' = 0) +         // The first four probabilistic options
                pr : (rigcol' = 5) & (sched' = 0) +   // corresponds to environments setbacks
                pf : (rigrow' = 5) & (sched' = 0) +
                pb : (rigrow' = 4) & (sched' = 0) +
                pm : (rigrow' = 4) & (sched' = 0)           // Command successful
                {
	            // Success is affected by the quality and inclination of the terrain
	            pm <= 0.4112871231794366,
	            // The following are the conditions for the probabilities of sideways and frontal displacements
	            1 * pl + (- 0.566944051881094 * pr) >= 0,
	            0.6257796356926852 * pr + (- 0.9059803476243435 * pl) >= 0,
	            1 * pf + (- 0.015365902269560739 * pb) >= 0,
	            0.016960524927337683 * pb + (- 0.9059803476243435 * pf) >= 0
                };endmodule
