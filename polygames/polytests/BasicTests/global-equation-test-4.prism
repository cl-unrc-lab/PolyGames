smg
// A simple example to test the use of global equations.


const int k = 2; 
const double a[3] = {0.25,0.35,0.45};

player p1
  host, [send1], [send2]
endplayer

player p2
  client
endplayer

equation basicEqs 
	parameters: i;
	uncertain: &p1,&p2;
	&p1 >= i,
	&p2 >= i
endequation

module host
	h : [0..2] init 0;
	[send1] h=0 -U-> &p1 : (h'=1) + &p2 : (h'=2){
		&p1+a[h] >= 0.25,
		&p2 >= 0.25
	}; // send message 1
	[send2] h=0 -> (h'=2);  // send message 2
	[] c=0 -> (h'=0); // restart
endmodule

module client
	c : [0..2] init 0;
	[send1] c=0 -> 0.85 : (c'=1) + 0.15 : (c'=0); // receive message 1
	[send2] c=0 -U-> &p1 : (c'=2) + &p2 : (c'=0) // receive message 2
					 instance basicEqs(a[c]);
	[] c!=0 -> (c'=0); // request another message
	[] c!=0 -> true;   // wait
endmodule
