        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 30 & dfr_index = 1 & vs_step = 1 -> (pool' = pool - 2) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 30 & dfr_index = 2 & vs_step = 1 -> (pool' = pool - 2) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 40 & dfr_index = 0 & vs_step = 1 -> (pool' = pool - 3) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 40 & dfr_index = 1 & vs_step = 1 -> (pool' = pool - 3) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 40 & dfr_index = 2 & vs_step = 1 -> (pool' = pool - 3) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
