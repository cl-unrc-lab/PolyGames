                // FTR uncertainty: zombies = 30 (non-congested regime)
                [] turn = 2 & time < maxTime & !parameters_selection & ftr_selected & zombies = 30 & vs_step = 0 -U-> &p_b_receive_ftr : (packet_status'=1) & (vs_step'=1)
                                                                        + &p_b_drop_ftr    : (packet_status'=2) & (vs_step'=1)
                                                                        + &p_l_receive_ftr : (packet_status'=3) & (vs_step'=1)
