                                                                        + &p_l_receive_ftr : (packet_status'=3) & (vs_step'=1)
                                                                        + &p_l_drop_ftr    : (packet_status'=4) & (vs_step'=1)
                { // congested: dfr x fpf with cross-constraint and congestion bound
                    0.85 <= &dfr,
                    &dfr <= 0.95,
                    0.05 <= &fpf,
                    &fpf <= 0.15,
                    &fpf + -&dfr * 0.5 >= -0.375,
                    -&dfr * 4593.0 + -&fpf * 100.0 >= -4235.0,
                    &p_b_receive_ftr = 0.0487960793 + -&dfr * 0.0487960793,
                    &p_b_drop_ftr    = 0.4512039207    +  &dfr * 0.0487960793,
                    &p_l_receive_ftr = 0.0487960793 + -&fpf * 0.0487960793,
                    &p_l_drop_ftr    = 0.4512039207    +  &fpf * 0.0487960793
