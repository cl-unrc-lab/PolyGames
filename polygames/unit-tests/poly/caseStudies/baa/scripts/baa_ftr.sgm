                                                                        + &p_b_drop_ftr    : (packet_status'=2) & (vs_step'=1)
                                                                        + &p_l_receive_ftr : (packet_status'=3) & (vs_step'=1)
                                                                        + &p_l_drop_ftr    : (packet_status'=4) & (vs_step'=1)
                { // congested: dfr x fpf with cross-constraint and congestion bound
                    0.85 <= &dfr,
                    &dfr <= 0.95,
                    0.05 <= &fpf,
                    &fpf <= 0.15,
                    &fpf + -&dfr * 0.5 >= -0.375,
                    -&dfr * 3062.0 + -&fpf * 100.0 >= -2704.0,
                    &p_b_receive_ftr = 0.0724225174 + -&dfr * 0.0724225174,
                    &p_b_drop_ftr    = 0.4275774826    +  &dfr * 0.0724225174,
                    &p_l_receive_ftr = 0.0724225174 + -&fpf * 0.0724225174,
                    &p_l_drop_ftr    = 0.4275774826    +  &fpf * 0.0724225174
                };
            
                // RND: zombies = 30
                [] turn = 2 & time < maxTime & !parameters_selection & rnd_selected & zombies = 30 & vs_step = 0 -U-> &p_b_receive_rnd : (packet_status'=1) & (vs_step'=1)
                                                                        + &p_b_drop_rnd    : (packet_status'=2) & (vs_step'=1)
                                                                        + &p_l_receive_rnd : (packet_status'=3) & (vs_step'=1)
                                                                        + &p_l_drop_rnd    : (packet_status'=4) & (vs_step'=1)
                { // non-congested: rnd*(R_b+R_l) >= (R_b+R_l-BW)
                    &rnd * 4693.0 + (-4235.0) >= 0,
                    0.85 <= &rnd,
                    &rnd <= 0.95,
                    &p_b_receive_rnd = 0.5 + - &rnd * 0.5,
                    &p_l_receive_rnd = 0.5 + - &rnd * 0.5,
                    &p_b_drop_rnd = &rnd * 0.5,
                    &p_l_drop_rnd = &rnd * 0.5
                };
                [] turn = 2 & time < maxTime & !parameters_selection & rnd_selected & zombies = 30 & vs_step = 0 -U-> &p_b_receive_rnd : (packet_status'=1) & (vs_step'=1)
                                                                        + &p_b_drop_rnd    : (packet_status'=2) & (vs_step'=1)
                                                                        + &p_l_receive_rnd : (packet_status'=3) & (vs_step'=1)
                                                                        + &p_l_drop_rnd    : (packet_status'=4) & (vs_step'=1)
                { // congested: rnd*(R_b+R_l) < (R_b+R_l-BW)
                    4235.0 >= &rnd * 4693.0,
                    0.85 <= &rnd,
                    &rnd <= 0.95,
                    &p_b_receive_rnd = 0.04879607926699339 + &rnd * 0,
                    &p_l_receive_rnd = 0.04879607926699339 + &rnd * 0,
                    &p_b_drop_rnd = 0.4512039207330066 + &rnd * 0,
                    &p_l_drop_rnd = 0.4512039207330066 + &rnd * 0
