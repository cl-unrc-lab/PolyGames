        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 50 & dfr_index = 1 & vs_step = 1 -> (pool' = pool - 4) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 50 & dfr_index = 2 & vs_step = 1 -> (pool' = pool - 4) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 60 & dfr_index = 0 & vs_step = 1 -> (pool' = pool - 5) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 60 & dfr_index = 1 & vs_step = 1 -> (pool' = pool - 5) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 60 & dfr_index = 2 & vs_step = 1 -> (pool' = pool - 5) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 70 & dfr_index = 0 & vs_step = 1 -> (pool' = pool - 5) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 70 & dfr_index = 1 & vs_step = 1 -> (pool' = pool - 6) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 70 & dfr_index = 2 & vs_step = 1 -> (pool' = pool - 6) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 80 & dfr_index = 0 & vs_step = 1 -> (pool' = pool - 6) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 80 & dfr_index = 1 & vs_step = 1 -> (pool' = pool - 7) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 80 & dfr_index = 2 & vs_step = 1 -> (pool' = pool - 7) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 90 & dfr_index = 0 & vs_step = 1 -> (pool' = pool - 7) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 90 & dfr_index = 1 & vs_step = 1 -> (pool' = pool - 8) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 90 & dfr_index = 2 & vs_step = 1 -> (pool' = pool - 8) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 100 & dfr_index = 0 & vs_step = 1 -> (pool' = pool - 8) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 100 & dfr_index = 1 & vs_step = 1 -> (pool' = pool - 9) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        [] turn = 2 & time < maxTime & !parameters_selection & agf_selected & zombies = 100 & dfr_index = 2 & vs_step = 1 -> (pool' = pool - 9) & (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);

        // ── No depletion: no_fix, RND, AGR, RDR ────────────────────────────
        [] turn = 2 & time < maxTime & !parameters_selection & !ftr_selected & !agf_selected & vs_step = 1 -> (vs_step' = 0) & (packet_status' = 0) & (time' = time + 1) & (turn' = 0);
        endmodule

                formula AF = 15.31;
                formula bogus_rate = 10 * AF;

                formula R_b = bogus_rate * zombies;
                formula R_l = 100.0;
                formula BW  = 458.0;

                formula R_b_in = {
                    [] no_fix_selected | agr_selected : R_b,
                    [] ftr_selected | agf_selected    : R_b * (1 - dfr),
                    [] otherwise                      : R_b
                };

                formula retries_multiplier = (retries=2 ? 4 : retries=4 ? 16 : 64);

                formula R_l_in = {
                    [] no_fix_selected : R_l,
                    [] ftr_selected    : R_l * (1 - fpf),
                    [] rnd_selected    : R_l,
                    [] agr_selected    : R_l * retries_multiplier,
                    [] rdr_selected    : R_l * retries_multiplier,
                    [] otherwise       : R_l * retries_multiplier * (1 - fpf)
                };

                formula R_b_out = {
                    [] no_fix_selected | agr_selected : 0,
                    [] ftr_selected | agf_selected    : R_b * dfr,
                    [] otherwise                      : R_b
                };

                formula R_l_out = {
                    [] no_fix_selected | agr_selected : 0,
                    [] ftr_selected                   : R_l * fpf,
                    [] rnd_selected                   : R_l,
                    [] rdr_selected                   : R_l * retries_multiplier * rdf,
                    [] otherwise                      : R_l * retries_multiplier * fpf
                };

                formula no_fix_selected = (countermeasure = 0);
                formula ftr_selected    = (countermeasure = 1);
                formula rnd_selected    = (countermeasure = 2);
                formula agr_selected    = (countermeasure = 3);
                formula rdr_selected    = (countermeasure = 4);
                formula agf_selected    = (countermeasure = 5);

                formula p_b_in  = (zombies > 0) ? R_b_in / (R_b_in + R_b_out) : 0;
                formula p_l_in  = R_l_in / (R_l_in + R_l_out);
                formula p_b_out = (zombies > 0) ? R_b_out / (R_b_in + R_b_out) : 1;
                formula p_l_out = R_l_out / (R_l_in + R_l_out);
                formula R_in    = R_b_in + R_l_in;
                formula p_drop  = (BW >= R_in ? 0 : ((R_in - BW) / R_in));
                formula p_receive = (1 - p_drop);
                formula p_b_receive = (p_b_in * p_receive)/2;
                formula p_l_receive = (p_l_in * p_receive)/2;
                formula p_b_drop    = (p_b_in * p_drop + p_b_out)/2;
                formula p_l_drop    = (p_l_in * p_drop + p_l_out)/2;

                formula dfr = (dfr_index=0) ? 0.85 : (dfr_index=1) ? 0.90 : 0.95;
                formula fpf = (fpf_index=0) ? 0.05 : (fpf_index=1) ? 0.10 : 0.15;
                formula rdf = (rdf_index=0) ? 0.75 : (rdf_index=1) ? 0.85 : 0.95;

                rewards "AttackerPayoff_1"
                turn = 2 & legit_packet_received : 0;
                turn = 2 & (bogus_packet_dropped | legit_packet_dropped) : 1;
                turn = 2 & bogus_packet_received : 2;
                turn = 0 | turn = 1 : 0;
                endrewards

                formula bogus_packet_received = packet_status = 1;
                formula bogus_packet_dropped  = packet_status = 2;
                formula legit_packet_received = packet_status = 3;
                formula legit_packet_dropped  = packet_status = 4;
