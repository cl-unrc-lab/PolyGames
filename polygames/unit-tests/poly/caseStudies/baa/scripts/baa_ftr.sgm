                    &rnd <= 0.95,
                    &p_b_receive_rnd = 0.07242251739405439 + &rnd * 0,
                    &p_l_receive_rnd = 0.07242251739405439 + &rnd * 0,
                    &p_b_drop_rnd = 0.4275774826059456 + &rnd * 0,
                    &p_l_drop_rnd = 0.4275774826059456 + &rnd * 0
