# ── Git ────────────────────────────────────────────────────────────────────
.git/
**/.gitignore
**/.gitmodules
**/.DS_Store

# ── Not needed for the build ───────────────────────────────────────────────

# Separate upstream copy of PRISM-games — polygames already is the modified version
prism-games/

# ppl/ is fully included — configure needs every Makefile.in and ppl_java_common.cc

# polygames generated docs and release artifacts
polygames/manual/
polygames/javadoc/
polygames/release/

# ── Host-compiled artifacts (platform-specific, would contaminate the Linux build) ──

# Mac/host launch scripts — regenerated by make inside Docker
polygames/bin/

# Compiled object files and Java classes from the host
polygames/obj/
polygames/classes/

# Mac native libraries (.jnilib / .dylib) — Linux uses .so
polygames/lib/*.jnilib
polygames/lib/*.dylib
